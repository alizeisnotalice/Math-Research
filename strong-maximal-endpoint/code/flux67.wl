(* Explicit inputs.json, output directory, optional worker count. *)
args=Rest[$ScriptCommandLine];If[Length[args]<2,Print["Need inputs.json and output directory"];Exit[2]];
in67=Import[args[[1]],"RawJSON"];out67=args[[2]];If[!DirectoryQ[out67],CreateDirectory[out67,CreateIntermediateDirectories->True]];
workers67=If[Length[args]>=3,ToExpression[args[[3]]],12];
ClearAll[post67,beta67,one67,moment67,flux67];
post67[n_,s_,c_,wp_]:=Module[{K,G,logs,W,ids,Z},K=Range[0,Min[n,Ceiling[s/c]-1]];G=s-c K;logs=LogGamma[N[n+1,wp]]-LogGamma[N[K+1,wp]]-LogGamma[N[n-K+1,wp]]+(n-1)Log[G];Z=Max[logs]+Log[Total[Exp[logs-Max[logs]]]];W=Exp[logs-Z];ids=Flatten[Position[W,x_/;x>10^(-wp+20)]];<|"n"->n,"s"->s,"c"->c,"K"->K[[ids]],"G"->G[[ids]],"W"->W[[ids]],"omitted"->1-Total[W[[ids]]]|>];
beta67[x_,n_,om_,K_,wp_]:=If[x>6(n-1)/5,Module[{term=I(n-1)/x,S,D,j=1,ep},S=term;D=term;While[Abs[term]>10^(-wp-20)&&j<n-1,term=term(n-1-j)/(I x);S+=term;D+=(j+1)term;j++];If[j==n-1,ep=-Exp[I x]term;S+=ep;D+=(n-1-I x)ep];{S,om K D/x,-om D/x}],{Hypergeometric1F1[N[1,wp],N[n,wp],I x],-I om K/n Hypergeometric1F1[N[2,wp],N[n+1,wp],I x],I om/n Hypergeometric1F1[N[2,wp],N[n+1,wp],I x]}];
one67[P_,T_,U_,eps_,wp_]:=Module[{n=P["n"],s=P["s"],c=P["c"],K=P["K"],G=P["G"],W=P["W"],om,A,Ap,pairs,B,Bp,d,dm,phase,BS,ds,ms,radial},om=T-U;A=1-K/n+eps K/n Exp[I om c];Ap=eps I om K/n Exp[I om c];pairs=MapThread[beta67[#1,n,om,#2,wp]&,{om G,K}];B=pairs[[All,1]];Bp=pairs[[All,2]];BS=pairs[[All,3]];d=-(n-1)K/G;dm=W.d;phase=Exp[I U s];ds=(n-1)/G;ms=W.ds;radial=I U phase W.(A B)+phase W.((ds-ms)A B+A BS);{phase W.(A B),phase W.((d-dm)A B+Ap B+A Bp),radial}];
moment67[P_,m_]:=Module[{n=P["n"],K=P["K"],W=P["W"],A,d,dm,ds,ms},If[m==0,Return[{1,0,0}]];A=Sum[Binomial[m,j](-2)^j Product[(K-l)/(n-l),{l,0,j-1}],{j,0,m}];d=-(n-1)K/P["G"];dm=W.d;ds=(n-1)/P["G"];ms=W.ds;{W.A,W.((d-dm)A),W.((ds-ms)A)}];
flux67[sp_,setup_:Automatic]:=Module[{b=sp[[1]],mode=sp[[2]],shift=sp[[3]],wp=sp[[4]],mu,c,z,s,P,Q,m,T,U,main,face,faceavg,A,flux,start,R,face0,alpha,fluxS,gamma},start=AbsoluteTime[];If[setup===Automatic,mu=cc/.FindRoot[cc==1+Exp[-cc],{cc,N[5/4,wp]},WorkingPrecision->wp];c=mu+shift Sqrt[Log[N[b,wp]]/b];z=zz/.FindRoot[Erfc[zz/Sqrt[2]]/2==Sqrt[mu/b]zz,{zz,N[Sqrt[Log[b]],wp]},WorkingPrecision->wp];s=b mu-Sqrt[mu b]z;,c=N[setup[[1]],wp];gamma=N[setup[[2]],wp];s=b(1/gamma+c/(1+Exp[gamma c]));];P=post67[b,s,c,wp];Q=post67[b-1,s-c,c,wp];R=post67[b-1,s,c,wp];A=(b-1)P["W"].(P["K"]/P["G"]);
If[mode==8,T=Sqrt[N[b,wp]];U=-T/(b-1);main=one67[P,T,U,-1,wp];face=First[one67[Q,T,U,-1,wp]];faceavg=(-Exp[I T c+I U(s-c)]+(b-1)Exp[I U c]face)/b;face0=(Exp[I U s]+(b-1)First[one67[R,T,U,-1,wp]])/b,
m=Switch[mode,1,1,2,2,3,8];main=moment67[P,m];faceavg=(-m First[moment67[Q,m-1]]+(b-m)First[moment67[Q,m]])/b;face0=(m First[moment67[R,m-1]]+(b-m)First[moment67[R,m]])/b];flux=A(First[main]-faceavg);alpha=(b-1)P["W"].(1/P["G"])-A/b;fluxS=alpha(face0-First[main])+A/b(faceavg-First[main]);If[!And@@(NumberQ/@{main[[1]],main[[2]],main[[3]],flux,fluxS}),Return[<|"numeric"->False,"spec"->ToString[sp,InputForm]|>]];
<|"normal_root_residual"->If[setup===Automatic,ToString[N[Abs[Erfc[z/Sqrt[2]]/2-Sqrt[mu/b]z],20],InputForm],Null],"setup_kind"->If[setup===Automatic,"critical_root","explicit_mean_tilt"],"critical_shift_applicable"->(setup===Automatic),"c_value"->ToString[N[c,25],InputForm],"gamma_value"->If[setup===Automatic,Null,ToString[N[gamma,25],InputForm]],"root_tolerance"->ToString[10^(-Floor[wp/2]+10),InputForm],"root_checks_pass"->If[setup===Automatic,TrueQ[Abs[Erfc[z/Sqrt[2]]/2-Sqrt[mu/b]z]<10^(-Floor[wp/2]+10)],TrueQ[c>0&&gamma>0]],"numeric"->True,"b"->ToString[b],"mode"->mode,"shift_over_rho"->shift,"precision"->wp,"CF"->ToString[N[First[main],35],InputForm],"derivative"->ToString[N[main[[2]],35],InputForm],"derivative_abs"->ToString[N[Abs[main[[2]]],35],InputForm],"flux_derivative"->ToString[N[flux,35],InputForm],"flux_absolute_residual"->ToString[N[Abs[flux-main[[2]]],30],InputForm],"omitted_posterior_mass"->ToString[N[Max[Abs[P["omitted"]],Abs[Q["omitted"]],Abs[R["omitted"]]],20],InputForm],"radial_derivative"->ToString[N[main[[3]],35],InputForm],"b_scaled_radial_abs"->ToString[N[b Abs[main[[3]]],35],InputForm],"radial_flux_residual"->ToString[N[Abs[fluxS-main[[3]]],30],InputForm],"flux_A"->ToString[N[A,30],InputForm],"seconds"->N[AbsoluteTime[]-start]|>];
jobs=Join[Join[#,<|"regime"->"critical"|>]&/@in67["mixture"],Join[#,<|"regime"->"macro"|>]&/@Lookup[in67,"macro",{}]];
LaunchKernels[workers67];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[post67,beta67,one67,moment67,flux67];start=AbsoluteTime[];
rows=ParallelMap[Function[j,Module[{row,id,b=ToExpression[j["b"]]},If[j["regime"]==="critical",row=flux67[{b,j["mode"],j["shift"],j["precision"]}];id="C|"<>j["b"]<>"|"<>ToString[j["mode"]]<>"|"<>ToString[j["shift"]],row=flux67[{b,j["mode"],0,80(1+j["refined"])},{ToExpression[j["c"]],ToExpression[j["gamma"]]}];id="M|"<>j["b"]<>"|"<>ToString[j["mode"]]<>"|"<>j["c"]<>"|"<>j["gamma"]];Join[row,<|"case_id"->id|>]]],jobs,Method->"FinestGrained"];
If[AnyTrue[rows,!TrueQ[Lookup[#,"numeric",False]]||!TrueQ[Lookup[#,"root_checks_pass",False]]&],Print["Numeric/setup check failed"];CloseKernels[];Exit[3]];
Export[FileNameJoin[{out67,"flux67.json"}],<|"version"->$Version,"workers"->$KernelCount,"seconds"->N[AbsoluteTime[]-start],"rows"->rows,"scope"->"Independent finite conditional mixture and signed-face flux with posterior cutoff; high precision, no directed rounding"|>,"RawJSON"];CloseKernels[];Print["Completed flux67.wl"];
