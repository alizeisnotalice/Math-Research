(* Exact-law Phi_2 capped convex budget for Exp(rate theta). *)
case50[theta0_,wp_:80]:=Module[{th=N[theta0,wp+120],cap=2,beta,k,aCap,ints,Cc,l1,l2,bp,bpp,P0,lam,a0,t1,tCap,dens,t,h,phi,eh,Jdir,M1,T2,W,ss,B00,B01,B11,full,omitT,omitSoft,b00L,b01L,b11L,fun,tail,start=AbsoluteTime[]},
 k=1-th;beta=th/k;aCap=2+Log[cap];ints=Table[NIntegrate[Exp[a-2]a^(-beta)Log[a]^j,{a,2,aCap},WorkingPrecision->wp+60,AccuracyGoal->wp+20,PrecisionGoal->wp+20,Method->{"GlobalAdaptive","SymbolicProcessing"->0}],{j,0,2}];Cc=1+ints[[1]];a0=Exp[-Log[Cc]/beta];P0=a0;lam=a0/th;t1=-Log[a0]/k;tCap=Log[aCap/a0]/k;
 l1=Log[Cc]/beta^2+ints[[2]]/(beta Cc);l2=-2Log[Cc]/beta^3-2ints[[2]]/(beta^2 Cc)-ints[[3]]/(beta Cc)+ints[[2]]^2/(beta Cc^2);bp=1/k^2;bpp=2/k^3;
 t[a_]:=Log[a/a0]/k;dens[a_]:=beta a0^beta a^(-beta-1);ss[a_]:=1/th-t[a];
 fun[g_]:=NIntegrate[g[a]dens[a],{a,1,2},WorkingPrecision->wp,AccuracyGoal->Floor[wp/2],PrecisionGoal->Floor[wp/2],Method->{"GlobalAdaptive","SymbolicProcessing"->0}]+NIntegrate[Exp[a-2]g[a]dens[a],{a,2,aCap},WorkingPrecision->wp,AccuracyGoal->Floor[wp/2],PrecisionGoal->Floor[wp/2],Method->{"GlobalAdaptive","SymbolicProcessing"->0}];
 eh=fun[Function[a,1]]+cap Exp[-th tCap];M1=fun[Function[a,ss[a]]]-cap tCap Exp[-th tCap];T2=fun[Function[a,t[a]^2-2t[a]/th]]+cap tCap^2 Exp[-th tCap];
 Jdir=(a0^(beta+1)/k)(NIntegrate[a^(-beta-2),{a,1,2},WorkingPrecision->wp,AccuracyGoal->Floor[wp/2],PrecisionGoal->Floor[wp/2]]+NIntegrate[Exp[a-2](a-1)a^(-beta-2),{a,2,aCap},WorkingPrecision->wp,AccuracyGoal->Floor[wp/2],PrecisionGoal->Floor[wp/2]])+cap(1+Log[cap])Exp[-tCap];
 W=beta a0^beta;b00L=W;b01L=W ss[1];b11L=W ss[1]^2;
 {B00,B01,B11}={b00L,b01L,b11L}+Table[NIntegrate[a Exp[a-2]ss[a]^j dens[a],{a,2,aCap},WorkingPrecision->wp,AccuracyGoal->Floor[wp/2],PrecisionGoal->Floor[wp/2],Method->{"GlobalAdaptive","SymbolicProcessing"->0}],{j,0,2}];
 full=lam(-T2-B11+(M1+B01)^2/B00);omitT=lam(-B11+(M1+B01)^2/B00);omitSoft=lam(-T2-b11L+(M1+b01L)^2/b00L);
 <|"theta"->ToString[theta0,InputForm],"working_precision"->wp,"initial_integral_guard_precision"->wp+60,"a0"->N[a0,30],"lambda"->N[lam,30],"lower_threshold_t1"->N[t1,30],"budget_exact_formula"->N[P0,30],"mean_constraint_residual"->ToString[eh-1,InputForm],"direct_budget_residual"->ToString[Jdir-P0,InputForm],"budget_second_derivative_analytic"->N[P0((l1^2+l2)bp^2+l1 bpp),30],"budget_second_derivative_full_Hessian"->N[full,30],"Hessian_formula_residual"->ToString[full-P0((l1^2+l2)bp^2+l1 bpp),InputForm],"kernel_second_derivative_T"->N[T2,30],"B00"->N[B00,30],"B01"->N[B01,30],"B11"->N[B11,30],"lower_boundary_B11"->N[b11L,30],"soft_B11"->N[B11-b11L,30],"mean_score_M1"->N[M1,30],"omit_kernel_T_prediction"->N[omitT,30],"omit_soft_prediction"->N[omitSoft,30],"kernel_omission_reverses_sign"->TrueQ[full omitT<0],"all_constraints_residual_lt_1e-30"->TrueQ[Max[Abs[{eh-1,Jdir-P0,full-P0((l1^2+l2)bp^2+l1 bpp)}]]<10^-30],"seconds"->N[AbsoluteTime[]-start]|>];
If[!TrueQ[$hessian50LibraryMode],out50=If[Length[$ScriptCommandLine]>=2,$ScriptCommandLine[[2]],"/tmp/hessian50.json"];rows50=case50/@{1/10,1/5,1/3,1/2,2/3,4/5,9/10};Export[out50,<|"wolfram"->$Version,"model"->"Phi2, cap2, target1, Exp(rate theta) vs fixed e^-t dt; diagnostic convex model, not strong-maximal C2","rows"->rows50|>,"RawJSON"];Print[KeyTake[#,{"theta","budget_second_derivative_analytic","omit_kernel_T_prediction","kernel_omission_reverses_sign","all_constraints_residual_lt_1e-30"}]&/@rows50]];
