(* r056: common-c curvature replay using the r052 primal KKT kernel. *)
root=DirectoryName[$InputFileName];args=$ScriptCommandLine;out=If[Length[args]>=2,args[[2]],FileNameJoin[{root,"common_numeric56.json"}]];env56=Quiet@Check[Environment["STRONG_MAXIMAL_REPO"],$Failed];repo=If[StringQ[env56]&&env56!="",env56,DirectoryName[root]];If[!FileExistsQ[FileNameJoin[{repo,"code","primal52.wl"}]],Print["Set STRONG_MAXIMAL_REPO to project root"];Exit[2]];
Block[{$ScriptCommandLine={},$primal52LibraryMode=True},Get[FileNameJoin[{repo,"code","primal52.wl"}]]];mu56=N[1+ProductLog[1/E],30];seed=Import[FileNameJoin[{repo,"rounds","r052","primal52.json"}],"RawJSON"];seedRow[nn_]:=SelectFirst[seed["rows"],#["n"]==nn&];
summary[r_]:=Module[{cc=r["c1"],nn=r["n"],pp,pmu,m2},pp=1/(1+Exp[cc]);pmu=1/(1+Exp[mu56]);m2=-2pp(1-pp)+cc pp(1-pp)(1-2pp);<|"n"->nn,"c"->cc,"mean_residual"->r["mean_residual"],"calibration_pass"->r["mean_calibration_pass"],"common_gradient"->r["common_log_budget_gradient"],"common_hessian"->r["common_log_budget_Hessian"],"n_p_of_c"->nn pp,"n_p_mu"->nn pmu,"n_minus_m_second_of_c"->nn(-m2),"Tplus"->r["raw_integrals","Tplus"],"B00"->r["raw_integrals","B00"],"Bplus"->r["raw_integrals","Bplus"],"B0plus"->r["raw_integrals","B0plus"],"Mplus"->r["raw_integrals","Mplus"],"response_schur_raw"->(r["raw_integrals","Bplus"]-(r["raw_integrals","Mplus"]+r["raw_integrals","B0plus"])^2/r["raw_integrals","B00"]),"common_hessian_over_n_p_of_c"->r["common_log_budget_Hessian"]/(nn pp)|>];
rows=Table[s=seedRow[nn];cc=s["tuned_c"];hi=s["fixed_window"][[2]];r=solve52[nn,cc,cc,256,32,hi];<|"seed_stationary_c"->cc,"fixed_hi"->hi,"kernel_row"->summary[r]|>,{nn,{64,128,256}}];
fd=Table[s=seedRow[nn];cc=s["tuned_c"];hi=s["fixed_window"][[2]];r0=solve52[nn,cc,cc,256,32,hi];Table[rm=solve52[nn,cc-dd,cc-dd,256,32,hi];rp=solve52[nn,cc+dd,cc+dd,256,32,hi];<|"step"->dd,"second_difference_log_budget"->(rp["log_budget_dual_corrected"]-2r0["log_budget_dual_corrected"]+rm["log_budget_dual_corrected"])/dd^2,"center_hessian"->r0["common_log_budget_Hessian"],"endpoint_residuals"->{rm["mean_residual"],rp["mean_residual"]}|>,{dd,{.01,.005}}],{nn,{64,128}}];
res=<|"status"->"r056 common-c KKT curvature replay; floating finite-square diagnostic, not certificate","wolfram"->$Version,"source"->"code/primal52.wl library mode; r052/primal52.json stationary seeds","rows_N64_N128_N256"->rows,"independent_common_c_finite_differences_N64_N128"->AssociationThread[{"N64","N128"},fd],"scope"->"common_hessian and Tplus use the primal52 analytic KKT jet. n_p_of_c, n_p_mu, and n_minus_m_second_of_c are distinct explicitly labelled comparison scales. Finite differences re-solve lambda at fixed square. This remains machine arithmetic, including any discarded underflow-scale terms in the inherited kernel."|>;ex=Check[Export[out,res,"RawJSON"],$Failed];If[ex===$Failed,Print["Export failed"];Exit[3]];If[!AssociationQ@Check[Import[out,"RawJSON"],$Failed],Print["JSON parse failed"];Exit[4]];Print[res];
