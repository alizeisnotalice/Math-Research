args76=Rest[$ScriptCommandLine];out76=args76[[1]];If[!DirectoryQ[out76],CreateDirectory[out76,CreateIntermediateDirectories->True]];ClearAll[opt76];
opt76[j_]:=Module[{n=j["N"],kind=j["kind"],wp=j["precision"],mu,zeta,alpha,beta,L,qmin,crit,tau,q,p,bd,branch,z,d,target,min0,front,fb,qt,expa},mu=x/.FindRoot[x==1+Exp[-x],{x,N[5/4,wp+30]},WorkingPrecision->wp+30];zeta=N[Log[1+Log[2]]/Log[2],wp+30];alpha=(9-mu)/24;beta=mu-1-Log[mu];L=N[Log[n],wp+30];qmin=1/(zeta(n-1));crit=n(qmin-Log[1+qmin]);tau=Switch[kind,"zero",0,"half_transition",crit/2,"transition",crit,"double_transition",2crit,"inverseN2",n^-2,"one",1,"logN",L,"sqrtNL",Sqrt[n L],"linear01",n/100,"leading_frontier",n beta];
 If[tau<=crit,q=qmin;branch="cap";p=1+1/q;bd=n p Log[p/(p-1)]+p tau,q=x/.FindRoot[x-Log[1+x]==tau/n,{x,N[Max[qmin,Sqrt[2tau/n]+2tau/n],wp+20]},WorkingPrecision->wp+20];p=1+1/q;branch="interior";bd=n(1+q)];z=x/.FindRoot[Erfc[x/Sqrt[2]]/2==Sqrt[mu/n]x,{x,N[Sqrt[L],wp+20]},WorkingPrecision->wp+20];d=Sqrt[mu n]z;target=n mu-d+alpha L;min0=n(1+1/qmin)Log[1+qmin];front=Null;fb=Null;If[target>=min0,qt=target/n-1;If[qt>=qmin,front=n(qt-Log[1+qt]);fb="interior",front=(target-min0)/(1+1/qmin);fb="cap"]];expa=n beta-(mu-1)/mu d+((mu-1)/mu alpha+1/(2mu))L;<|"N"->n,"kind"->kind,"precision"->wp,"branch"->branch,"tau"->ToString[N[tau,35],InputForm],"q"->ToString[N[q,35],InputForm],"log_bound"->ToString[N[bd,35],InputForm],"reference_tau_frontier"->If[front===Null,Null,ToString[N[front,35],InputForm]],"frontier_expansion_error_over_logN"->If[front===Null,Null,ToString[N[(front-expa)/L,30],InputForm]],"numeric"->TrueQ[q>=qmin-10^(-Floor[wp/2])&&p>1&&If[branch==="interior",Abs[q-Log[1+q]-tau/n]<10^(-Floor[wp/2]),True]]|>];
expr76=nn pp Log[pp/(pp-1)]+pp tt;cv76=TrueQ[FullSimplify[D[expr76,{pp,2}]==nn/(pp(pp-1)^2),Assumptions->pp>1&&nn>0]];val76=TrueQ[FullSimplify[(expr76/.{pp->1+1/qq,tt->nn(qq-Log[1+qq])})==nn(1+qq),Assumptions->qq>0&&nn>0]];ser76=Normal[Series[(rr+aa rr^2+bb rr^3)-Log[1+rr+aa rr^2+bb rr^3]-rr^2/2,{rr,0,4}]];co76=Solve[{Coefficient[ser76,rr,3]==0,Coefficient[ser76,rr,4]==0},{aa,bb}];
