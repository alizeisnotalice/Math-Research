args78=Rest[$ScriptCommandLine];in78=args78[[1]];out78=args78[[2]];If[!DirectoryQ[out78],CreateDirectory[out78,CreateIntermediateDirectories->True]];
ClearAll[rat78,log78,phi78,env78,rows78,col78,dp78,master78,case78,tri78];
rat78[s_String]:=If[StringMatchQ[s,RegularExpression["-?[0-9]+(/[0-9]+)?"]],ToExpression[s,InputForm],Throw["bad rational"]];
log78[t_]:=Module[{u=(t-1)/(t+1),lo,hi},lo=Sum[2u^(2k+1)/(2k+1),{k,0,19}];hi=lo+2u^41/(41(1-u^2));{Floor[10^12 lo]/10^12,Ceiling[10^12 hi]/10^12}];
phi78[t_]:=If[t<=1,{t,t},t(1+log78[t])];
env78[mesh_]:=env78[mesh]=Module[{nodes=Table[1+k/mesh,{k,0,mesh}],logs,low,up,a,b,va,vb,s},logs=log78/@nodes;low=Prepend[MapThread[{2+#2[[1]],-#1}&,{nodes,logs}],{1,0}];up={{1,0}};Do[a=nodes[[k]];b=nodes[[k+1]];va=a(1+logs[[k,2]]);vb=b(1+logs[[k+1,2]]);s=(vb-va)/(b-a);AppendTo[up,{s,va-s a}],{k,1,mesh}];{low,up}];
rows78[anchor_,cell_]:=Module[{ans={},area,lx,rx,ly,ry,ox,oy},Do[area=Abs[(x-anchor[[1]])(y-anchor[[2]])];If[area!=0,{lx,rx}=Sort[{x,anchor[[1]]}];{ly,ry}=Sort[{y,anchor[[2]]}];ox=Table[Max[0,Min[rx,k+1]-Max[lx,k]],{k,0,7}];oy=Table[Max[0,Min[ry,k+1]-Max[ly,k]],{k,0,7}];AppendTo[ans,{Flatten[Outer[Times,ox,oy]],area}]],{x,cell[[1;;2]]},{y,cell[[3;;4]]}];ans];
col78[item_]:=Catch[Module[{id=item[[1]],c=item[[2]],z=item[[3]],f,g,r,env,low,up,lam,theta,d,lb,ub,a,mask,ids},f=rat78/@c["source"];g=rat78/@z["primal"];a=c["anchors"][[z["anchor_index"]+1]];mask=z["mask"];ids=Select[Range[Length[c["receiver_cells"]]],BitGet[mask,#-1]==1&];r=DeleteDuplicates[Flatten[rows78[a,c["receiver_cells"][[#]]]&/@ids,1]];env=env78[c["mesh"]];{low,up}=env;lam=ConstantArray[0,Length[r]];theta=ConstantArray[0,{64,Length[low]}];
Do[lam[[v[[1]]+1]]=rat78[v[[2]]],{v,z["success_dual"]}];Do[theta[[v[[1]]+1,v[[2]]+1]]=rat78[v[[3]]],{v,z["epigraph_dual"]}];
If[Length[g]!=64||!And@@Thread[0<=g]||!And@@Thread[g<=f]||Min[r[[All,1]].g-rat78[c["sigma"]]r[[All,2]]]<0,Throw["source primal"]];
If[Min[lam]<0||Min[Flatten[theta]]<0||!And@@Thread[(Total/@theta)<=1/4],Throw["source dual"]];
d=theta.low[[All,1]]-Transpose[r[[All,1]]].lam;lb=rat78[c["sigma"]](lam.r[[All,2]])+Total[Flatten[theta ConstantArray[low[[All,2]],64]]]+Total[MapThread[Min[0,#1 #2]&,{f,d}]];ub=Total[(Max[up[[All,1]] #+up[[All,2]]]&)/@g]/4;
If[lb!=rat78[z["lower"]]||ub!=rat78[z["upper"]]||lb>ub,Throw["source objective"]];
<|"case"->id,"anchor_index"->z["anchor_index"],"mask"->mask,"exact_pass"->True|>]];
dp78[cols_,m_,which_]:=Module[{d=ConstantArray[Infinity,2^m],nxt,cost},d[[1]]=0;Do[If[d[[mask+1]]===Infinity,Continue[]];Do[nxt=BitOr[mask,z["mask"]];If[nxt>mask,cost=d[[mask+1]]+rat78[z[which]];If[cost<d[[nxt+1]],d[[nxt+1]]=cost]],{z,cols}],{mask,0,2^m-1}];d];
master78[c_]:=Module[{cols=c["columns"],m=Length[c["receiver_cells"]],d=c["cover"],y,w,B,lb,ub,dl,du,sol,obj,msgs,expected},y=rat78/@d["dual"];w=ConstantArray[0,Length[cols]];Do[w[[v[[1]]+1]]=rat78[v[[2]]],{v,d["weights"]}];B=Table[BitGet[z["mask"],i-1],{i,m},{z,cols}];
If[Min[y]<0||Min[w]<0||Min[B.w]<1||!And@@Thread[Transpose[B].y<=(rat78[#["lower"]]&)/@cols],Throw["cover feasibility"]];
lb=Total[y];ub=w.((rat78[#["upper"]]&)/@cols);If[lb!=rat78[d["fractional_lower"]]||ub!=rat78[d["fractional_upper"]],Throw["cover objective"]];
dl=dp78[cols,m,"lower"];du=dp78[cols,m,"upper"];expected[t_]:=If[t===Null,Infinity,rat78[t]];
If[dl!=(expected/@d["DP_lower"])||du!=(expected/@d["DP_upper"])||Last[dl]!=rat78[d["integer_lower"]]||Last[du]!=rat78[d["integer_upper"]],Throw["integer DP"]];
If[Apply[BitOr,(cols[[#+1]]["mask"]&)/@d["integer_columns"]]!=2^m-1,Throw["integer cover"]];
Block[{$MessageList={}},sol=LinearProgramming[(rat78[#["lower"]]&)/@cols,B,ConstantArray[1,m],Method->"Simplex"];msgs=ToString[#,InputForm]&/@$MessageList];
If[!VectorQ[sol,(IntegerQ[#]||Head[#]===Rational)&]||Min[B.sol]<1,Throw["exact master LP"]];obj=sol.((rat78[#["lower"]]&)/@cols);
If[Abs[N[obj]-d["numerical_fractional_lower_model"]]>10^-7||obj<lb,Throw["master mismatch"]];
<|"exact_pass"->True,"integer_over_fractional_lower"->ToString[N[Last[dl]/ub,40],InputForm],"integer_over_fractional_upper"->ToString[N[Last[du]/lb,40],InputForm],"Wolfram_master_objective"->ToString[N[obj,40],InputForm],"Wolfram_master_exact"->True,"messages"->msgs|>];
case78[c_]:=Catch[Module[{f=rat78/@c["source"],sig=rat78[c["sigma"]],eligible,expected,em,keys},If[Length[f]!=64||Min[f]<0||Max[f]>2,Throw["capacity"]];eligible=Table[Select[Range[0,Length[c["receiver_cells"]]-1],Function[i,With[{r=rows78[a,c["receiver_cells"][[i+1]]]},And@@((#[[1]].f>=sig #[[2]])&/@r)]]],{a,c["anchors"]}];If[eligible!=c["eligible"],Throw["eligibility gap"]];
expected=Flatten[Table[em=Total[2^eligible[[a]]];Select[Table[{a-1,mask},{mask,1,2^Length[c["receiver_cells"]]-1}],BitAnd[#[[2]],em]==#[[2]]&],{a,Length[c["anchors"]]}],1];keys={#["anchor_index"],#["mask"]}&/@c["columns"];If[keys!=expected,Throw["incomplete columns"]];Join[<|"name"->c["name"],"columns"->Length[keys]|>,master78[c]]]];
tri78[c_]:=Catch[Module[{v=16/25,sig=rat78[c["sigma"]],rad=rat78[c["receiver_radius"]],pts,hs,vols,mins,elig,mass,g,pi},pts=Map[rat78,c["receiver_cells"],{2}];hs=Map[rat78,c["anchor_sides"],{2}];vols=Table[(h[[1]]+p[[1]]+rad)(h[[2]]+p[[2]]+rad),{h,hs},{p,pts}];mins=Table[(h[[1]]+p[[1]]-rad)(h[[2]]+p[[2]]-rad),{h,hs},{p,pts}];If[vols!=Map[rat78,c["maximum_volumes"],{2}]||mins!=Map[rat78,c["minimum_volumes"],{2}],Throw["triangle volumes"]];
elig=Table[Select[Range[0,2],Function[i,sig row[[i+1]]<=1]],{row,vols}];If[elig!=c["eligible"]||elig[[1;;3]]!={{1,2},{0,2},{0,1}}||!And@@Table[mins[[i,i]]>1,{i,3}],Throw["triangle incidence"]];
Do[mass=sig Max[Pick[vols[[z["anchor_index"]+1]],Table[BitGet[z["mask"],i-1],{i,3}],1]];g=mass/v;pi=v phi78[g];If[mass!=rat78[z["mass"]]||g!=rat78[z["density"]]||pi!={rat78[z["lower"]],rat78[z["upper"]]}||g>25/16,Throw["triangle cost"]],{z,c["columns"]}];
Join[<|"name"->c["name"],"columns"->Length[c["columns"]]|>,master78[c]]]];
doc78=Import[FileNameJoin[{in78,"columns78.json"}],"RawJSON"];tris78=Import[FileNameJoin[{in78,"triangle78.json"}],"RawJSON"];jobs78=Flatten[Table[{i-1,KeyDrop[doc78["cases"][[i]],{"columns","cover"}],z},{i,Length[doc78["cases"]]},{z,doc78["cases"][[i]]["columns"]}],1];
LaunchKernels[12];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[rat78,log78,phi78,env78,rows78,col78,dp78,master78,case78,tri78];tt78=AbsoluteTime[];
cc78=ParallelMap[TimeConstrained[col78[#],60,"TIMEOUT"]&,jobs78,Method->"FinestGrained"];mm78=ParallelMap[TimeConstrained[case78[#],90,"TIMEOUT"]&,doc78["cases"]];tr78=ParallelMap[TimeConstrained[tri78[#],90,"TIMEOUT"]&,tris78["cases"]];CloseKernels[];
pass78=AllTrue[Join[cc78,mm78,tr78],AssociationQ[#]&&TrueQ[#["exact_pass"]]&];
Export[FileNameJoin[{out78,"verification78.json"}],<|"version"->$Version,"workers"->12,"seconds"->N[AbsoluteTime[]-tt78],"pass"->pass78,"source_columns"->cc78,"masters"->mm78,"triangles"->tr78|>,"RawJSON"];
Print[If[pass78,"PASS ","FAIL "],Length[cc78]," columns, ",Length[mm78]+Length[tr78]," exact master LPs and DP checks"];If[!pass78,Print[Cases[Join[cc78,mm78,tr78],_String]];Exit[3]];
