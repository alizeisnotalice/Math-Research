(* r052 portable matched-ratio scan. Floating finite-window diagnostics only. *)
portable52Dir=DirectoryName[$InputFileName];portable52Args=$ScriptCommandLine;
portable52Repos=DeleteCases[{Quiet@Check[Environment["STRONG_MAXIMAL_REPO"],""],DirectoryName[portable52Dir],FileNameJoin[{DirectoryName[portable52Dir],"Math-Research-strong-maximal","strong-maximal-endpoint"}],FileNameJoin[{DirectoryName[DirectoryName[portable52Dir]],"Math-Research-strong-maximal","strong-maximal-endpoint"}]},""];
portable52Repo=SelectFirst[portable52Repos,FileExistsQ[FileNameJoin[{#,"code","inner51.wl"}]]&,Missing["repo"]];
If[MissingQ[portable52Repo],Print["r052 portable: set STRONG_MAXIMAL_REPO to project root"];Exit[2]];
portable52Out=If[Length[portable52Args]>=2,portable52Args[[2]],FileNameJoin[{$TemporaryDirectory,"inner52.json"}]];
Block[{$ScriptCommandLine={},$inner51LibraryMode=True},Get[FileNameJoin[{portable52Repo,"code","inner51.wl"}]]];
seed52=FileNameJoin[{portable52Repo,"rounds","r051","inner51.json"}];If[!FileExistsQ[seed52],Print["r052 portable: missing "<>seed52];Exit[2]];

target52=1.0001;q52=vv/16.;center52=Total[coeff q52^2]/Total[coeff];d52=dd-.08q52^2;
u=Join[{{0.,0.}},Transpose[{Rest[d52]+Rest[vv],Rest[d52]-Rest[vv]}],Transpose[{Rest[d52]-Rest[vv],Rest[d52]+Rest[vv]}]];
shape52=Import[seed52,"RawJSON"]["best_full_group_weights_N256"];
pts52[j_Integer]:=If[j==1,{u[[1]]},{u[[j]],u[[j+ng-1]]}];
cone52[an_]:=Module[{s=SortBy[an,First],xx,best,tot=0.,i},xx=DeleteDuplicates[s[[All,1]]];Do[best=Min[Select[s,#[[1]]<=xx[[i]]&][[All,2]]];tot+=(Exp[-xx[[i]]]-If[i<Length[xx],Exp[-xx[[i+1]]],0.])Exp[-best],{i,Length[xx]}];tot];

eval52[ww_,cv_,no_Integer:32,ord_Integer:8]:=Module[{cm=Max[cv],p,tx,tw,mix,like,bound,pv,cp,sp,aa,roots,z,a,cost=0.,av=ConstantArray[0.,ng],avg,ids,an,vol,dual,mass,d1},
 p=1/(1+Exp[cm]);lo=Min[u];hi=Max[u]+b(1+cm p)+16Sqrt[b(1+cm^2p(1-p))];{tx,tw}=outerQuad[no];
 mix[t1_?NumericQ]:=Module[{ar=ConstantArray[0.,2ng-1],zz},ar[[1]]=ww[[1]]polyC[t1-u[[1,1]],cv[[1]]]Exp[Total[u[[1]]]-tau];Do[zz=u[[j]];ar[[j]]=ww[[j]]polyC[t1-zz[[1]],cv[[j]]]Exp[Total[zz]-tau];zz=u[[j+ng-1]];ar[[j+ng-1]]=ww[[j]]polyC[t1-zz[[1]],cv[[j]]]Exp[Total[zz]-tau],{j,2,ng}];ar];
 like[t2_?NumericQ,ar_]:=Total[ar Table[polyC[t2-u[[k,2]],cv[[If[k<=ng,k,k-ng+1]]]],{k,2ng-1}]];
 bound[lev_,ar_]:=Module[{l=lo,r=hi,m},If[like[l,ar]>=lev,Return[l]];If[like[r,ar]<=lev,Return[r]];Do[m=(l+r)/2.;If[like[m,ar]<lev,l=m,r=m],{42}];(l+r)/2.];
 pv[t1_,t2_]:=Module[{out=ConstantArray[0.,ng],zz},Do[Do[out[[j]]+=polyC[t1-zz[[1]],cv[[j]]]polyC[t2-zz[[2]],cv[[j]]]Exp[Total[zz]-t1-t2],{zz,pts52[j]}],{j,ng}];out];
 cp[t1_,l_,r_,hh_]:=Module[{co=0.,out=ConstantArray[0.,ng],zz,fac},If[r<=l,Return[{co,out}]];co=Exp[tau-t1](Exp[-l]-Exp[-r])phi[hh];Do[Do[fac=polyC[t1-zz[[1]],cv[[j]]]Exp[zz[[1]]-t1];out[[j]]+=fac(gbcdfC[r-zz[[2]],cv[[j]]]-gbcdfC[l-zz[[2]],cv[[j]]]),{zz,pts52[j]}],{j,ng}];{co,out}];
 sp[t1_,l_,r_,ar_]:=Module[{x,wt,hh,co=0.,out=ConstantArray[0.,ng]},If[r<=l,Return[{co,out}]];{x,wt}=quad[ord,l,r];Do[hh=profile[like[x[[i]],ar]];co+=wt[[i]]Exp[tau-t1-x[[i]]]phi[hh];out+=wt[[i]]hh pv[t1,x[[i]]],{i,Length[x]}];{co,out}];
 Do[aa=mix[tx[[i]]];roots=bound[#,aa]&/@{1.,N[n],phiPrime};{z,a}=cp[tx[[i]],roots[[1]],roots[[2]],1.];cost+=tw[[i]]z;av+=tw[[i]]a;{z,a}=cp[tx[[i]],roots[[3]],hi,cap];cost+=tw[[i]]z;av+=tw[[i]]cap a;{z,a}=sp[tx[[i]],roots[[2]],roots[[3]],aa];cost+=tw[[i]]z;av+=tw[[i]]a,{i,Length[tx]}];avg=av/coeff;ids=Flatten@Position[avg,_?(#>=target52&)];an=Flatten[Table[pts52[j],{j,ids}],1];vol=If[Length[an]>0,cone52[an],0.];dual=cost+Total[coeff ww(target52-avg)];mass=Total[coeff ww];d1=dual-.0001mass;<|"weights"->ww,"c_vector"->cv,"finite_window"->{lo,hi},"outer_nodes"->no,"soft_order"->ord,"scaled_cost"->cost,"actual_logJ"->Log[cost]-tau,"averages"->avg,"min_average"->Min[avg],"worst_group"->First@Ordering[avg,1],"all_constraints_pass"->(Min[avg]>=target52),"dual_scaled_target10001"->dual,"target1_dual_scaled"->d1,"mass_coefficient_weight"->mass,"primal_minus_dual_target10001"->cost-dual,"accepted_groups"->Length[ids],"accepted_nodes"->Length[an],"accepted_cone_volume"->vol,"accepted_cone_log_score"->If[vol>0,Log[vol]-(Log[cost]-tau),-Infinity],"target1_dual_score_upper_fixed_geometry"->If[vol>0,Log[vol]-Log[d1]+tau,-Infinity]|>];
brief52[x_]:=KeyDrop[x,{"weights","averages","c_vector","finite_window"}];
cal52[sh_,cv_,no_:32,ord_:8]:=Module[{l=.8,r=1.25,a,b,m,j=0},a=eval52[l sh,cv,no,ord];b=eval52[r sh,cv,no,ord];While[!b["all_constraints_pass"]&&j<4,r*=1.25;b=eval52[r sh,cv,no,ord];j++];If[!b["all_constraints_pass"],Return[<|"status"->"no_feasible_bracket","result"->b|>]];Do[m=(l+r)/2.;a=eval52[m sh,cv,no,ord];If[a["all_constraints_pass"],r=m;b=a,l=m],{6}];<|"status"->"feasible","scale"->r,"min_average_minus_target"->(b["min_average"]-target52),"result"->b|>];

If[!TrueQ[$inner52PortableLibraryMode],
 deltas={-.10,-.05,0.,.05,.10};scans=Table[cv=c+.10+de(q52^2-center52);rr=cal52[shape52,cv];<|"delta"->de,"calibration"->KeyDrop[rr,"result"],"result"->brief52[rr["result"]]|>,{de,deltas}];good=Select[scans,#result["all_constraints_pass"]&];pick=First@MaximalBy[good,#result["accepted_cone_log_score"]&];cvbest=c+.10+pick["delta"](q52^2-center52);
 coarse=cal52[shape52,cvbest,64,16];curshape=shape52;cur=coarse["result"];steps={};Do[g=cur["worst_group"];candshape=If[curshape[[g]]>0,ReplacePart[curshape,g->1.08curshape[[g]]],ReplacePart[curshape,g->Max[curshape]/25]];cand=cal52[candshape,cvbest,64,16];ok=cand["result","all_constraints_pass"]&&cand["result","scaled_cost"]<cur["scaled_cost"]&&cand["result","dual_scaled_target10001"]>=cur["dual_scaled_target10001"];AppendTo[steps,<|"group"->g,"action"->If[curshape[[g]]>0,"multiply_1.08","activate_max_over_25"],"accepted"->ok,"candidate"->brief52[cand["result"]]|>];If[ok,curshape=candshape;cur=cand["result"]],{2}];
 val128=cal52[curshape,cvbest,128,32];val256=If[val128["result","all_constraints_pass"],cal52[curshape,cvbest,256,64],<|"status"->"skipped"|>];bestUniform=FirstCase[scans,x_/;x["delta"]==0.];
 res=<|"wolfram"->$Version,"status"->"matched source/receiver relative-ratio scan; floating finite-window quadrature only, not a certificate","repo"->portable52Repo,"seed"->seed52,"target_per_group"->target52,"tau"->tau,"coefficients"->N[coeff,17],"geometry"->"u1=(0,0), d=d_seed-.08(v/16)^2; mirror-paired c_j","ratio_family"->"c_j=c0+.10+delta*((v_j/16)^2-weighted_mean)","weighted_center"->center52,"uniform_control_r051"-><|"score"->71.34730743654568,"min_average"->1.0002507360174702,"all65"->True|>,"coarse_screen_N32_soft8"->scans,"best_uniform_coarse_target1_dual_bound"->bestUniform,"selected_delta"->pick["delta"],"coordinate_steps_N64_soft16"->steps,"selected_validation_N128_soft32"->Join[KeyDrop[val128,"result"],<|"result"->brief52[val128["result"]]|>],"selected_validation_N256_soft64"->Join[KeyDrop[val256,"result"],<|"result"->brief52[val256["result"]]|>],"selected_weights"->N[val256["result","weights"],17],"selected_averages_N256_soft64"->N[val256["result","averages"],14],"selected_c_vector"->N[cvbest,15],"selected_finite_window"->N[val256["result","finite_window"],17],"scalar_reference_log_score"->71.71499208794934,"scope"->"D1=dual(target=1.0001)-.0001 Sum(coeff_j w_j). Its score is a numerical fixed-geometry diagnostic, not a certified full-family/C_n bound. N32 only screens directions; accepted cones are finite witnesses, not full halos."|>;Export[portable52Out,res,"RawJSON"];Print[<|"out"->portable52Out,"selected"->brief52[val256["result"]]|>];
]
