(* r055 symmetric two-anchor, two-action floating budget probe. *)
root=DirectoryName[$InputFileName];args=$ScriptCommandLine;out=If[Length[args]>=2,args[[2]],FileNameJoin[{root,"pair55.json"}]];mode=If[Length[args]>=3,args[[3]],"scan"];
env55=Quiet@Check[Environment["STRONG_MAXIMAL_REPO"],$Failed];repo=If[StringQ[env55]&&env55!="",env55,DirectoryName[root]];If[!FileExistsQ[FileNameJoin[{repo,"code","receiver_continuous32.wl"}]],Print["Set STRONG_MAXIMAL_REPO to project root"];Exit[2]];
Block[{$ScriptCommandLine={},$r032LibraryMode=True},Get[FileNameJoin[{repo,"code","receiver_continuous32.wl"}]]];
n55=64;b55=32;cap55=2.;target55=1.00001;c55=1.24;ks55=Range[0,b55];bin55=N[Binomial[b55,#]&/@ks55];phiP55=(1+Log[cap55])^(n55-2)(n55+Log[cap55]);
prof55[s_?NumericQ]:=Module[{z,r,d},If[s<1.,Return[0.]];If[s<=n55,Return[1.]];d=Log[s];z=Max[Exp[(d-Log[n55])/(n55-1)]-1.,0.];Do[r=(n55-2)Log[1+z]+Log[n55+z]-d;z=Max[0.,z-r/((n55-2)/(1+z)+1/(n55+z))],{10}];Min[Exp[z],cap55]];
phi55[x_?NumericQ]:=x(1+Max[Log[Max[x,1.]],0.])^(n55-1);
poly55[x_?NumericQ,cc_?NumericQ]:=If[x<=0.,0.,Total[bin55 Clip[x-cc ks55,{0.,Infinity}]^(b55-1)]/(Gamma[b55](1+Exp[-cc])^b55)];
cdf55[x_?NumericQ,cc_?NumericQ]:=Module[{ww=bin55 Exp[-cc ks55]/(1+Exp[-cc])^b55},Total[ww GammaRegularized[b55,0.,Clip[x-cc ks55,{0.,Infinity}]]]];
tailUp55[x_?NumericQ,cc_?NumericQ]:=Module[{xx=N[x,50],dd=N[cc,50],kk=Range[0,b55],ww},ww=N[Binomial[b55,#]Exp[-dd #]/(1+Exp[-dd])^b55&/@kk,50];N[Total[ww Table[If[xx-dd k<=0,1,Exp[-(xx-dd k)]Sum[(xx-dd k)^j/j!,{j,0,b55-1}]],{k,kk}]],35]];
mom55[cc_]:=Module[{p=1/(1+Exp[cc])},{1+cc p,1+cc^2 p(1-p)}];
outer55[lo_,hi_,no_Integer]:=Module[{ed=Subdivide[lo,hi,Ceiling[no/16]],x,w,xx={},ww={}},Do[{x,w}=quad[16,ed[[j]],ed[[j+1]]];xx=Join[xx,x];ww=Join[ww,w],{j,Length[ed]-1}];{xx,ww}];
eval55[ell_?NumericQ,a_?NumericQ,h_?NumericQ,no_Integer:32,inner_Integer:8]:=Module[{cp=c55+h,cm=c55-h,mo,lo,hi,lam=Exp[ell],r,bd,tx,tw,t1,rmix,bound,avg=0.,avgm=0.,cost=0.,l1,l2,l3,x,w,hh,fac,facm,co,aa,aam,pin,omit},
 If[cp<=0||cm<=0,Return[<|"bad"->True|>]];mo=Max[mom55[cp][[1]],mom55[cm][[1]]];lo=-a;hi=a+b55 mo+16 Sqrt[b55 Max[mom55[cp][[2]],mom55[cm][[2]]]];
 r[t1_?NumericQ,t2_?NumericQ]:=.5(poly55[t1-a,cp]poly55[t2+a,cm]+poly55[t1+a,cm]poly55[t2-a,cp]);
 bound[lev_,t_]:=Module[{ll=lo,rr=hi,md},If[lam r[t,ll]>=lev,Return[ll]];If[lam r[t,rr]<=lev,Return[rr]];Do[md=(ll+rr)/2.;If[lam r[t,md]<lev,ll=md,rr=md],{42}];(ll+rr)/2.];
 {tx,tw}=outer55[lo,hi,no];Do[t1=tx[[i]];l1=bound[1.,t1];l2=bound[N[n55],t1];l3=bound[phiP55,t1];fac=Exp[-(t1-a)]poly55[t1-a,cp];
  facm=Exp[-(t1+a)]poly55[t1+a,cm];co=Exp[-t1](Exp[-l1]-Exp[-l2])phi55[1.];aa=fac(cdf55[l2+a,cm]-cdf55[l1+a,cm]);aam=facm(cdf55[l2-a,cp]-cdf55[l1-a,cp]);cost+=tw[[i]]co;avg+=tw[[i]]aa;avgm+=tw[[i]]aam;
  co=Exp[-t1](Exp[-l3]-Exp[-hi])phi55[cap55];aa=fac(cdf55[hi+a,cm]-cdf55[l3+a,cm])cap55;aam=facm(cdf55[hi-a,cp]-cdf55[l3-a,cp])cap55;cost+=tw[[i]]co;avg+=tw[[i]]aa;avgm+=tw[[i]]aam;
  If[l3>l2,{x,w}=quad[inner,l2,l3];Do[hh=prof55[lam r[t1,x[[j]]]];cost+=tw[[i]]w[[j]]Exp[-t1-x[[j]]]phi55[hh];avg+=tw[[i]]w[[j]]hh fac Exp[-(x[[j]]+a)]poly55[x[[j]]+a,cm];avgm+=tw[[i]]w[[j]]hh facm Exp[-(x[[j]]-a)]poly55[x[[j]]-a,cp],{j,Length[x]}]],{i,Length[tx]}];
 omit=Min[1.,tailUp55[hi-a,cp]+tailUp55[hi+a,cm]];
 <|"ell"->ell,"lambda"->lam,"a"->a,"h"->h,"c_plus"->cp,"c_minus"->cm,"finite_window"->{lo,hi},"outer_nodes"->Length[tx],"soft_order"->inner,"budget_J_finite_window"->cost,"average_plus"->avg,"average_minus"->avgm,"mirror_average_difference"->Abs[avg-avgm],"min_average"->Min[avg,avgm],"omitted_mixture_probability_union_bound_diagnostic"->omit,"tail_budget_upper_lambda_PhiCap_diagnostic"->lam phi55[cap55] omit,"V"->2-Exp[-2a],"score"->Log[2-Exp[-2a]]-Log[cost]|>];
cal55[a_,h_,no_:32,inner_:8]:=Module[{lo=-100.,hi=-30.,x,y,m,z,j=0},x=eval55[lo,a,h,no,inner];y=eval55[hi,a,h,no,inner];If[y["min_average"]<target55,Return[<|"status"->"bad_high_bracket","result"->y|>]];Do[m=(lo+hi)/2.;z=eval55[m,a,h,no,inner];If[z["min_average"]>=target55,hi=m;y=z,lo=m;x=z],{16}];<|"status"->"feasible","ell_bracket"->{lo,hi},"result"->y|>];
brief55[x_]:=KeyDrop[x,{"ell","lambda"}];
If[mode=="final",fine512=<|"status"->"fixed_feasible_ell_from_prior_scan","ell_bracket"->{-65.73165893554688,-65.7305908203125},"result"->eval55[-65.7305908203125,1.,0.,512,64]|>;res=<|"status"->"r055 final-only floating re-evaluation; no new grid search","wolfram"->$Version,"selected_from_prior_scan"-><|"a"->1.,"h"->0.,"ell"->-65.7305908203125|>,"validation_N512_soft64"->Join[KeyDrop[fine512,"result"],<|"result"->brief55[fine512["result"]]|>],"scope"->"Actual unscaled finite-window J budget; stable positive Gamma-tail diagnostic; both mirror averages evaluated numerically. Not a certificate or global optimum."|>,
 agrid={0.,.25,1.,4.,8.};hgrid={-.05,0.,.05};rows=Flatten[Table[z=cal55[a,h];<|"a"->a,"h"->h,"calibration"->KeyDrop[z,"result"],"result"->brief55[z["result"]]|>,{a,agrid},{h,hgrid}],1];best=First@MaximalBy[Select[rows,#calibration["status"]=="feasible"&],#result["score"]&];fine256=cal55[best["a"],best["h"],256,32];fine512=cal55[best["a"],best["h"],512,64];res=<|"status"->"r055 symmetric two-receiver split-branch finite-window floating probe; not a certificate or global optimum","wolfram"->$Version,"model"->"anchors (a,-a),(-a,a); source likelihood lambda(R+ + R-)/2; receiver actions (c+h,c-h) and mirror","n"->n55,"b"->b55,"cap"->cap55,"c"->c55,"target"->target55,"coarse_N32_soft8"->rows,"best_by_coarse_score"->best,"validation_N256_soft32"->Join[KeyDrop[fine256,"result"],<|"result"->brief55[fine256["result"]]|>],"validation_N512_soft64"->Join[KeyDrop[fine512,"result"],<|"result"->brief55[fine512["result"]]|>],"volume_formula"->"V=2-exp(-2a) for the two positive-cone witnesses","scope"->"Both mirror averages are evaluated; all calculations are floating finite-window quadrature. A score below 71.79 has no C64-improvement interpretation."|>];Export[out,res,"RawJSON"];Print[<|"out"->out,"mode"->mode,"fine512"->brief55[fine512["result"]]|>];
