Clear[l,c,m,a1,a2];
cc=m+a1 l+a2 l^2;
eq=Normal@Series[Exp[cc]((Exp[l cc]-1)/l-1)-1,{l,0,2}];
eq=FullSimplify[Expand[eq]/.Exp[m]->1/(m-1),Assumptions->m>1];
rule1=First@Solve[Coefficient[eq,l,1]==0,a1];
rule2=First@Solve[(Coefficient[eq,l,2]/.rule1)==0,a2];
kk[c_,l_]:=Log[1+Exp[-(1+l)c]]-Log[1+Exp[-c]]-Log[1+l];
gain=FullSimplify[Coefficient[Normal@Series[kk[cc,l]-kk[m,l],{l,0,3}],l,3]/.rule1/.Exp[m]->1/(m-1),Assumptions->m>1];
mean[c_]:=1+c/(1+Exp[c]); variance[c_]:=1+c^2 Exp[c]/(1+Exp[c])^2;
derivatives=FullSimplify[{D[mean[c],{c,2}],D[variance[c],c]}/.c->m/.Exp[m]->1/(m-1),Assumptions->m>1];
expRules=Table[Exp[j m]->(m-1)^(-j),{j,-6,6}];
gain=FullSimplify[gain/.rule2/.expRules,Assumptions->m>1];
derivatives=FullSimplify[derivatives/.expRules,Assumptions->m>1];
mm=1+ProductLog[Exp[-1]];
rows=Table[Module[{roots,gains},roots=Table[x/.FindRoot[Exp[x]((Exp[ll x]-1)/ll-1)-1==0,{x,N[mm,wp]},WorkingPrecision->wp,AccuracyGoal->Floor[wp/2],PrecisionGoal->Floor[wp/2]],{wp,{40,80}}];gains=(-ll roots[[2]]-kk[mm,ll])/ll^3;
<|"lambda"->ToString[ll,InputForm],"optimal_c_80"->ToString[N[roots[[2]],60],InputForm],"precision_doubling_stable_30_digits"->TrueQ[Abs[roots[[1]]-roots[[2]]]<10^-30],"cubic_gain_ratio"->ToString[N[gains,30],InputForm],"optimal_value_identity_residual"->ToString[N[kk[roots[[2]],ll]+ll roots[[2]],30],InputForm]|>],{ll,{1/100,1/1000}}];
result=<|"wolfram_version"->$Version,"high_precision_rows"->rows,"c_lambda_linear_coefficient"->ToString[a1/.rule1,InputForm],"c_lambda_quadratic_coefficient"->ToString[a2/.rule2,InputForm],"log_laplace_cubic_gain_coefficient"->ToString[gain,InputForm],"mean_second_variance_first_at_mu"->(ToString[#,InputForm]&/@derivatives)|>;
root=DirectoryName[DirectoryName[$InputFileName]];
Export[FileNameJoin[{root,"rounds","r015","symbolic_checks.json"}],result,"RawJSON"];
Print[ExportString[result,"RawJSON"]];
