sym89=<|"normal_tail_derivative"->TrueQ[FullSimplify[D[q89[x],x]==-phi89[x],Assumptions->Element[x,Reals]]],"normal_stoploss_derivative"->TrueQ[FullSimplify[D[psi89[x],x]==-q89[x],Assumptions->Element[x,Reals]]],"normalized_ramp_derivative"->TrueQ[FullSimplify[D[-sn q89[z+a h]/ss+(z+a h)+psi89[z+a h]-psi89[w-a h],a]==h(sn phi89[z+a h]/ss+1-q89[z+a h]-q89[w-a h]),Assumptions->ss>0&&sn>0&&h>0&&Element[{a,z,w},Reals]]],"Phi_log_derivative_gap"->TrueQ[FullSimplify[D[Log[t]+(nn-1)Log[1+Log[t]],t]-nn/(t(1+Log[t]))==Log[t]/(t(1+Log[t])),Assumptions->t>1&&nn>=2]],"Phi_near_one_quadratic"->TrueQ[FullSimplify[D[logPhi89[x,nn],{x,2}]/.x->0]==-2nn+1],"polynomial_clipping_optimizer"->TrueQ[FullSimplify[(D[ss^2/(2b)+(pp+1/2)b,b]/.b->ss/Sqrt[2pp+1])==0,Assumptions->ss>0&&pp>0]],"polynomial_clipping_leading_value"->TrueQ[FullSimplify[(ss^2/(2b)+(pp+1/2)b/.b->ss/Sqrt[2pp+1])==ss Sqrt[2pp+1],Assumptions->ss>0&&pp>0]],"Lp_normalized_v_identity"->TrueQ[FullSimplify[(p(p(1-Exp[-(u+v/p)/p])-1-r Exp[-v/p])-(v-p r(Exp[-v/p]-1)-p^2(Exp[-(u+v/p)/p]-1+(u+v/p)/p))/.u->1+r)==0,Assumptions->p>0]],"Lp_normalized_v_derivative"->TrueQ[FullSimplify[D[p(p(1-Exp[-(u+v/p)/p])-1-Exp[-u-v/p]),v]==Exp[-(u+v/p)/p]+Exp[-u-v/p],Assumptions->p>0]],"high_source_sup_stationary"->TrueQ[FullSimplify[(D[p Log[v]-v,v]/.v->p)==0,Assumptions->p>=2]],"two_height_modular_budget"->TrueQ[FullSimplify[Exp[-s]+b Exp[-s-Log[b]]==2Exp[-s],Assumptions->b>0&&s>0]],"quadratic_reduction_optimum"->TrueQ[FullSimplify[(ss^2/(2b)+c b/.b->ss/Sqrt[2c])==ss Sqrt[2c],Assumptions->ss>0&&c>0]]|>;
