ClearAll[phi89,q89,psi89,str89,model89,runR89,runQ89,runH89];phi89[x_]:=Exp[-x^2/2]/Sqrt[2Pi];q89[x_]:=Erfc[x/Sqrt[2]]/2;psi89[x_]:=phi89[x]-x q89[x];str89[x_]:=ToString[N[x,65],InputForm];
