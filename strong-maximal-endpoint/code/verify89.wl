model89[k_Integer,wp_Integer]:=model89[k,wp]=Module[{prec=wp+Ceiling[k Log[2]/Log[10]]+80,nn=2^k,ll,mu,ss,zz},ll=N[k Log[2],prec];mu=u/.FindRoot[u-1-Exp[-u]==0,{u,N[128/100,prec]},WorkingPrecision->prec,AccuracyGoal->prec-20,PrecisionGoal->prec-20];ss=Sqrt[mu];zz=u/.FindRoot[Log[q89[u]]-Log[ss u]+ll/2==0,{u,N[4Sqrt[ll]/5,prec],N[11Sqrt[ll]/10,prec]},WorkingPrecision->prec,AccuracyGoal->prec-20,PrecisionGoal->prec-20,MaxIterations->100];<|"precision"->prec,"N"->nn,"L"->ll,"mu"->mu,"sigma"->ss,"z"->zz|>];
runR89[zcase_]:=Module[{k=zcase[[1]],rat=zcase[[2]],rows={},wp,md,prec,nn,ll,ss,zz,ww,sc,lo,hi,mid,ff,df,it,aa,res,pass},Do[md=model89[k,wp];{prec,nn,ll,ss,zz}=Lookup[md,{"precision","N","L","sigma","z"}];ww=rat Sqrt[ll]-zz;sc=ss psi89[ww]/(Sqrt[N[nn,prec]]phi89[zz]);ff[a_?NumericQ]:=-Sqrt[N[nn,prec]]q89[zz+a sc]/ss+(zz+a sc)+psi89[zz+a sc]-psi89[ww-a sc];df[a_?NumericQ]:=sc(Sqrt[N[nn,prec]]phi89[zz+a sc]/ss+1-q89[zz+a sc]-q89[ww-a sc]);lo=N[-2,prec];hi=N[2,prec];Do[If[ff[lo]<=0,Break[]];lo*=2,{60}];Do[If[ff[hi]>=0,Break[]];hi*=2,{60}];If[!TrueQ[ff[lo]<=0<=ff[hi]],Return["BRACKET_FAILURE"]];it=Ceiling[(wp+12)Log[10]/Log[2]]+Max[0,Ceiling[Log[2,hi-lo]]]+8;Do[mid=(lo+hi)/2;If[ff[mid]>0,hi=mid,lo=mid],{it}];aa=(lo+hi)/2;res=Abs[ff[aa]/df[aa]];pass=TrueQ[res<10^(-wp)&&df[aa]>0];AppendTo[rows,<|"working_precision"->wp,"guarded_working_precision"->prec,"z"->str89[zz],"w"->str89[ww],"log_D"->str89[Log[ss^2 psi89[ww]/phi89[zz]]],"normalized_root"->str89[aa],"residual_over_derivative"->str89[res],"pass"->pass|>],{wp,{80,160}}];<|"k"->k,"K_over_sigma"->ToString[rat,InputForm],"kernel_id"->$KernelID,"rows"->rows|>];
runQ89[zcase_]:=Module[{k=zcase[[1]],kind=zcase[[2]],rows={},wp,md,prec,nn,ll,ss,zz,le,eps,yy,sh,guess,res},Do[md=model89[k,wp];{prec,nn,ll,ss,zz}=Lookup[md,{"precision","N","L","sigma","z"}];le=Switch[kind,"1/N",-ll,"1/sqrt(NL)",-(ll+Log[ll])/2,"K=.5sigma",Log[ss/2]+(Log[ll]-ll)/2,"K=.75sigma",Log[3ss/4]+(Log[ll]-ll)/2];eps=Exp[le];guess=Sqrt[-2le];yy=u/.FindRoot[Log[q89[u]]==le,{u,9guess/10,11guess/10},WorkingPrecision->prec,AccuracyGoal->prec-20,PrecisionGoal->prec-20,MaxIterations->100];sh=yy-zz;res=Abs[Log[q89[yy]]-le];AppendTo[rows,<|"working_precision"->wp,"guarded_working_precision"->prec,"epsilon"->str89[eps],"log_epsilon"->str89[le],"y"->str89[yy],"z"->str89[zz],"standardized_shift"->str89[sh],"gaussian_log_loss"->str89[ss Sqrt[N[nn,prec]]sh],"gaussian_log_loss_over_W"->str89[ss Sqrt[ll]sh],"log_tail_residual"->str89[res],"pass"->TrueQ[res<10^-wp]|>],{wp,{80,160}}];<|"k"->k,"type"->kind,"kernel_id"->$KernelID,"rows"->rows|>];
runH89[zcase_]:=Module[{k=zcase[[1]],mode=zcase[[2]],rows={},wp,md,prec,nn,ll,mu,ss,zz,ww,p,b,pp,c,delta,cap,ls,sv,loga,lp,v,dv,gg,gp,bp,res,c0,hgap,norm,omit,omlog,svomit},Do[md=model89[k,wp];{prec,nn,ll,mu,ss,zz}=Lookup[md,{"precision","N","L","mu","sigma","z"}];ww=Sqrt[N[nn,prec]/ll];Which[StringStartsQ[mode,"P="],pp=Switch[mode,"P=.25",1/4,"P=1",1,"P=4",4];b=ss/Sqrt[2pp+1];p=b ww;cap=ss(1+Sqrt[2pp+1])Sqrt[ll/nn];ls=-(pp+1)ll;norm=ww Log[ll],mode=="critical",b=ss;p=b ww;cap=2ss Sqrt[ll/nn];ls=-ll-Log[ll]/4;norm=ww Log[ll],True,c=Switch[mode,"quadratic_c=.1",1/10,"quadratic_c=.2",1/5,"quadratic_c=.3",3/10];delta=N[2^(-k/4),prec];b=ss/Sqrt[2c];p=b/delta;cap=delta;ls=-c nn delta^2;norm=nn delta];omit=TrueQ[ls<-(2ll+(wp+50)Log[10])];omlog=If[omit,Log[2]+ll+ls,Null];svomit=TrueQ[ls < -10000];sv=If[svomit,Null,Exp[ls]];loga=Log[1+cap]+If[omit,0,Log[1-Exp[ls]]];lp=loga+(nn-1)Log[1+loga];gg[a_?NumericQ]:=p(p(1-Exp[-(mu+a/p)/p])-1-Exp[-mu-a/p]);gp[a_?NumericQ]:=Exp[-(mu+a/p)/p]+Exp[-mu-a/p];v=N[mu/2,prec];Do[dv=gg[v]/gp[v];v-=dv;If[Abs[dv]<10^(-wp-20),Break[]],{40}];bp=mu+v/p;res=Abs[gg[v]];c0=2(1+Log[2]);hgap=(nn/p)v+ss Sqrt[N[nn,prec]]zz+p(Log[c0]+Log[p]-ll-ls)-lp;AppendTo[rows,<|"working_precision"->wp,"guarded_working_precision"->prec,"p"->str89[p],"b_parameter"->str89[b],"cap_excess"->str89[cap],"s"->If[svomit,Null,str89[sv]],"threshold_value_omitted"->svomit,"log_s"->str89[ls],"log_a"->str89[loga],"ln_Phi_a"->str89[lp],"C0"->str89[c0],"v"->str89[v],"b_p"->str89[bp],"v_equation_residual"->str89[res],"log_high_fee_minus_q0"->str89[hgap],"normalized_gap"->str89[hgap/norm],"threshold_log1p_approximated"->omit,"log_bound_on_omitted_N_times_log1p"->If[omit,str89[omlog],Null],"pass"->TrueQ[p>=2&&0<loga<Log[2]&&res<10^-wp]|>],{wp,{80,160}}];<|"k"->k,"mode"->mode,"kernel_id"->$KernelID,"rows"->rows|>];
ks89={16,32,64,128,256,512,1024};rj89=Tuples[{ks89,{1,5/4,3/2,7/4,19/10}}];qj89=Tuples[{ks89,{"1/N","1/sqrt(NL)","K=.5sigma","K=.75sigma"}}];hj89=Tuples[{ks89,{"P=.25","P=1","P=4","critical","quadratic_c=.1","quadratic_c=.2","quadratic_c=.3"}}];
LaunchKernels[workers89];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[phi89,q89,psi89,str89,model89,runR89,runQ89,runH89,mem89];tt89=AbsoluteTime[];root89=ParallelMap[MemoryConstrained[TimeConstrained[runR89[#],120,"TIMEOUT"],mem89 2^20,"MEMORY_LIMIT"]&,rj89,Method->"FinestGrained"];Print["r089 Gaussian roots done ",Length[root89]];quant89=ParallelMap[MemoryConstrained[TimeConstrained[runQ89[#],120,"TIMEOUT"],mem89 2^20,"MEMORY_LIMIT"]&,qj89,Method->"FinestGrained"];clip89=ParallelMap[MemoryConstrained[TimeConstrained[runH89[#],120,"TIMEOUT"],mem89 2^20,"MEMORY_LIMIT"]&,hj89,Method->"FinestGrained"];CloseKernels[];pass89=And@@Values[sym89]&&AllTrue[Join[root89,quant89,clip89],AssociationQ[#]&&AllTrue[#["rows"],TrueQ[#["pass"]]&]&];Export[FileNameJoin[{out89,"verification89.json"}],<|"version"->$Version,"configured_workers"->workers89,"per_case_memory_limit_MiB"->mem89,"kernels_closed"->True,"seconds"->N[AbsoluteTime[]-tt89],"pass"->TrueQ[pass89],"symbolic"->sym89,"root_rows"->root89,"quantile_rows"->quant89,"clipping_rows"->clip89,"scope"->"Gaussian comparison and explicit fee formulas only; no physical finite-N onset or norm values."|>,"RawJSON"];Print[If[TrueQ[pass89],"PASS ","FAIL "],Length[root89]+Length[quant89]+Length[clip89]," scalar parameter cases"];If[!TrueQ[pass89],Print[sym89];Print[Cases[Join[root89,quant89,clip89],_String]];Exit[3]];
