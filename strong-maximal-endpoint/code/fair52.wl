(* r052 fair same-shape comparison: matched delta=-.05 versus uniform delta=0. *)
r=DirectoryName[$InputFileName];args=$ScriptCommandLine;out=If[Length[args]>=2,args[[2]],FileNameJoin[{$TemporaryDirectory,"fair52.json"}]];
Block[{$ScriptCommandLine={},$inner52PortableLibraryMode=True},Get[FileNameJoin[{r,"inner52.wl"}]]];
fair52Input=If[Length[args]>=3,args[[3]],FileNameJoin[{portable52Repo,"rounds","r052","inner52.json"}]];old=Import[fair52Input,"RawJSON"];sh=old["selected_weights"];base=c+.10;cvM=base-.05(q52^2-center52);cvU=ConstantArray[base,ng];
fine[cv_,no_Integer,ord_Integer]:=Module[{l=.96,h=1.04,a,b,m,k=0},a=eval52[l sh,cv,no,ord];b=eval52[h sh,cv,no,ord];While[!b["all_constraints_pass"]&&k<4,h*=1.1;b=eval52[h sh,cv,no,ord];k++];If[!b["all_constraints_pass"],Return[<|"status"->"no_bracket","low"->a,"high"->b|>]];Do[m=(l+h)/2.;a=eval52[m sh,cv,no,ord];If[a["all_constraints_pass"],h=m;b=a,l=m],{12}];<|"status"->"feasible","scale"->h,"bracket_width"->h-l,"result"->b|>];
If[!TrueQ[$fair52LibraryMode],m128=fine[cvM,128,32];u128=fine[cvU,128,32];winner=If[m128["result","accepted_cone_log_score"]>=u128["result","accepted_cone_log_score"],"matched_delta_minus_005","uniform_delta_0"];winCV=If[winner=="matched_delta_minus_005",cvM,cvU];win128=If[winner=="matched_delta_minus_005",m128,u128];win256=fine[winCV,256,64];
brief[x_]:=KeyDrop[x,{"weights","averages","c_vector","finite_window"}];res=<|"wolfram"->$Version,"status"->"same-shape fair matched-vs-uniform numerical comparison; floating only","target"->target52,"shape_source"->"r052 selected 33 weights, held exactly fixed across both laws","matched_delta_minus_005_N128_soft32"->Join[KeyDrop[m128,"result"],<|"result"->brief[m128["result"]]|>],"uniform_delta_0_N128_soft32"->Join[KeyDrop[u128,"result"],<|"result"->brief[u128["result"]]|>],"winner_by_N128_score"->winner,"winner_N256_soft64"->Join[KeyDrop[win256,"result"],<|"result"->brief[win256["result"]],"all_33_averages"->win256["result","averages"]|>],"matched_c_vector"->cvM,"uniform_c_vector"->cvU,"shared_weights"->sh,"scope"->"Both models rebuild source and receiver with their stated law. Each scale is a 12-bisection finite-quadrature calibration; no interval certification or global optimization claim."|>;Export[out,res,"RawJSON"];Print[<|"out"->out,"winner"->winner,"m128"->brief[m128["result"]],"u128"->brief[u128["result"]],"w256"->brief[win256["result"]]|>]
;];
