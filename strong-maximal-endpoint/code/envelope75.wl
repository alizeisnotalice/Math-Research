argsE75=Rest[$ScriptCommandLine];pyE75=Import[argsE75[[1]],"RawJSON"];outE75=argsE75[[2]];If[!DirectoryQ[outE75],CreateDirectory[outE75,CreateIntermediateDirectories->True]];ClearAll[env75];env75[j_]:=Module[{n=j["N"],wp=j["precision"],cm=Rationalize[j["c_lower"],0],cp=Rationalize[j["c_upper"],0],s=Rationalize[j["node"]["S"],0],h,ss,hm,hp,margin},h[c_,t_]:=Module[{k,g,v},k=Select[Range[0,n],t-c #>0&];g=t-c k;v=N[Log[Binomial[n,k]]+(n-1)Log[g],wp+20];Max[v]+Log[Total[Exp[v-Max[v]]]]-LogGamma[n]];hm=h[cm,s];hp=h[cp,s];ss=s-n(cp-cm);margin=If[ss>0,hp-h[cm,ss],Null];<|"N"->n,"K"->j["K"],"radial_node"->j["node"]["radial_node"],"precision"->wp,"log_envelope_ratio"->ToString[N[hm-hp,35],InputForm],"log_shift_comparison_margin"->If[margin===Null,Null,ToString[N[margin,35],InputForm]],"numeric"->TrueQ[hm>=hp&&If[margin===Null,True,margin>=0]]|>];jobsE75=Flatten[Table[Join[KeyDrop[j,{"rows"}],<|"node"->nd,"precision"->wp|>],{j,Select[pyE75["rows"],#["N"]<=1024&]},{nd,j["rows"]},{wp,{50,100}}],2];LaunchKernels[12];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[env75];startE75=AbsoluteTime[];rowsE75=ParallelMap[env75,jobsE75,Method->"FinestGrained"];CloseKernels[];Export[FileNameJoin[{outE75,"envelope75.json"}],<|"version"->$Version,"workers"->12,"seconds"->N[AbsoluteTime[]-startE75],"rows"->rowsE75,"candidate_SHA256"->FileHash[argsE75[[1]],"SHA256","HexString"]|>,"RawJSON"];If[!AllTrue[rowsE75,TrueQ[#["numeric"]]&],Print["FAIL"];Exit[3]];Print["PASS ",Length[rowsE75]," full-sum coarse envelope checks"];
