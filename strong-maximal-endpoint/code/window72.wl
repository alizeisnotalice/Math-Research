argsW72=Rest[$ScriptCommandLine];outW72=argsW72[[1]];If[!DirectoryQ[outW72],CreateDirectory[outW72,CreateIntermediateDirectories->True]];
ClearAll[win72];win72[j_]:=Module[{n=j["N"],wp=j["precision"],idx=j["shift_index"],mu,t,c,p,lo,hi,k,w,low,up,tail,bound},mu=x/.FindRoot[x==1+Exp[-x],{x,N[5/4,wp+30]},WorkingPrecision->wp+30];t=Switch[idx,0,0,1,-Sqrt[mu]/2,2,-1/2,3,1/2];c=mu+t Sqrt[Log[n]/n];p=1/(1+Exp[c]);lo=Max[0,n mu-7Sqrt[n Log[n]]];hi=n mu+7Sqrt[n Log[n]];k=Range[0,n];w=Binomial[n,k]p^k(1-p)^(n-k);low=Map[If[#<=0,0,GammaRegularized[n,0,#]]&,lo-c k];up=Map[If[#<=0,1,GammaRegularized[n,#]]&,hi-c k];tail=Total[w(low+up)];bound=2n^-6;<|"N"->n,"shift_index"->idx,"precision"->wp,"tail"->ToString[N[tail,35],InputForm],"mu_root_residual"->ToString[N[Abs[mu-1-Exp[-mu]],20],InputForm],"normalization_residual"->ToString[N[Abs[Total[w]-1],20],InputForm],"numeric"->TrueQ[0<tail<bound&&Abs[Total[w]-1]<10^(-Floor[wp/2])]|>];
jobsW72=Flatten[Table[<|"N"->n,"shift_index"->i,"precision"->wp|>,{n,{2,4,8,16,32,64,128,256}},{i,0,3},{wp,{50,100}}],2];LaunchKernels[12];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[win72];startW72=AbsoluteTime[];rowsW72=ParallelMap[win72,jobsW72,Method->"FinestGrained"];CloseKernels[];Export[FileNameJoin[{outW72,"window72.json"}],<|"version"->$Version,"workers"->12,"seconds"->N[AbsoluteTime[]-startW72],"rows"->rowsW72|>,"RawJSON"];If[!AllTrue[rowsW72,TrueQ[#["numeric"]]&],Print["FAIL"];Exit[3]];Print["PASS ",Length[rowsW72]," full finite-sum tail checks"];
