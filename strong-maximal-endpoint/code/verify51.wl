 p=1/(1+Exp[c]);poly[k_Integer,x_,power_Integer]:=Sum[Binomial[k,j]If[x-j c>0,(x-j c)^power,0],{j,0,k}];
 den[k_Integer,x_]:=If[x<=0,0,Exp[-x]poly[k,x,k-1]/(Gamma[k](1+Exp[-c])^k)];
