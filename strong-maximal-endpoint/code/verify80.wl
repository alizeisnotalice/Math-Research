args80=Rest[$ScriptCommandLine];in80=args80[[1]];out80=args80[[2]];If[!DirectoryQ[out80],CreateDirectory[out80,CreateIntermediateDirectories->True]];
ClearAll[rat80,X80,Y80,R80,poly80,bern80,chunk80,gridK80,step80,hi80];
rat80[s_String]:=If[StringMatchQ[s,RegularExpression["-?[0-9]+(/[0-9]+)?"]],ToExpression[s,InputForm],Throw["bad rational"]];
X80[u_]:=(u+1/u)/2;Y80[u_]:=u+1/(4u);R80[u_,a_]:=(4a^2u^2-2a u+1)/(4a^2u^2);
poly80[u_,a_,e_]:=4e a^2u(u^2+1-2a u)-(u-a)^2(4a^2u^2-2a u+1);
bern80[a_,e_,l_,r_]:=Module[{c},c=CoefficientList[Expand[poly80[l+(r-l)t,a,e]],t];PadRight[c,5].Table[If[j<=i,Binomial[i,j]/Binomial[4,j],0],{j,0,4},{i,0,4}]];
chunk80[z_]:=Catch[Module[{m=z[[1]],h,e,a,l,r,bs,mins={}},h=1/(12m);e=h^2;Do[a=2/3+k h;l=Max[2/3,a-h/2];r=Min[3/4,a+h/2];bs=bern80[a,e,l,r];If[Min[bs]<=0,Throw["Bernstein sign"]];AppendTo[mins,Min[bs]],{k,z[[2]],z[[3]]}];<|"M"->m,"minimum"->ToString[Min[mins],InputForm],"nodes"->Length[mins],"exact_pass"->True|>]];
gridK80[m_,x_,j_]:=Module[{ks,vals},ks=Range[Max[0,j-1],Min[m,j+1]];vals=Table[(m(m-1)-k(k-1))/(2m^2(x-k/m)),{k,ks}];If[(m(m-1)-j(j-1))/(2m^2(x-j/m))!=Max[vals],Throw["not grid maximum"]];Max[vals]];
step80[z_]:=Catch[Module[{m=z["mesh"],d=4/z["mesh"],x,y,u,ix,iy,v},If[m<=384||rat80[z["halo_depth"]]!=d||rat80[z["uniform_source_error_upper"]]!=4/m||rat80[z["budget_lower"]]!=Sqrt[m]/147456,Throw["step parameters"]];If[(rat80/@z["source_modular_interval"])!={Max[0,jfint80[[1]]-12/m],jfint80[[2]]}||rat80[z["normalized_budget_lower"]]!=rat80[z["budget_lower"]]/jfint80[[2]],Throw["actual Orlicz denominator"]];
Do[u=rat80[r["u"]];x=X80[u];y=Y80[u]-d;{ix,iy}=r["maximizing_anchor_indices"];v=2gridK80[m,x,ix]gridK80[m,y,iy];If[x!=rat80[r["x"]]||y!=rat80[r["y"]]||v!=rat80[r["exact_maximal_value"]]||v<1+68/(15m),Throw["step halo"]],{r,z["samples"]}];<|"mesh"->m,"samples"->Length[z["samples"]],"exact_pass"->True|>]];
hi80[z_]:=Module[{n=z["N"],wp,lc,lb,rows={}},Do[lc=N[If[n==2,Log[3072],Log[1179648]+(n-2)Log[4]],wp];lb=N[-Log[24]-lc+4n Log[2],wp];AppendTo[rows,<|"precision"->wp,"log_section_constant"->ToString[N[lc,40],InputForm],"log_truncated_cover_budget_lower"->ToString[N[lb,40],InputForm]|>],{wp,{60,120}}];<|"N"->n,"rows"->rows|>];
(* Exact identities and rational range gates supporting the continuum proof. *)
ka80=(1-a^2)/(2(x-a));ident80=TrueQ[FullSimplify[(u-ka80/.x->X80[u])==(a-u)^2/(2(X80[u]-a)),Assumptions->0<u<1&&0<a<1]];
boundary80=TrueQ[FullSimplify[Y80[u]==((1/(2u))+2u)/2&&2u(1/(2u))==1,Assumptions->u>0]];
praw80=(1-a^2)(1-1/(4a^2))-2(X80[u]-a)(Y80[u]-d-1/(2a));
factor80=TrueQ[FullSimplify[praw80==2d(X80[u]-a)-(u-a)^2 R80[u,a],Assumptions->u>0&&a>0]];
range80=TrueQ[Resolve[ForAll[w,4/9<=w<=9/16,73/81<=(4w^2-2w+1)/(4w^2)<=73/64],Reals]];
slope80=TrueQ[Resolve[ForAll[u,2/3<=u<=3/4,8/5<=2u^2/(1-u^2)<=18/7],Reals]];
const80=TrueQ[33/32==25/24-1/96&&1/768==(1/24)(1/32)&&32/Sqrt[65]<4&&39/4<10&&5Sqrt[10]/4<4&&229/768==7/12-73/256];
deficit80=TrueQ[FullSimplify[Integrate[L-A Sqrt[t],{t,0,(L/A)^2},Assumptions->L>0&&A>0]==L^3/(3A^2),Assumptions->L>0&&A>0]];
jfexact80=FullSimplify[Integrate[2z(-Log[z]),{z,0,1/2}]+Integrate[2z(1+Log[2z])(-Log[z]),{z,1/2,1}]];jfid80=TrueQ[FullSimplify[jfexact80==(1+5Log[2])/8]];
interp80=(1-1/m-a^2+a/m)/(2(x-a));interpder80=TrueQ[FullSimplify[D[interp80,a]==(a^2-2x a+1+(x-1)/m)/(2(x-a)^2),Assumptions->m>=1&&x>1&&0<=a<=1]];
l2point80=TrueQ[Resolve[ForAll[v,0<=v<=1/2,(768v)^2<=294912v],Reals]];
sym80=<|"quadratic_deficit"->ident80,"boundary_formula"->boundary80,"coverage_factorization"->factor80,"range_of_R"->range80,"inverse_slope_range"->slope80,"curvature_constants"->const80,"deficit_integral"->deficit80,"source_modular_identity"->jfid80,"step_interpolant_derivative"->interpder80,"transverse_L2_pointwise_bound"->l2point80|>;
src80=Import[FileNameJoin[{in80,"frontier80.json"}],"RawJSON"];l2lo80=Sum[2(1/3)^(2k+1)/(2k+1),{k,0,39}];l2hi80=l2lo80+2(1/3)^81/(81(1-1/9));jfint80={(1+5Floor[10^30 l2lo80]/10^30)/8,(1+5Ceiling[10^30 l2hi80]/10^30)/8};If[jfint80!=(rat80/@src80["source_modular_interval"]),Print["FAIL Orlicz denominator interval"];Exit[3]];
jobs80=Flatten[Table[Table[{r["M"],j,Min[j+31,r["M"]]},{j,0,r["M"],32}],{r,src80["coverage"]}],1];
LaunchKernels[12];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[rat80,X80,Y80,R80,poly80,bern80,chunk80,gridK80,step80,hi80,jfint80];tt80=AbsoluteTime[];
chunks80=ParallelMap[TimeConstrained[chunk80[#],60,"TIMEOUT"]&,jobs80,Method->"FinestGrained"];steps80=ParallelMap[step80,src80["rational_step"]];high80=ParallelMap[hi80,src80["high_dimension"]];CloseKernels[];
coverage80=Table[With[{c=Select[chunks80,AssociationQ[#]&&#["M"]==r["M"]&]},<|"M"->r["M"],"exact_pass"->TrueQ[Length[c]>0&&AllTrue[c,TrueQ[#["exact_pass"]]&]&&Min[rat80[#["minimum"]]&/@c]==rat80[r["minimum_Bernstein_coefficient"]]&&Total[#["nodes"]&/@c]==r["certified_nodes"]&&r["maximum_subdivision_depth"]==0&&rat80[r["budget_lower"]]==r["M"]/6144],"nodes"->Total[#["nodes"]&/@c]|>],{r,src80["coverage"]}];
prec80=Table[<|"precision"->wp,"source_modular"->ToString[N[jfexact80,wp],InputForm]|>,{wp,{60,120}}];
pass80=And@@Values[sym80]&&AllTrue[Join[coverage80,steps80],AssociationQ[#]&&TrueQ[#["exact_pass"]]&];
Export[FileNameJoin[{out80,"verification80.json"}],<|"version"->$Version,"workers"->12,"seconds"->N[AbsoluteTime[]-tt80],"pass"->pass80,"symbolic"->sym80,"coverage"->coverage80,"rational_step"->steps80,"high_dimension"->high80,"source_modular_precision"->prec80|>,"RawJSON"];
Print[If[pass80,"PASS ","FAIL "],Total[#["nodes"]&/@coverage80]," Bernstein cells; ",Total[#["samples"]&/@steps80]," exact step tests; symbolic no-budget gates"];
If[!pass80,Print[sym80];Print[Cases[Join[chunks80,steps80],_String]];Exit[3]];
