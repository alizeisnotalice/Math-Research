args72=Rest[$ScriptCommandLine];in72=Import[args72[[1]],"RawJSON"];out72=args72[[2]];If[!DirectoryQ[out72],CreateDirectory[out72,CreateIntermediateDirectories->True]];
ClearAll[test72];test72[j_]:=Module[{n=j["N"],x=Rationalize[j["Ac"],0],wp=j["precision"],moment,fun,cuts,integ,val,lower},
 moment[r_?NumericQ]:=Module[{u=r/x,k,g,logs,w},If[r==0,Return[1/(n(n+1))]];k=Select[Range[0,n],#<u&];g=u-k;logs=Log[Binomial[n,k]]+(n-1)Log[g];w=Exp[logs-Max[logs]];w=w/Total[w];Total[w(k(k-1)/(n(n-1)u^2)+2k g/(n^2 u^2)+g^2/(n(n+1)u^2))]];
