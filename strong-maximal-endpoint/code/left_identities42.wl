Clear[c,m,s,d,alpha];pc[c_]:=1/(1+Exp[c]);mm[c_]:=1+c pc[c];vv[c_]:=1+c^2 pc[c](1-pc[c]);
red42[x_]:=FullSimplify[Together[x/.c->m]/.{Exp[2m]->1/(m-1)^2,Exp[m]->1/(m-1),Exp[-m]->m-1},Assumptions->m>1];
ll[c_]:=(b0+b[c])/(1+Exp[-c]);pfirst=FullSimplify[(D[ll[c],c]-pc[c](ll[c]-ff[c]))/.Derivative[1][b][c]->-Exp[-c]ff[c]];
psecond=FullSimplify[(D[ll[c],{c,2}]-pc[c]((2pc[c]-1)(ll[c]-ff[c])+fp[c]))/.{Derivative[2][b][c]->Exp[-c](ff[c]+fp[c]),Derivative[1][b][c]->-Exp[-c]ff[c]}];
checks42=<|"m_mu"->red42[mm[c]],"m_prime_mu"->red42[D[mm[c],c]],"m_second_mu"->red42[D[mm[c],{c,2}]],"variance_mu"->red42[vv[c]],"variance_prime_mu"->red42[D[vv[c],c]],"kernel_first_derivative_residual"->pfirst,"kernel_second_derivative_residual"->psecond,"sharp_interpolation_identity_residual"->FullSimplify[(s+6d)^2/(s+3d)-(s+9d+9d^2/(s+3d)),Assumptions->s>=0&&d>0],"sharp_interpolation_bound"->FullSimplify[(s+6d)^2/(s+3d)<=s+12d,Assumptions->s>=0&&d>0],"contact_first_buffer"->FullSimplify[3alpha m(m-1)/(8m)],"contact_second_buffer"->FullSimplify[6alpha m(m-1)/(8m)],"clipping_favorable"->FullSimplify[Max[0,x]>=x,Assumptions->Element[x,Reals]]|>;
out42=If[Length[$ScriptCommandLine]>=2,$ScriptCommandLine[[2]],"/tmp/left_identities42.json"];Export[out42,<|"wolfram"->$Version,"arithmetic"->"exact; m>1 and exp(m)=1/(m-1)","checks"->Map[If[NumberQ[#]||MemberQ[{True,False},#],#,ToString[#,InputForm]]&,checks42]|>,"RawJSON"];Print[checks42];
