(* Exact-budget positive-orthant test profiles and stable one-block tails. *)
$blockKernel46LibraryMode=True;Get[FileNameJoin[{DirectoryName[$InputFileName],"block_kernel46.wl"}]];$blockKernel46LibraryMode=False;
logTailQ46[b_Integer,c_,t_,upperQ_,wp_,step_:1/16,cut_:32]:=Module[{sol,d,rho,eta,off,v,ps,aa,h,int,logM},sol=solveD46[b,N[c,wp],N[t,wp],wp];d=sol["d"];rho=d/c;eta=1-rho;off=rho t-b m46[d];v=N[Range[-cut/step,cut/step]step,wp];aa=Abs[eta]/rho;
 ps=Exp[b(-Log[1-I v/Sqrt[b]]+Log[(1+Exp[-d+I d v/Sqrt[b]])/(1+Exp[-d])])-I m46[d]v Sqrt[b]-I v off/Sqrt[b]];
 h=1/(aa+If[upperQ,I,-I]v/Sqrt[b]);int=step Re[Total[ps h]]/(2Pi Sqrt[b]);logM=Log[c/d]+Log[1+Exp[-d]]-Log[1+Exp[-c]];
 <|"log_probability"->b logM-eta t+Log[int],"root_valid"->sol["valid"],"relative_root_residual"->ToString[sol["relative_bracket_residual"],InputForm]|>];
runQ46[n_,BB_,constantTube_:False]:=Module[{wp=Max[100,2IntegerLength[n,10]+80],mu,b=n/2,ll,zz,dd,tau,bb,r1,r2,q1,q2,logp,ww,ks,direct1,direct2,check,start=AbsoluteTime[]},
 mu=N[1+ProductLog[1/E],wp+80];ll=N[Log[n],wp+20];zz=z/.FindRoot[Erfc[z/Sqrt[2]]/2==Sqrt[mu/n]z,{z,Sqrt[ll]},WorkingPrecision->wp+20,AccuracyGoal->wp-20,PrecisionGoal->wp-20];dd=Sqrt[mu n]zz;tau=n mu-dd;bb=If[constantTube,BB/Sqrt[ll],BB];r1=b mu+bb Sqrt[b ll];r2=tau-r1;If[!TrueQ[r2>0],Return[<|"N_exact"->ToString[n,InputForm],"B"->N[BB],"status"->"skipped: second threshold not positive"|>]];
 q1=logTailQ46[b,mu,r1,True,wp];q2=logTailQ46[b,mu,r2,False,wp];logp=q1["log_probability"]+Log[1-Exp[q2["log_probability"]]];
 check=If[n==256,ks=Range[0,b];ww=N[Binomial[b,#]&/@ks,wp]Exp[-mu ks]/(1+Exp[-mu])^b;direct1=Dot[ww,GammaRegularized[b,Clip[r1-mu ks,{0,Infinity}]]];direct2=Dot[ww,GammaRegularized[b,0,Clip[r2-mu ks,{0,Infinity}]]];ToString[Exp[logp]-direct1(1-direct2),InputForm],Null];
 <|"N_exact"->ToString[n,InputForm],"B"->N[BB],"constant_width_tube"->constantTube,"r1"->N[r1,23],"r2"->N[r2,23],"normalized_actual_Orlicz_budget"->1,"probability"->N[Exp[logp],23],"negative_log_probability_over_logN"->N[-logp/ll,23],"predicted_exponent"->If[constantTube,0,N[BB^2/(2mu),23]],"constant_tube_Gaussian_limit"->If[constantTube,N[Erfc[BB/Sqrt[2mu]]/2,23],Null],"root_valid"->TrueQ[q1["root_valid"]&&q2["root_valid"]],"independent_mixture_probability_difference"->check,"working_precision"->wp,"status"->"completed; floating Fourier tails, not interval certificate","seconds"->N[AbsoluteTime[]-start]|>];
If[!TrueQ[$quadrant46LibraryMode],argsQ46=$ScriptCommandLine;outQ46=If[Length[argsQ46]>=2,argsQ46[[2]],"/tmp/quadrant46.json"];rowsQ46={};Do[row=runQ46[n,BB];AppendTo[rowsQ46,row];Print[KeyTake[row,{"N_exact","B","negative_log_probability_over_logN","root_valid","seconds"}]],{n,Join[{256,4096,65536},2^{32,64,128}]},{BB,{1/2,1,2}}];
 ctQ46=Table[runQ46[n,2,True],{n,{65536,2^32,2^128}}];Export[outQ46,<|"wolfram"->$Version,"status"->"actual-budget quadrant profiles and stable exact-law Fourier tail diagnostics","rows"->rowsQ46,"constant_tube_rows"->ctQ46|>,"RawJSON"];];
