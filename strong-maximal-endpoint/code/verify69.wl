args69=Rest[$ScriptCommandLine];If[Length[args69]<2,Print["Need candidate JSON and output directory"];Exit[2]];data69=Import[args69[[1]],"RawJSON"];out69=args69[[2]];If[!DirectoryQ[out69],CreateDirectory[out69,CreateIntermediateDirectories->True]];
ClearAll[setup69,logr69,pdf69,cdf69,inv69,verify69];
setup69[n_,wp_,act_]:=setup69[n,wp,act]=Module[{c,k,mu},mu=x/.FindRoot[x==1+Exp[-x],{x,N[5/4,wp]},WorkingPrecision->wp];c=If[act==="mu",mu,mu-Sqrt[mu]/2 Sqrt[Log[n]/n]];k=Range[0,n];<|"mu"->mu,"n"->n,"wp"->wp,"c"->c,"k"->k,"bc"->N[Log[Binomial[n,k]],wp],"constant"->n Log[1+Exp[-c]]+LogGamma[N[n,wp]],"weights"->N[Binomial[n,k],wp]Exp[-c k]/(1+Exp[-c])^n|>];
logr69[s_?NumericQ,p_]:=Module[{g=s-p["c"]p["k"],ids,v,m},ids=Flatten[Position[g,x_/;x>0]];v=p["bc"][[ids]]+(p["n"]-1)Log[g[[ids]]];m=Max[v];m+Log[Total[Exp[v-m]]]-p["constant"]];
pdf69[s_?NumericQ,p_]:=Exp[logr69[s,p]-s];
cdf69[s_?NumericQ,p_,upper_:False]:=Module[{g=Map[Max[#,0]&,s-p["c"]p["k"]],nn=N[p["n"],p["wp"]]},p["weights"].(If[upper,GammaRegularized[nn,#],GammaRegularized[nn,0,#]]&/@g)];
inv69[t_?NumericQ,n_,wp_]:=Module[{y,dy,r,j=0,cap=Log[2]},If[t<=Log[n],Return[N[1,wp]]];If[t>=(n-2)Log[1+cap]+Log[n+cap],Return[N[2,wp]]];y=Min[cap,Exp[(t-Log[n])/(n-1)]-1];While[j<40,r=(n-2)Log[1+y]+Log[n+y]-t;If[Abs[r]<10^(-wp+12),Break[]];dy=r/((n-2)/(1+y)+1/(n+y));y=Min[cap,Max[0,y-dy]];j++];Exp[y]];
verify69[sp_]:=Module[{row=sp[[1]],wp=sp[[2]],n,p,a,K,L,z,q0,hole,la,soft,cap,regions,integ,missing,excess,plateau,ratio,softcost,capcost,scaled,score,meanres},n=row["N"];p=setup69[n,wp+40,Lookup[row,"action","mu"]];a=N[Rationalize[row["cutoff"],0],wp+40];K=row["K"];L=Log[n];z=x/.FindRoot[Erfc[x/Sqrt[2]]/2==Sqrt[p["mu"]/n]x,{x,N[Sqrt[L],wp+20]},WorkingPrecision->wp+20];q0=n p["mu"]-Sqrt[n p["mu"]]z;hole=If[K===Null,None,{q0-Rationalize[K,0]L,q0+Rationalize[K,0]L}];la=logr69[a,p];soft=x/.FindRoot[logr69[x,p]-la==Log[n],{x,N[Rationalize[row["soft_start"],0],wp+20]},WorkingPrecision->wp+10];cap=x/.FindRoot[logr69[x,p]-la==(n-2)Log[1+Log[2]]+Log[n+Log[2]],{x,N[a+n/2,wp+20]},WorkingPrecision->wp+10];
regions[lo_,hi_]:=If[hi<=lo,{},If[hole===None,{{lo,hi}},Select[{{lo,Min[hi,hole[[1]]]},{Max[lo,hole[[2]]],hi}},#[[2]]>#[[1]]&]]];
integ[fun_,lo_,hi_]:=Total[Map[Function[ab,NIntegrate[fun[t],{t,ab[[1]],ab[[2]]},WorkingPrecision->wp,AccuracyGoal->Floor[wp/3],PrecisionGoal->Floor[wp/3],MaxRecursion->12]],regions[lo,hi]]];
missing=cdf69[a,p];If[hole=!=None&&hole[[2]]>Max[a,hole[[1]]],missing+=cdf69[hole[[2]],p]-cdf69[Max[a,hole[[1]]],p]];
excess=integ[Function[t,pdf69[t,p](inv69[logr69[t,p]-la,n,wp]-1)],soft,cap]+cdf69[cap,p,True];meanres=excess-missing;
plateau=Total[(Exp[a-#[[1]]]-Exp[a-#[[2]]])&/@regions[a,soft]];
ratio[t_?NumericQ]:=Module[{h=inv69[logr69[t,p]-la,n,wp],y},y=Log[h];pdf69[t,p]h(1+y)/(n+y)];softcost=Exp[a-la]integ[ratio,soft,cap];capcost=Exp[a-cap+Log[2]+(n-1)Log[1+Log[2]]];If[hole=!=None&&hole[[2]]>cap,capcost-=Exp[a-Max[cap,hole[[1]]]+Log[2]+(n-1)Log[1+Log[2]]](1-Exp[Max[cap,hole[[1]]]-hole[[2]]])];scaled=plateau+softcost+capcost;score=a-Log[scaled];
<|"N"->n,"K"->K,"action"->Lookup[row,"action","mu"],"working_precision"->wp,"candidate_parameter_scope"->"exact rationalization of the original binary-double cutoff; not a new high-precision optimizer","mean_residual"->ToString[N[meanres,25],InputForm],"log_score"->ToString[N[score,35],InputForm],"Python_log_score_difference"->ToString[N[Abs[score-Rationalize[row["log_score"],0]],25],InputForm],"scaled_cost"->ToString[N[scaled,35],InputForm],"normal_root_residual"->ToString[N[Abs[Erfc[z/Sqrt[2]]/2-Sqrt[p["mu"]/n]z],20],InputForm],"numeric"->TrueQ[NumberQ[score]&&Abs[meanres]<10^-8&&Abs[score-Rationalize[row["log_score"],0]]<10^-6]|>];
spec69=Flatten[Table[{row,wp},{row,Select[data69["rows"],MemberQ[{64,128,256},#["N"]]&&MemberQ[{Null,1},#["K"]]&&Lookup[#,"refinement",1]==1&]},{wp,{50,100}}],1];LaunchKernels[12];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[setup69,logr69,pdf69,cdf69,inv69,verify69];start69=AbsoluteTime[];rows69=ParallelMap[verify69,spec69,Method->"FinestGrained"];CloseKernels[];Export[FileNameJoin[{out69,"verify69.json"}],<|"candidate_file_SHA256"->FileHash[args69[[1]],"SHA256","HexString"],"version"->$Version,"workers"->12,"seconds"->N[AbsoluteTime[]-start69],"rows"->rows69|>,"RawJSON"];If[!AllTrue[rows69,TrueQ[#["numeric"]]&],Print["FAILED verify69"];Exit[3]];Print["PASS ",Length[rows69]," independent KKT checks"];
