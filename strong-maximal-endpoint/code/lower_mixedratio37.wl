(* r037: two-template receiver/source ratio mixture, direct finite-cone probe. *)
root=DirectoryName[$InputFileName];args=$ScriptCommandLine;repo=DirectoryName[root];seedFile=If[Length[args]>=3,args[[3]],FileNameJoin[{repo,"rounds","r030","receiver_seed.json"}]];out=If[Length[args]>=2,args[[2]],FileNameJoin[{$TemporaryDirectory,"lower_mixedratio37.json"}]];
$r032LibraryMode=True;Block[{$ScriptCommandLine={"lower_mixedratio37.wl",seedFile}},Get[FileNameJoin[{repo,"code","receiver_continuous32.wl"}]]];$r032LibraryMode=False;
srcScale=1.0276924765700282;cLow=c;cHigh=c+.25;u=Join[{{0.,0.}},Transpose[{Rest[dd]+Rest[vv],Rest[dd]-Rest[vv]}],Transpose[{Rest[dd]-Rest[vv],Rest[dd]+Rest[vv]}]];lo=Min[u];hi=Max[u]+b mz+16.Sqrt[b vz];
pts[j_]:=If[j==1,{u[[1]]},{u[[j]],u[[j+ng-1]]}];
(* Coefficients retain both source-template densities at each of the 65 points. *)
mixAmp[t1_,cs_]:=Module[{aa=ConstantArray[0.,2ng-1],z},Do[Do[aa[[If[j==1,1,If[z===pts[j][[1]],j,j+ng-1]]]]=srcScale w0[[j]] polyC[t1-z[[1]],cs[[j]]]Exp[z[[1]]+z[[2]]-tau],{z,pts[j]}],{j,ng}];aa];
likeM[t2_,aa_,cs_]:=Module[{s=0.,j},s+=aa[[1]]polyC[t2-u[[1,2]],cs[[1]]];Do[s+=aa[[j]]polyC[t2-u[[j,2]],cs[[j]]]+aa[[j+ng-1]]polyC[t2-u[[j+ng-1,2]],cs[[j]]],{j,2,ng}];s];
bd[lev_,aa_,cs_]:=Module[{l=lo,r=hi,m},If[likeM[l,aa,cs]>=lev,Return[l]];If[likeM[r,aa,cs]<=lev,Return[r]];Do[m=(l+r)/2.;If[likeM[m,aa,cs]<lev,l=m,r=m],{45}];(l+r)/2.];
pv[t1_,t2_,cs_]:=Module[{ans=ConstantArray[0.,ng],z,q1,q2},Do[Do[q1=polyC[t1-z[[1]],cs[[j]]];q2=polyC[t2-z[[2]],cs[[j]]];ans[[j]]+=q1 q2 Exp[z[[1]]+z[[2]]-t1-t2],{z,pts[j]}],{j,ng}];ans];
cp[t1_,l_,r_,h_,cs_]:=Module[{cost=0.,av=ConstantArray[0.,ng],z,fac},If[r<=l,Return[{cost,av}]];cost=Exp[tau-t1](Exp[-l]-Exp[-r])phi[h];Do[Do[fac=polyC[t1-z[[1]],cs[[j]]]Exp[z[[1]]-t1];av[[j]]+=fac(gbcdfC[r-z[[2]],cs[[j]]]-gbcdfC[l-z[[2]],cs[[j]]]),{z,pts[j]}],{j,ng}];{cost,av}];
sp[t1_,l_,r_,aa_,cs_]:=Module[{x,wt,h,cost=0.,av=ConstantArray[0.,ng]},If[r<=l,Return[{cost,av}]];{x,wt}=quad[32,l,r];Do[h=profile[likeM[x[[i]],aa,cs]];cost+=wt[[i]]Exp[tau-t1-x[[i]]]phi[h];av+=wt[[i]]h pv[t1,x[[i]],cs],{i,Length[x]}];{cost,av}];
cv[uu_]:=Module[{s=SortBy[uu,First],xx,best,tot=0.,i},xx=DeleteDuplicates[s[[All,1]]];Do[best=Min[Select[s,#[[1]]<=xx[[i]]&][[All,2]]];tot+=(Exp[-xx[[i]]]-If[i<Length[xx],Exp[-xx[[i+1]]],0.])Exp[-best],{i,Length[xx]}];tot];
run[name_,cs_]:=Module[{tx,tw,aa,roots,z,a,cost=0.,av=ConstantArray[0.,ng],ids,an,vol},{tx,tw}=outerQuad[128];Do[aa=mixAmp[tx[[i]],cs];roots=bd[#,aa,cs]&/@{1.,N[n],phiPrime};{z,a}=cp[tx[[i]],roots[[1]],roots[[2]],1.,cs];cost+=tw[[i]]z;av+=tw[[i]]a;{z,a}=cp[tx[[i]],roots[[3]],hi,cap,cs];cost+=tw[[i]]z;av+=tw[[i]]cap a;{z,a}=sp[tx[[i]],roots[[2]],roots[[3]],aa,cs];cost+=tw[[i]]z;av+=tw[[i]]a,{i,Length[tx]}];ids=Flatten@Position[av/coeff,_?(#>1.00001&)];an=Flatten[Table[pts[j],{j,ids}],1];vol=If[Length[an]>0,cv[an],0.];<|"name"->name,"high_template_groups"->Flatten@Position[cs,cHigh],"scaled_cost"->cost,"actual_logJ"->Log[cost]-tau,"min_average"->Min[av/coeff],"accepted_groups_margin_1e5"->ids,"accepted_cone_volume"->vol,"accepted_cone_log_score"->If[vol>0,Log[vol]-(Log[cost]-tau),-Infinity]|>];
outer={19,20,21,33};inner={5,6,7,8,9,10,11};base=ConstantArray[cLow,ng];cOuter=ReplacePart[base,Thread[outer->cHigh]];cInner=ReplacePart[base,Thread[inner->cHigh]];
q=vv/16.;cQuadratic=cLow+.25q^2;cReverse=cLow+.25(1.-q^2);
rows={run["uniform_low",base],run["outer_high_template",cOuter],run["inner_high_template",cInner],run["quadratic_33_template",cQuadratic],run["reverse_quadratic_33_template",cReverse]};res=<|"status"->"r037 two-template mixed-c source/receiver probe; floating direct quadrature only","n"->n,"c_low"->cLow,"c_high"->cHigh,"source_scale"->srcScale,"rows_N128_soft32"->rows,"scalar_reference_log_score"->71.71499208794934,"interpretation"->"Each source likelihood is rebuilt from the same per-anchor c_j mixture used in receiver averages; accepted cones use avg>1+1e-5 and remain numerical lower-witness candidates even when not all anchors pass. No fixed-c obstruction is invoked for mixed rows."|>;Export[out,res,"RawJSON"];Print[rows];
