args=Rest[$ScriptCommandLine];If[Length[args]<2,Print["Need inputs.json output-directory"];Exit[2]];in68=Import[args[[1]],"RawJSON"];out=args[[2]];If[!DirectoryQ[out],CreateDirectory[out,CreateIntermediateDirectories->True]];
ClearAll[binom68,logQ68,rate68,run68];
binom68[b_,wp_]:=binom68[b,wp]=N[Log[Binomial[b,Range[0,b]]],wp];
logQ68[b_,s_,c_,wp_]:=Module[{k,g,t,m},k=Range[0,Min[b,Ceiling[s/c]-1]];g=s-c k;t=binom68[b,wp][[k+1]]+(b-1)Log[g];m=Max[t];m+Log[Total[Exp[t-m]]]];
rate68[b_,s_?NumericQ,c_,wp_]:=Module[{k,g,t,m,w},k=Range[0,Min[b,Ceiling[s/c]-1]];g=s-c k;t=binom68[b,wp][[k+1]]+(b-1)Log[g];m=Max[t];w=Exp[t-m];(b-1)Total[w/g]/Total[w]];
run68[sp_]:=Module[{b=sp[[1]],width=sp[[2]],wp=sp[[3]],mu,z,s0,s1,q0,q1,integ,points,res,rate,gam,meanres,mur,nr},mu=x/.FindRoot[x==1+Exp[-x],{x,N[5/4,wp]},WorkingPrecision->wp];z=x/.FindRoot[Erfc[x/Sqrt[2]]/2==Sqrt[mu/b]x,{x,N[Sqrt[Log[b]],wp]},WorkingPrecision->wp];mur=Abs[mu-1-Exp[-mu]];nr=Abs[Erfc[z/Sqrt[2]]/2-Sqrt[mu/b]z];q0=b mu-Sqrt[mu b]z;s0=q0-width Log[b]/2;s1=q0+width Log[b]/2;If[s0<=0,Return[<|"numeric"->False|>]];q1=logQ68[b,s1,mu,wp]-logQ68[b,s0,mu,wp];points=Select[mu Range[0,b],s0<#<s1&];integ=NIntegrate[rate68[b,t,mu,wp],Evaluate[Prepend[Append[points,s1],s0]//(Prepend[#,t]&)],WorkingPrecision->wp,AccuracyGoal->Floor[wp/2],PrecisionGoal->Floor[wp/2],MaxRecursion->12];rate=rate68[b,q0,mu,wp];gam=g/.FindRoot[q0/b==1/g+mu/(1+Exp[g mu]),{g,N[1,wp]},WorkingPrecision->wp];meanres=Abs[q0/b-1/gam-mu/(1+Exp[gam mu])];res=Abs[integ-q1];<|"mu_root_residual"->ToString[N[mur,20],InputForm],"normal_root_residual"->ToString[N[nr,20],InputForm],"root_tolerance"->ToString[10^(-Floor[wp/2]),InputForm],"b"->b,"width_over_log_b"->width,"precision"->wp,"s0"->ToString[N[s0,25],InputForm],"s1"->ToString[N[s1,25],InputForm],"envelope_mass"->ToString[N[1+q1,35],InputForm],"integral_residual"->ToString[N[res,20],InputForm],"central_rate"->ToString[N[rate,35],InputForm],"tilt_gamma"->ToString[N[gam,35],InputForm],"b_rate_minus_gamma"->ToString[N[b(rate-gam),25],InputForm],"mean_residual"->ToString[N[meanres,20],InputForm],"numeric"->TrueQ[NumberQ[q1]&&NumberQ[integ]&&res<10^(-Floor[wp/3])&&meanres<10^(-Floor[wp/2])&&mur<10^(-Floor[wp/2])&&nr<10^(-Floor[wp/2])]|>];
specs=({#["b"],#["width"],#["precision"]}&/@in68["cases"]);LaunchKernels[12];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[binom68,logQ68,rate68,run68];start=AbsoluteTime[];rows=ParallelMap[run68,specs,Method->"FinestGrained"];CloseKernels[];Export[FileNameJoin[{out,"envelope68.json"}],<|"version"->$Version,"workers"->12,"seconds"->N[AbsoluteTime[]-start],"rows"->rows|>,"RawJSON"];If[!AllTrue[rows,TrueQ[#["numeric"]]&],Print["FAILED numeric checks"];Exit[3]];Print["PASS ",Length[rows]," cases"];
