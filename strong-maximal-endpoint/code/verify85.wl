a85=Rest[$ScriptCommandLine];in85=a85[[1]];out85=a85[[2]];If[!DirectoryQ[out85],CreateDirectory[out85,CreateIntermediateDirectories->True]];
ClearAll[rat85,xp85,run85];rat85[s_String]:=If[StringMatchQ[s,RegularExpression["-?[0-9]+(/[0-9]+)?"]],ToExpression[s,InputForm],Throw["bad rational"]];
xp85[x_]:=Module[{b=0,t=x,lo=1,hi,term=1,nxt,ff},ff[v_]:=Floor[10^80 v]/10^80;While[t>1/2,t=t/2;b++];Do[term=term*t/k;lo+=term,{k,1,80}];nxt=term*t/81;hi=lo+nxt/(1-t/82);{lo,hi}={ff[lo],-ff[-hi]};Do[{lo,hi}={ff[lo^2],-ff[-hi^2]},{b}];{lo,hi}];
mg85=(1+r^(1-b))/((1+r)(1-b));mm85=1-r Log[r]/(1+r);hh85=-r/(1+r)Log[r/(1+r)]-1/(1+r)Log[1/(1+r)];
sym85=<|"increment_mgf_integral"->TrueQ[FullSimplify[Integrate[(1+Boole[z>=-Log[r]])Exp[-(1-b)z]/(1+r),{z,0,Infinity},Assumptions->0<r<1&&0<b<1]==mg85,Assumptions->0<r<1&&0<b<1]],"increment_mean"->TrueQ[FullSimplify[(D[mg85,b]/.b->0)==mm85,Assumptions->0<r<1]],"mean_derivative"->TrueQ[FullSimplify[D[mm85,r]==(-Log[r]-1-r)/(1+r)^2,Assumptions->0<r<1]],"entropy_formula"->TrueQ[FullSimplify[hh85==Log[1+r]-r Log[r]/(1+r),Assumptions->0<r<1]],"critical_entropy_identity"->TrueQ[FullSimplify[(Log[1+r]-r lr/(1+r)/.{r->u-1,lr->-u})==Log[u]+u-1,Assumptions->u>1]],"uniform_second_exponential_moment"->TrueQ[FullSimplify[Integrate[2z^2 Exp[-(1-b)z],{z,0,Infinity},Assumptions->0<b<1]==4/(1-b)^3,Assumptions->0<b<1]],"pattern_probability_identity"->TrueQ[FullSimplify[-k Log[p]-(n-k)Log[1-p]==n(-p Log[p]-(1-p)Log[1-p])+(k-n p)Log[(1-p)/p],Assumptions->n>0&&0<p<1&&k>=0]],"binomial_adjacent_ratio"->TrueQ[FullSimplify[Binomial[n,k-1]/Binomial[n,k]==k/(n-k+1),Assumptions->Element[{n,k},Integers]&&0<k<=n]],"uniform_tail_rational_margin"->TrueQ[(1/100)(1/20)-2(1/100)^2/(1-1/100)^3>1/4000]|>;
s85=Import[FileNameJoin[{in85,"certificates85.json"}],"RawJSON"];mi85=rat85/@s85["constants"]["mu_interval"];mucheck85=TrueQ[mi85[[1]]-1-1/xp85[mi85[[1]]][[2]]<0&&mi85[[2]]-1-1/xp85[mi85[[2]]][[1]]>0];
run85[z_]:=Module[{n=z["N"],k=z["k"],bb,bits,lead,lb,rr={},wp,mu,cc,rn,pn,en,lv,uv,iv,riv,pii,pass},bb=Binomial[n,k];bits=IntegerLength[bb,2];lead=If[bits-1>=128,BitShiftRight[bb,bits-1-128],bb];iv=rat85/@z["log_binomial_interval"];riv=rat85/@z["r_interval"];pii=rat85/@z["p_interval"];Do[mu=u/.FindRoot[u-1-Exp[-u]==0,{u,N[128/100,wp]},WorkingPrecision->wp,AccuracyGoal->wp-10,PrecisionGoal->wp-10];cc=mu-Sqrt[mu Log[n]/n]/2;rn=Exp[-cc];pn=rn/(1+rn);en=-pn Log[pn]-(1-pn)Log[1-pn];lv=LogGamma[N[n+1,wp]]-LogGamma[N[k+1,wp]]-LogGamma[N[n-k+1,wp]];uv=lv+Log[(n-k+1)/(n-2k+1)];AppendTo[rr,<|"working_precision"->wp,"c"->ToString[N[cc,65],InputForm],"r"->ToString[N[rn,65],InputForm],"p"->ToString[N[pn,65],InputForm],"entropy"->ToString[N[en,65],InputForm],"log_binomial"->ToString[N[lv,65],InputForm],"log_sphere_upper"->ToString[N[uv,65],InputForm],"entropy_limit"->ToString[N[Log[mu]+mu-1,65],InputForm],"canonical_lost_mean_upper"->ToString[N[2/n^8,65],InputForm]|>],{wp,{80,160}}];pass=TrueQ[iv[[1]]<lv<iv[[2]]&&riv[[1]]<rn<riv[[2]]&&pii[[1]]<pn<pii[[2]]&&k>=n pn+2Sqrt[n Log[n]]&&2/n^8<1/n^2&&bits==z["binomial_integer"]["bits"]&&ToString[lead,InputForm]==z["binomial_integer"]["leading128_lower_integer"]];<|"N"->n,"k"->k,"kernel_id"->$KernelID,"exact_integer_and_interval_checks"->pass,"rows"->rr|>];
LaunchKernels[12];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[run85,rat85];tt85=AbsoluteTime[];r85=ParallelMap[TimeConstrained[run85[#],120,"TIMEOUT"]&,s85["rows"],Method->"FinestGrained"];CloseKernels[];
pass85=And@@Values[sym85]&&mucheck85&&AllTrue[r85,AssociationQ[#]&&TrueQ[#["exact_integer_and_interval_checks"]]&];Export[FileNameJoin[{out85,"verification85.json"}],<|"version"->$Version,"configured_workers"->12,"kernels_closed"->True,"seconds"->N[AbsoluteTime[]-tt85],"pass"->TrueQ[pass85],"symbolic"->sym85,"exact_root_bracket"->mucheck85,"rows"->r85|>,"RawJSON"];Print[If[TrueQ[pass85],"PASS ","FAIL "],Length[r85]," entropy/Hamming cases"];If[!TrueQ[pass85],Print[sym85];Exit[3]];
