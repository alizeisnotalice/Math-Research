(* Actual Phi_N capped budget, one receiver, two Gamma--Bernoulli blocks.
   Tested scope: even 8<=N<=522, cap=2. Machine quadrature; log terms
   below -700 are set to zero. All Hessians freeze the finite square. The unused first jet slot is zero;
   all likelihood comparisons use the fifth (log R) slot. *)
(* Self-contained; no Notebook or command-line library state. *)
expSafe52[x_?NumericQ]:=If[x< -700.,0.,Exp[x]];
jetBuild52[bb_Integer,cc_Real]:=jetBuild52[bb,cc]=With[{m=bb-1,nb=bb+1,bc=bb,cv=cc,pp=1./(1.+Exp[cc]),lb=Developer`ToPackedArray[Log[N[Binomial[bb,#]&/@Range[0,bb]]]],lnorm=N[N[(bb-1)Log[bb]-LogGamma[bb]-bb Log[1+Exp[-Rationalize[cc,0]]],80],MachinePrecision]},Compile[{{tt,_Real}},Module[{s=0.,sk=0.,sk2=0.,st=0.,y=0.,ly=0.,zz=0.,tm=0.,i=0,kv=0.,lr=0.,r=0.,sc=0.,sec=0.,kt=0.},If[tt<=0.,Return[{0.,0.,0.,0.,-1.*^300}]];For[i=1,i<=nb,i++,y=(tt-cv(i-1))/tt;If[y>0.,ly=Log[y];kv=i-1.;zz=lb[[i]]+m ly;If[zz> -700.,s+=Exp[zz]];zz=lb[[i]]+(m-1)ly;tm=If[zz> -700.,Exp[zz],0.];st+=tm;sk+=kv tm;zz=lb[[i]]+(m-2)ly;If[zz> -700.,sk2+=kv^2 Exp[zz]]]];lr=lnorm+m Log[tt/bc]+Log[s];r=0.;sc=bc pp-(m/tt)sk/s;sec=bc pp((bc+1)pp-1)-2bc pp(m/tt)sk/s+(m(m-1)/tt^2)sk2/s;kt=(m/tt)st/s;{r,sc,sec,kt,lr}],RuntimeOptions->"Speed"]];
weights52[bb_Integer,cc_Real]:=weights52[bb,cc]=N[(Binomial[bb,#]Exp[-Rationalize[cc,0] #]/(1+Exp[-Rationalize[cc,0]])^bb)&/@Range[0,bb],MachinePrecision];
ci52[bb_,cc_,l_,r_]:=If[r<=l,0.,Dot[weights52[bb,cc],GammaRegularized[bb,Clip[l-cc Range[0,bb],{0.,Infinity}],Clip[r-cc Range[0,bb],{0.,Infinity}]]]];
cdfJets52[bb_,cc_,l_,r_]:=Module[{p=1./(1+Exp[cc]),f,g,h,gd,jg=jetBuild52[bb-1,cc]},f=ci52[bb,cc,l,r];g=ci52[bb-1,cc,l-cc,r-cc];h=ci52[bb-2,cc,l-2cc,r-2cc];gd=expSafe52[jg[r-cc][[5]]-(r-cc)]-expSafe52[jg[l-cc][[5]]-(l-cc)];{f,bb p(f-g),bb p(((bb+1)p-1)f-(2bb p-1)g+(bb-1)p h+gd)}];
profile52[a_,nn_,cap_]:=Module[{y,d},If[a<=nn,Return[1.]];d=Log[a];y=Max[Exp[(d-Log[nn])/(nn-1)]-1,0.];Do[y=Max[0.,y-((nn-2)Log[1+y]+Log[nn+y]-d)/((nn-2)/(1+y)+1/(nn+y))],{10}];Min[Exp[y],cap]];
context52[nn_,c1_,c2_,no_,ord_,fixedHi_:Automatic]:=Module[{mu=N[1+ProductLog[1/E]],zz,q,j1,j2,hi,edges,xx={},ww={},rr,tc,pp1,pp2,v1,v2},zz=z/.FindRoot[Erfc[z/Sqrt[2]]/2==Sqrt[mu/nn]z,{z,Sqrt[Log[nn]]}];q=nn mu-Sqrt[mu nn]zz;j1=jetBuild52[nn/2,N[c1]];j2=jetBuild52[nn/2,N[c2]];pp1=1/(1+Exp[c1]);pp2=1/(1+Exp[c2]);v1=1+c1^2 pp1(1-pp1);v2=1+c2^2 pp2(1-pp2);hi=Max[(nn/2)(1+c1 pp1)+16Sqrt[(nn/2)v1],(nn/2)(1+c2 pp2)+16Sqrt[(nn/2)v2]];
 If[NumericQ[fixedHi],hi=N[fixedHi]];edges=Subdivide[0.,hi,Ceiling[no/16.]];rr=GL52[16];Do[xx=Join[xx,(edges[[i]]+edges[[i+1]])/2+(edges[[i+1]]-edges[[i]])rr[[1]]/2];ww=Join[ww,(edges[[i+1]]-edges[[i]])rr[[2]]/2],{i,Length[edges]-1}];
 <|"n"->nn,"b"->nn/2,"c1"->N[c1],"c2"->N[c2],"j1"->j1,"j2"->j2,"hi"->hi,"tau"->(j1[q/2][[5]]+j2[q/2][[5]]),"x"->xx,"w"->ww,"inner_rule"->GL52[ord],"cap"->2.,"aCap"->(1+Log[2.])^(nn-2)(nn+Log[2.]),"phiCap"->2.(1+Log[2.])^(nn-1)|>];
GL52[k_]:=GL52[k]=Module[{a,ev,vec,ix},a=N[DiagonalMatrix[Range[k-1]/Sqrt[4Range[k-1]^2-1],1]+DiagonalMatrix[Range[k-1]/Sqrt[4Range[k-1]^2-1],-1]];{ev,vec}=Eigensystem[a];ix=Ordering[ev];{ev[[ix]],2vec[[ix,1]]^2}];
eval52[ctx_,ls_]:=Module[{nn=ctx["n"],bb=ctx["b"],c2=ctx["c2"],j1=ctx["j1"],j2=ctx["j2"],hi=ctx["hi"],tau=ctx["tau"],cap=ctx["cap"],asc=ctx["aCap"],phic=ctx["phiCap"],tx=ctx["x"],tw=ctx["w"],ir=ctx["inner_rule"],scale=Exp[ls],total=ConstantArray[0.,11],bounds,t1,p1,f1,amp,logAmp,l,r,mid,roots,seg,hh,cj,base,tmp,p2,fprob,aa,yy,fac,gp,gm,vals,xs,ws,t2,maxInv=0.,phiInv,bd,lsr,ms=0.,lowerTotal=ConstantArray[0.,5],lbv},
 Do[t1=tx[[i]];p1=j1[t1];f1=expSafe52[p1[[5]]-t1];logAmp=ls-tau+p1[[5]];amp=expSafe52[logAmp];
 bd[lev_]:=Module[{lo=0.,up=hi,md},If[logAmp+j2[hi][[5]]<Log[lev],Return[hi]];Do[md=(lo+up)/2.;If[logAmp+j2[md][[5]]<Log[lev],lo=md,up=md],{48}];(lo+up)/2.];roots=bd/@{1.,N[nn],asc};vals=ConstantArray[0.,11];lbv=ConstantArray[0.,5];
 Do[{l,r,hh}=seg;If[r>l,cj=cdfJets52[bb,c2,l,r];base=hh f1;vals[[1]]+=base cj[[1]];vals[[2]]+=base(p1[[2]]cj[[1]]+cj[[2]]);vals[[3]]+=base(p1[[2]]cj[[1]]-cj[[2]]);vals[[4]]+=base(p1[[3]]cj[[1]]+cj[[3]]+2p1[[2]]cj[[2]]);vals[[5]]+=base(p1[[3]]cj[[1]]+cj[[3]]-2p1[[2]]cj[[2]]);vals[[11]]+=expSafe52[tau-t1-l+If[hh==1.,0.,Log[phic]]](1-Exp[l-r])],{seg,{{roots[[1]],roots[[2]],1.},{roots[[3]],hi,cap}}}];
 If[roots[[1]]<hi-10^-10,p2=j2[roots[[1]]];If[p2[[4]]>0.,fprob=expSafe52[p1[[5]]+p2[[5]]-t1-roots[[1]]]/p2[[4]];gp=p1[[2]]+p2[[2]];gm=p1[[2]]-p2[[2]];lbv=fprob{1.,gp,gm,gp^2,gm^2};vals[[6;;10]]+=lbv]];
 l=roots[[2]];r=roots[[3]];If[r>l,xs=(r+l)/2+(r-l)ir[[1]]/2;ws=(r-l)ir[[2]]/2;
 Do[t2=xs[[j]];p2=j2[t2];aa=expSafe52[logAmp+p2[[5]]];hh=profile52[aa,nn,cap];yy=Log[hh];fprob=expSafe52[p1[[5]]+p2[[5]]-t1-t2];gp=p1[[2]]+p2[[2]];gm=p1[[2]]-p2[[2]];base=hh fprob;
 vals[[1;;5]]+=ws[[j]]base{1.,gp,gm,p1[[3]]+p2[[3]]+2p1[[2]]p2[[2]],p1[[3]]+p2[[3]]-2p1[[2]]p2[[2]]};
 fac=aa hh/((nn-1)(nn-1+yy)(1+yy)^(nn-3));vals[[6;;10]]+=ws[[j]]fprob fac{1.,gp,gm,gp^2,gm^2};vals[[11]]+=ws[[j]]expSafe52[tau-t1-t2+yy+(nn-1)Log[1+yy]];
 maxInv=Max[maxInv,Abs[(nn-2)Log[1+yy]+Log[nn+yy]-Log[aa]]],{j,Length[xs]}]];total+=tw[[i]]vals;lowerTotal+=tw[[i]]lbv,{i,Length[tx]}];
 AssociationThread[{"mean","Mplus","Mminus","Tplus","Tminus","B00","B0plus","B0minus","Bplus","Bminus","scaled_J"},total]~Join~<|"log_scale"->ls,"scale"->scale,"tau"->tau,"lower_response_components"->lowerTotal,"soft_response_components"->(total[[6;;10]]-lowerTotal),"inverse_derivative_log_residual"->maxInv|>];
solve52[nn_,c1_,c2_,no_:128,ord_:32,fixedHi_:Automatic]:=Module[{ctx=context52[nn,N[c1],N[c2],no,ord,fixedHi],ls=0.,rr,step,history={},it,dual,ratio,lp,cp,cm,rawm,rawb,start=AbsoluteTime[]},
 Do[rr=eval52[ctx,ls];AppendTo[history,{ls,rr["mean"],rr["B00"]}];If[Abs[rr["mean"]-1.]<5*10^-12,Break[]];If[rr["B00"]<=0.,Break[]];step=Clip[(1.-rr["mean"])/rr["B00"],{-1.5,1.5}];ls+=step,{it,14}];
 dual=rr["scaled_J"]+rr["scale"](1-rr["mean"]);ratio=rr["scale"]/dual;lp=Log[dual]-ctx["tau"];
 cp=ratio(-rr["Tplus"]-rr["Bplus"]+(rr["Mplus"]+rr["B0plus"])^2/rr["B00"])-(ratio rr["Mplus"])^2;
 cm=ratio(-rr["Tminus"]-rr["Bminus"]+(rr["Mminus"]+rr["B0minus"])^2/rr["B00"])-(ratio rr["Mminus"])^2;
 <|"n"->nn,"c1"->N[c1],"c2"->N[c2],"outer_nodes"->Length[ctx["x"]],"soft_order"->ord,"finite_window"->{0.,ctx["hi"]},"calibration_history"->history,"mean_residual"->rr["mean"]-1.,"mean_calibration_pass"->TrueQ[Abs[rr["mean"]-1]<10^-9],"log_budget_dual_corrected"->lp,"log_budget_direct"->Log[rr["scaled_J"]]-ctx["tau"],"lambda_over_P"->ratio,"common_log_budget_gradient"->-ratio rr["Mplus"],"common_log_budget_Hessian"->cp,"contrast_log_budget_Hessian"->cm,"contrast_kernel_term"->-ratio rr["Tminus"],"contrast_response_term"->-ratio rr["Bminus"],"contrast_Schur_term"->ratio(rr["Mminus"]+rr["B0minus"])^2/rr["B00"],"lower_contrast_response_term"->-ratio rr["lower_response_components"][[5]],"soft_contrast_response_term"->-ratio rr["soft_response_components"][[5]],"mean_tail_upper_formula"->2Total[Table[Dot[weights52[nn/2,cc],GammaRegularized[nn/2,Clip[ctx["hi"]-cc Range[0,nn/2],{0.,Infinity}]]],{cc,{N[c1],N[c2]}}]],"raw_integrals"->rr,"seconds"->N[AbsoluteTime[]-start],"scope"->"actual finite-window Gamma-Bernoulli KKT diagnostic, no interval certificate"|>];

crit52[n_]:=Module[{mu=N[1+ProductLog[1/E]],zz},zz=z/.FindRoot[Erfc[z/Sqrt[2]]/2==Sqrt[mu/n]z,{z,Sqrt[Log[n]]}];mu-Sqrt[mu/n]zz/2];
tuneFixed52[n_]:=Module[{cc=crit52[n],hi,rr,hist={},step},hi=context52[n,cc,cc,256,64]["hi"];Do[rr=solve52[n,cc,cc,256,64,hi];AppendTo[hist,KeyTake[rr,{"c1","common_log_budget_gradient","common_log_budget_Hessian","mean_residual","log_budget_dual_corrected"}]];If[Abs[rr["common_log_budget_gradient"]]<10^-8,Break[]];step=Clip[-rr["common_log_budget_gradient"]/rr["common_log_budget_Hessian"],{-.1,.1}];cc+=step,{6}];<|"n"->n,"critical_c"->crit52[n],"tuned_c"->rr["c1"],"stationarity_pass"->TrueQ[Abs[rr["common_log_budget_gradient"]]<10^-8],"fixed_window"->{0.,hi},"trace"->hist,"row"->rr|>];
If[!TrueQ[$primal52LibraryMode],out52=If[Length[$ScriptCommandLine]>=2,$ScriptCommandLine[[2]],"/tmp/primal52.json"];rows52={};Do[r52=tuneFixed52[n52];AppendTo[rows52,r52];Print[<|"n"->n52,"c"->r52["tuned_c"],"stationarity_pass"->r52["stationarity_pass"],"contrast"->r52["row"]["contrast_log_budget_Hessian"]|>];Export[out52,<|"wolfram"->$Version,"rows"->rows52,"scope"->"fixed-square machine KKT diagnostic; local common stationarity, no global optimum, interval certificate, or C_N improvement"|>,"RawJSON"],{n52,{16,32,64,128,256,512,1024}}]];
