$endpoint48LibraryMode=True;Get[FileNameJoin[{DirectoryName[$InputFileName],"endpoint48.wl"}]];$endpoint48LibraryMode=False;
rowsB48={};Do[Module[{row=case48[n,label],wp,c,q,pt,sharp,lo,up,bm1lo,bm1up,mass,delta,gg,ratio},wp=row["working_precision"];c=ToExpression[row["c_internal"]];q=ToExpression[row["q_internal"]];pt=point48[n,c,q,wp,1/16,32];sharp=2pt["f"]pt["score"]^2/pt["log_R_derivative"];
 Do[lo=Exp[logF47[n,c,q,wp]];up=Exp[logF47[n,c,q+ell,wp]];bm1lo=Exp[logF47[n-1,c,q-c,wp]];bm1up=Exp[logF47[n-1,c,q+ell-c,wp]];mass=up-lo;delta=mass-pt["f"](1-Exp[-ell]);gg=n p46[c](mass-bm1up+bm1lo);ratio=gg^2/(delta sharp);AppendTo[rowsB48,<|"N_exact"->ToString[n,InputForm],"label"->label,"physical_band_width"->ToString[ell,InputForm],"mass_over_fq_times_width"->N[mass/(pt["f"]ell),25],"normalized_cost_over_fq_width_squared_half"->N[2delta/(pt["f"]ell^2),25],"sensitivity_squared_over_cost_divided_by_sharp_limit"->N[ratio,25],"cost_positive"->TrueQ[delta>0],"working_precision"->wp|>],{ell,{1/4,1/16,1/64}}]],{n,{256,65536,2^48}},{label,{"mu","z"}}];
outB48=If[Length[$ScriptCommandLine]>=2,$ScriptCommandLine[[2]],"/tmp/bands48.json"];Export[outB48,<|"wolfram"->$Version,"rows"->rowsB48,"scope"->"finite one-sided deletion bands; exact-law Fourier floating checks, not interval certificate"|>,"RawJSON"];Print[rowsB48];
