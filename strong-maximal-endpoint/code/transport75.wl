args75=Rest[$ScriptCommandLine];out75=args75[[1]];If[!DirectoryQ[out75],CreateDirectory[out75,CreateIntermediateDirectories->True]];ClearAll[tr75,mat75];
tr75[j_]:=Module[{n=j["N"],wp=j["precision"],kind=j["kind"],q,mu,rho,cr,Cref,lm,lp,lo,hi,eps,rec,img,rr,points},mu=x/.FindRoot[x==1+Exp[-x],{x,N[5/4,wp+30]},WorkingPrecision->wp+30];rho=Sqrt[Log[n]/n];cr=mu-Sqrt[mu]rho/2;Cref=1+Exp[-cr];q=Switch[kind,"half",1/2,"sixteenth",1/16,"inverseN",1/n,"inverseN2",1/n^2,_,0];lm=Log[(1+Exp[-(cr-rho)])/Cref];lp=Log[(1+Exp[-(cr+rho)])/Cref];lo=-lm/(1-q);hi=-lp/(1-q);
 If[q>0,eps=q/n;rec=Sqrt[Pi/2]Exp[q^2/2](Erf[(n hi-q)/Sqrt[2]]-Erf[(n lo-q)/Sqrt[2]])/n;points=Sort[DeleteDuplicates[Join[{q lo,q hi},Select[{0,n eps^2,-8eps,8eps},q lo<#<q hi&]]]];img=Total[Table[NIntegrate[Exp[n v-v^2/(2eps^2)],{v,points[[k]],points[[k+1]]},WorkingPrecision->wp,AccuracyGoal->Floor[wp/3],PrecisionGoal->Floor[wp/3],MaxRecursion->12],{k,Length[points]-1}]],eps=1/(n 2^j["tube_power"]);rec=hi-lo;img=NIntegrate[Exp[n v-v^2/(2eps^2)],{v,-12eps,0,12eps},WorkingPrecision->wp,AccuracyGoal->Floor[wp/3],PrecisionGoal->Floor[wp/3],MaxRecursion->12]];
 rr=rec/img;<|"N"->n,"kind"->kind,"tube_power"->Lookup[j,"tube_power",Null],"precision"->wp,"receiver_weighted_integral"->ToString[N[rec,35],InputForm],"image_integral"->ToString[N[img,35],InputForm],"pushforward_ratio"->ToString[N[rr,35],InputForm],"numeric"->TrueQ[rec>0&&img>0&&If[q>0,Abs[q rr-1]<10^(-Floor[wp/4]),True]]|>];
mat75[j_]:=Module[{n=j["N"],q=Switch[j["kind"],"half",1/2,"sixteenth",1/16,"inverseN",1/j["N"],"inverseN2",1/j["N"]^2,_,0],x,B,v},x=Range[n];B=IdentityMatrix[n]-(1-q)Outer[Times,x,x]/Total[x^2];v=Det[B];Join[j,<|"determinant"->ToString[v,InputForm],"exact_pass"->TrueQ[v==q]|>]];
jobs75=Join[Flatten[Table[<|"N"->n,"kind"->k,"precision"->wp|>,{n,{2,4,8,16,32,64,128,256}},{k,{"half","sixteenth","inverseN","inverseN2"}},{wp,{50,100}}],2],Flatten[Table[<|"N"->n,"kind"->"collapse","tube_power"->t,"precision"->wp|>,{n,{2,4,8,16,32,64,128,256}},{t,{0,4,8,16}},{wp,{50,100}}],2]];mj75=Flatten[Table[<|"N"->n,"kind"->k|>,{n,{2,4,8,16,32,64}},{k,{"half","sixteenth","inverseN","inverseN2","collapse"}}],1];LaunchKernels[12];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[tr75,mat75];start75=AbsoluteTime[];rows75=ParallelMap[tr75,jobs75,Method->"FinestGrained"];mr75=ParallelMap[mat75,mj75,Method->"FinestGrained"];CloseKernels[];xx75=Array[xx,3];gg75=Array[gg,3];jac75=lam IdentityMatrix[3]+Outer[Times,xx75,gg75];sym75=Expand[Det[jac75]-lam^3-lam^2 xx75.gg75]===0;Export[FileNameJoin[{out75,"transport75.json"}],<|"version"->$Version,"workers"->12,"seconds"->N[AbsoluteTime[]-start75],"rows"->rows75,"matrices"->mr75,"symbolic_rank_one_identity"->sym75|>,"RawJSON"];If[!sym75||!AllTrue[rows75,TrueQ[#["numeric"]]&]||!AllTrue[mr75,TrueQ[#["exact_pass"]]&],Print["FAIL"];Exit[3]];Print["PASS ",Length[rows75]," transport integrals, ",Length[mr75]," rational determinants and symbolic Jacobian"];
