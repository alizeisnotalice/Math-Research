Clear[a,u,x,aa,bb,mm,tau];
halo=FullSimplify[1+4(a-1)+4Integrate[a/u-1,{u,1,a},Assumptions->a>1],Assumptions->a>1];
haloResidual=FullSimplify[halo-(1+4a Log[a]),Assumptions->a>1];
ratio=(Exp[-u]+4u)/(1+u);derivativeResidual=FullSimplify[D[ratio,u]-(4-(u+2)Exp[-u])/(1+u)^2];
moebiusResidual=FullSimplify[D[(aa*x+bb)/(mm*x+tau),x]-(aa*tau-bb*mm)/(mm*x+tau)^2];
cornerBoundary=FullSimplify[mm/((x-aa)(bb+mm/(tau*(x-aa))-bb))-tau];
costResidual=FullSimplify[4(1+Log[4])+15*16(1+Log[16])-(244+968Log[2])];
root=DirectoryName[DirectoryName[$InputFileName]];cert=Import[FileNameJoin[{root,"rounds","r023","certificate.json"}],"RawJSON"];
area=FromDigits[cert["area_lower_numerator"]]/FromDigits[cert["area_lower_denominator"]];
low=2Sum[(1/3)^(2k+1)/(2k+1),{k,0,63}];up=low+2*(1/3)^129/(129*(1-1/9));
candidate=area/(244+968up);baseline=(1/16+16up)/(1+4low);
Clear[e];kap=Integrate[(1-v)/(4-v),{v,0,1}];
vv=16+4e(1-e^2)(16-kap);jj=1+15(1+e)(1+Log[1+e]);rr=(1/(1+e)+4Log[1+e])/(1+Log[1+e]);
gamma=(6Log[4/3]-1)/8;nearResidual=FullSimplify[Coefficient[Normal@Series[vv/jj-rr,{e,0,1}],e,1]-gamma];
logbounds[a_]:=Module[{u=(a-1)/(a+1),ll},ll=2Sum[u^(2k+1)/(2k+1),{k,0,63}];{ll,ll+2u^129/(129(1-u^2))}];
{la,ua}=logbounds[101/100];{lb,ub}=logbounds[4/3];ee=1/100;
nearCandidate=(16+4ee(1-ee^2)(15+3lb))/(1+15(1+ee)(1+ua));nearBaseline=(100/101+4ua)/(1+la);
result=<|"wolfram_version"->$Version,"near_unit_first_variation_residual"->ToString[nearResidual,InputForm],"near_unit_gamma_50"->ToString[N[gamma,50],InputForm],"near_unit_exact_gap_positive"->TrueQ[nearCandidate>nearBaseline],"near_unit_ratio_lower_60"->ToString[N[nearCandidate,60],InputForm],"near_unit_baseline_upper_60"->ToString[N[nearBaseline,60],InputForm],"constant_rectangle_halo_residual"->ToString[haloResidual,InputForm],"ratio_derivative_residual"->ToString[derivativeResidual,InputForm],"Moebius_derivative_residual"->ToString[moebiusResidual,InputForm],"corner_average_boundary_residual"->ToString[cornerBoundary,InputForm],"actual_Orlicz_cost_residual"->ToString[costResidual,InputForm],"exact_rational_gap_positive"->TrueQ[candidate>baseline],"candidate_lower_60"->ToString[N[candidate,60],InputForm],"constant_rectangle_upper_60"->ToString[N[baseline,60],InputForm],"strict_gap_lower_60"->ToString[N[candidate-baseline,60],InputForm],"log2_80_inside_series_bounds"->TrueQ[N[low,80]<N[Log[2],80]<N[up,80]]|>;
Export[FileNameJoin[{root,"rounds","r023","symbolic_checks.json"}],result,"RawJSON"];
Print[ExportString[result,"RawJSON"]];
