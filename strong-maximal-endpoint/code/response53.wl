(* Exact corroboration for r053 full-response theorem. Fourier/tail arguments are in proof.md. *)
Clear[n,h,y,u,eps,x,k3,k4,z];
eBounds53[z_]:=Module[{m=24,s,last},If[!TrueQ[0<=z<2],Print["exp bound input outside [0,2)"];Exit[2]];s=Sum[z^j/Factorial[j],{j,0,m}];last=z^(m+1)/Factorial[m+1];{s,s+last/(1-z/(m+2))}];
checks53=<||>;gaps53=<||>;
gaps53["exp_27_over20_below4"]=4-eBounds53[27/20][[2]];
gaps53["mu_below13_over10"]=eBounds53[13/10][[1]]-10/3;
gaps53["Gamma_k0_exponent_above091"]=(6/5)eBounds53[129/100][[1]]-eBounds53[6/5][[2]]-1;
log2lo53=2Sum[(1/3)^(2j+1)/(2j+1),{j,0,2}];log11hi53=1/10-(1/10)^2/2+(1/10)^3/3;
gaps53["log2_above0693"]=log2lo53-693/1000;
gaps53["log11_below0096"]=96/1000-log11hi53;
gaps53["alpha_above043"]=1693/1096-eBounds53[43/100][[2]];
gaps53["tilted_variance_below3_over2"]=3/2-(100/99)^2-(27/20)^2/4;
gaps53["Chebyshev_two_block_failure_b40000_below005"]=1/20-1875/40000;
gaps53["Chernoff_exact_gap"]= (33/25)(1/100)-(13/10)(1/100)-(3/4)(1/100)^2;
KeyValueMap[(checks53[#1]=TrueQ[#2>0])&,gaps53];checks53["Chernoff_gap_is1_over8000"]=TrueQ[gaps53["Chernoff_exact_gap"]==1/8000];
phi53[h_]:=h(1+Log[h])^(n-1);
ratio53=h(1+Log[h])(n+Log[h])/((n-1)(n-1+Log[h]));
checks53["Phi_ratio_identity"]=TrueQ[FullSimplify[D[phi53[h],h]/D[phi53[h],{h,2}]-ratio53,Assumptions->h>1&&n>=8]===0];
checks53["soft_ratio_coarse_bound6_overN"]=TrueQ[FullSimplify[4(n+1)/(n-1)^2<=6/n,Assumptions->n>=8]];
first53=Coefficient[Normal@Series[Exp[-I x u eps-I k3 u^3 eps/6+k4 u^4 eps^2/24],{eps,0,1}],eps,1];
checks53["Fourier_first_correction_odd"]=TrueQ[FullSimplify[first53+(first53/.u->-u)]===0];
checks53["factorial_integral_slack_b40000"]=TrueQ[40000/100-16-1>0&&2^16>48000&&1/100-1/40000>0];
checks53["cap_level_threshold_N80000"]=TrueQ[(9/10)80000+(43/100)(80000-2)> (33/25)80000];
checks53["cap_probability_below1_over4"]=TrueQ[2^10>4];
Clear[bb,xx,tt,cc];
checks53["Gamma_first_moment_identity"]=TrueQ[FullSimplify[xx^bb Exp[-xx]/Gamma[bb]-bb xx^bb Exp[-xx]/Gamma[bb+1],Assumptions->bb>0&&xx>0]===0];
checks53["lower_level_unit_delta_Jacobian"]=TrueQ[(D[Exp[z]-1,z]/.z->0)==1];
poly53=tt^3+4(tt-cc)^3;
checks53["b4_polynomial_log_derivative_bound_identity"]=TrueQ[Together[D[poly53,tt]/poly53-3/tt-12cc(tt-cc)^2/(tt poly53)]===0];
checks53["Gamma_Fourier_tail_bound_constants"]=TrueQ[8<16&&1/16-1/8<0&&log2lo53>1/2];
If[!And@@Values[checks53],Print[checks53];Exit[2]];
mu53=z/.FindRoot[z==1+Exp[-z],{z,13/10},WorkingPrecision->80,AccuracyGoal->60,PrecisionGoal->60];
ans53=<|"wolfram"->$Version,"checks"->checks53,"all_pass"->True,"exact_rational_gaps"->Map[ToString[#,InputForm]&,gaps53],"constants_50digits"-><|"mu"->ToString[N[mu53,50],InputForm],"uniform_Gamma_k0_coefficient_at_c6_over5"->ToString[N[1+Log[6/5]-Log[1+Exp[-6/5]],50],InputForm],"alpha"->ToString[N[Log[(1+Log[2])/(1+Log[11/10])],50],InputForm]|>,"scope"->"exact finite rational checks; b>=40000 multiplier lemma for c in [6/5,27/20]; symbolic algebra only corroborates the separate full-domain Fourier/Fisher/coarea response proof"|>;
out53=If[Length[$ScriptCommandLine]>=2,$ScriptCommandLine[[2]],"/tmp/soft53.json"];Export[out53,ans53,"RawJSON"];Print[<|"all_pass"->True,"checks"->Length[checks53],"output"->out53|>];
