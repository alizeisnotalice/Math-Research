argsP73=Rest[$ScriptCommandLine];pp73=Import[argsP73[[1]],"RawJSON"];outP73=argsP73[[2]];If[!DirectoryQ[outP73],CreateDirectory[outP73,CreateIntermediateDirectories->True]];ClearAll[post73];post73[j_]:=Module[{n=j["N"],s=Rationalize[j["S"],0],cut=j["cut"],wp=j["precision"],tail},tail[c_]:=Module[{k,g,logs,w},k=Select[Range[0,n],s-c #>0&];g=s-c k;logs=N[Log[Binomial[n,k]]+(n-1)Log[g],wp+20];w=Exp[logs-Max[logs]];Total[Pick[w,Map[#>=cut&,k]]]/Total[w]];<|"N"->n,"D_type"->j["D_type"],"regime"->j["regime"],"precision"->wp,"actual_removed"->ToString[N[tail[Rationalize[j["c_actual"],0]],40],InputForm],"reference_removed"->ToString[N[tail[Rationalize[j["c_reference"],0]],40],InputForm]|>];jobsP73=Flatten[Table[Append[j,"precision"->wp],{j,Select[pp73["rows"],#["N"]<=256&]},{wp,{60,120}}],1];LaunchKernels[12];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[post73];startP73=AbsoluteTime[];rowsP73=ParallelMap[post73,jobsP73,Method->"FinestGrained"];CloseKernels[];Export[FileNameJoin[{outP73,"posterior73.json"}],<|"version"->$Version,"workers"->12,"seconds"->N[AbsoluteTime[]-startP73],"rows"->rowsP73,"candidate_SHA256"->FileHash[argsP73[[1]],"SHA256","HexString"]|>,"RawJSON"];Print["Computed ",Length[rowsP73]," full posterior tail checks"];
