$coarea49LibraryMode=True;Get[FileNameJoin[{DirectoryName[$InputFileName],"coarea49.wl"}]];$coarea49LibraryMode=False;
finite49[b_,c_,t_,wp_]:=Module[{ks=Range[0,b],pos,weights,sm,sd},pos=Clip[t-c ks,{0,Infinity}];weights=N[Binomial[b,#]&/@ks,wp];sm=Dot[weights,pos^(b-1)];sd=(b-1)Dot[weights,pos^(b-2)];<|"logf"->-t+Log[sm]-LogGamma[b]-b Log[1+Exp[-c]],"score"->b p46[c]-(b-1)Dot[weights ks,pos^(b-2)]/sm,"k"->sd/sm|>];
context49[n_,wp_]:=Module[{mu,ll,z,c,q,lf0,lfn},mu=N[1+ProductLog[1/E],wp+60];ll=N[Log[n],wp+20];z=zz/.FindRoot[Erfc[zz/Sqrt[2]]/2==Sqrt[mu/n]zz,{zz,Sqrt[ll]},WorkingPrecision->wp+20,AccuracyGoal->wp-30,PrecisionGoal->wp-30];c=mu-Sqrt[mu/n]z/2;q=n mu-Sqrt[mu n]z;lf0=logD49[n/2,c,q/2,wp,1/16,32];lfn=logD49[n,c,q,wp,1/16,32];{mu,c,q,lf0,Sqrt[n mu]/2 Exp[2lf0-lfn]}];
ctx49=context49[256,120];{mu49,c49,q49,lf049,norm049}=ctx49;
small49=Table[Module[{r,dd,t1,t2,f0,f1,f2,pt1,pt2,diff},r=level49[256,c49,q49,mu49,N[v,120],120,1/16,32,lf049,norm049];dd=Sqrt[256mu49]v;t1=(q49+r["S_minus_q"]+dd)/2;t2=(q49+r["S_minus_q"]-dd)/2;f0=finite49[128,c49,q49/2,120];f1=finite49[128,c49,t1,120];f2=finite49[128,c49,t2,120];pt1=point48[128,c49,t1,120,1/16,32];pt2=point48[128,c49,t2,120,1/16,32];diff=Max[Abs[{r["S_minus_q"]+f1["logf"]+f2["logf"]-2f0["logf"],f1["score"]-pt1["score"],f2["score"]-pt2["score"],f1["k"]-pt1["log_R_derivative"],f2["k"]-pt2["log_R_derivative"]}]];<|"v"->v,"max_finite_formula_difference"->ToString[diff,InputForm],"less_than_1e-20"->TrueQ[diff<10^-20]|>],{v,{0,1,2,3}}];
curv49=Flatten[Table[Module[{ctx=context49[n,140],mu,c,q,t,b=n/2,sol,d,rho,off,vs,cf,g,g1,g2,cur},mu=ctx[[1]];c=ctx[[2]];q=ctx[[3]];t=q/2+Sqrt[n mu]v/2;sol=solveD46[b,c,t,140];d=sol["d"];rho=d/c;off=rho t-b m46[d];vs=N[Range[-512,512]/16,140];cf=Exp[b(-Log[1-I vs/Sqrt[b]]+Log[(1+Exp[-d+I d vs/Sqrt[b]])/(1+Exp[-d])])-I m46[d]vs Sqrt[b]-I vs off/Sqrt[b]];g=Re[Total[cf]];g1=Re[Total[-I vs/Sqrt[b]cf]];g2=Re[Total[-vs^2/b cf]];cur=rho^2(g2/g-(g1/g)^2);<|"N_exact"->ToString[n,InputForm],"v"->N[v,15],"minus_bmu_logR_second_derivative"->N[-b mu cur,25],"curvature_negative"->TrueQ[cur<0],"root_valid"->sol["valid"]|>],{n,{65536,2^48,2^96}},{v,{0,1,3}}],1];
ref49=Table[Module[{a=case49[n,16],b=case49[n,32,6,2,1/32,40],keys,diff},keys={"surface_mass_over_fNq","common_second_moment_over_fNq","contrast_second_moment_over_zN2_fNq"};diff=Max[Abs[Lookup[a,keys]-Lookup[b,keys]]];Print[<|"refined_N"->n,"maxdiff"->diff|>];<|"N_exact"->ToString[n,InputForm],"base_order"->16,"refined_order"->32,"maximum_mass_moment_difference"->ToString[diff,InputForm],"less_than_1e-9"->TrueQ[diff<10^-9],"all_roots_valid"->TrueQ[a["all_roots_valid"]&&b["all_roots_valid"]]|>],{n,{256,2^48,2^256}}];
gauss49=<|"common_second_over_p_squared"->Integrate[(v^2-2)^2 Exp[-v^2/2]/Sqrt[2Pi]/4,{v,-Infinity,Infinity}],"contrast_second_over_p_squared_z_squared"->Integrate[v^2 Exp[-v^2/2]/Sqrt[2Pi]/4,{v,-Infinity,Infinity}],"mixed_moment"->Integrate[(v^2-2)v Exp[-v^2/2],{v,-Infinity,Infinity}]|>;
res49=<|"wolfram"->$Version,"finite_formula_checks"->small49,"moderate_curvature_checks"->curv49,"quadrature_precision_fourier_refinements"->ref49,"exact_Gaussian_moments"->gauss49,"scope"->"independent finite kernel and floating refinement checks; Gaussian polynomial moments exact; no total interval certificate"|>;
outV49=If[Length[$ScriptCommandLine]>=2,$ScriptCommandLine[[2]],"/tmp/verify49.json"];Export[outV49,res49,"RawJSON"];Print[res49];
