args71=Rest[$ScriptCommandLine];If[Length[args71]<3,Print["Need inputs.json columns.json output-directory"];Exit[2]];in71=Import[args71[[1]],"RawJSON"];py71=Import[args71[[2]],"RawJSON"];out71=args71[[3]];If[!DirectoryQ[out71],CreateDirectory[out71,CreateIntermediateDirectories->True]];
ClearAll[cell71,column71,mode71];
cell71[j_]:=Module[{n=j["N"],d=j["d"],mm=j["M"],wp=j["precision"],mu,step,c,hh,ih,fn,v},mu=x/.FindRoot[x==1+Exp[-x],{x,N[5/4,wp+30]},WorkingPrecision->wp+30];step=mu/d;c=If[j["mode"]==="finite",mu,Infinity];hh[s_?NumericQ]:=If[c===Infinity,s^(n-1)/Factorial[n-1],Sum[Binomial[n,k]Max[s-c k,0]^(n-1),{k,0,n}]/Factorial[n-1]];ih[x_?NumericQ]:=Sum[(-1)^k Binomial[n,k]Max[x-k,0]^(n-1),{k,0,n}]/Factorial[n-1];fn[x_?NumericQ]:=If[x==0&&mm==0,step,step^n Exp[-step(mm+x)]ih[x]/hh[step(mm+x)]];v=Total[Table[NIntegrate[fn[x],{x,k,k+1},WorkingPrecision->wp,AccuracyGoal->Floor[wp/3],PrecisionGoal->Floor[wp/3],MaxRecursion->12],{k,0,n-1}]];<|"mu_root_residual"->ToString[N[Abs[mu-1-Exp[-mu]],20],InputForm],"N"->n,"d"->d,"M"->mm,"mode"->j["mode"],"precision"->wp,"probability"->ToString[N[v,35],InputForm],"numeric"->TrueQ[NumberQ[v]&&0<v<1&&Abs[mu-1-Exp[-mu]]<10^(-Floor[wp/2])]|>];

column71[j_]:=Module[{n=j["N"],reg=j["regime"],wp=j["precision"],c,z,s,k,g,ids,logs,w,rat,fun,T,points,value,B,gamma,meanerr},c=x/.FindRoot[x==1+Exp[-x],{x,N[5/4,wp+30]},WorkingPrecision->wp+30];z=x/.FindRoot[Erfc[x/Sqrt[2]]/2==Sqrt[c/n]x,{x,N[Sqrt[Log[n]],wp+20]},WorkingPrecision->wp+20];s=Switch[reg,"critical",n c-Sqrt[c n]z,"mean",n c,"far2",n^2 c,"far3",n^3 c];k=Range[0,n];g=s-c k;ids=Flatten[Position[g,x_/;x>0]];k=k[[ids]];g=g[[ids]];logs=N[Log[Binomial[n,k]],wp+20]+(n-1)Log[g];w=Exp[logs-Max[logs]];w=w/Total[w];rat[t_?NumericQ]:=Total[w(Map[Max[#,0]&,1-t/g])^(n-1)];fun[t_?NumericQ]:=Exp[-t]rat[t];T=Min[s,80];points=Sort[Select[g,0<#<T&]];value=NIntegrate[fun[t],Evaluate[Join[{t,0},points,{T}]],WorkingPrecision->wp,AccuracyGoal->Floor[wp/3],PrecisionGoal->Floor[wp/3],MaxRecursion->12];B=(n-1)Total[w/g];gamma=Null;meanerr=0;If[MemberQ[{"critical","mean"},reg],gamma=x/.FindRoot[1/x+c/(1+Exp[x c])==s/n,{x,N[1,wp+20]},WorkingPrecision->wp+10];meanerr=Abs[1/gamma+c/(1+Exp[gamma c])-s/n]];<|"N"->n,"regime"->reg,"precision"->wp,"D"->ToString[N[value,35],InputForm],"B_left_at_nodes"->ToString[N[B,35],InputForm],"gamma"->If[gamma===Null,Null,ToString[N[gamma,35],InputForm]],"critical_correction_scaled"->If[reg==="critical",ToString[N[(value-1/2+z/(4Sqrt[c n]))n/Log[n],30],InputForm],Null],"mean_root_residual"->ToString[N[meanerr,20],InputForm],"normal_root_residual"->ToString[N[Abs[Erfc[z/Sqrt[2]]/2-Sqrt[c/n]z],20],InputForm],"mu_root_residual"->ToString[N[Abs[c-1-Exp[-c]],20],InputForm],"integral_tail_bound"->If[T<s,ToString[N[Exp[-T],20],InputForm],"0"],"numeric"->TrueQ[NumberQ[value]&&0<value<1&&meanerr<10^(-Floor[wp/2])&&Abs[Erfc[z/Sqrt[2]]/2-Sqrt[c/n]z]<10^(-Floor[wp/2])]|>];
mode71[j_]:=Module[{n=j["N"],m=j["mode"],s=Rationalize[j["s"],0],c=Rationalize[py71["mu"],0],right,left,lr},lr[k_]:=Log[(n-k)/(k+1)]+(n-1)Log[(s-c(k+1))/(s-c k)];right=If[s-c(m+1)<=0,True,TrueQ[N[lr[m],100]<=0]];left=If[m==0,True,TrueQ[N[lr[m-1],100]>=0]];<|"N"->n,"regime"->j["regime"],"right_pass"->right,"left_pass"->left,"Python_rational_certificate"->j["mode_certified"]|>];
cols71=Flatten[Table[<|"N"->n,"regime"->reg,"precision"->wp|>,{n,{2,4,8,16,32,64,128,256}},{reg,{"critical","mean","far2","far3"}},{wp,{50,100}}],2];
LaunchKernels[12];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[cell71,column71,mode71,py71];start71=AbsoluteTime[];cr71=ParallelMap[cell71,in71["cells"],Method->"FinestGrained"];dr71=ParallelMap[column71,cols71,Method->"FinestGrained"];mr71=ParallelMap[mode71,Select[py71["rows"],#["refinement"]==1&],Method->"FinestGrained"];CloseKernels[];Export[FileNameJoin[{out71,"verify71.json"}],<|"version"->$Version,"workers"->12,"seconds"->N[AbsoluteTime[]-start71],"cells"->cr71,"columns"->dr71,"modes"->mr71,"candidate_file_SHA256"->FileHash[args71[[2]],"SHA256","HexString"]|>,"RawJSON"];If[!AllTrue[Join[cr71,dr71],TrueQ[#["numeric"]]&]||!AllTrue[mr71,TrueQ[#["right_pass"]]&&TrueQ[#["left_pass"]]&&TrueQ[#["Python_rational_certificate"]]&],Print["FAILED verify71"];Exit[3]];Print["PASS ",Length[cr71]," cell, ",Length[dr71]," column and ",Length[mr71]," mode checks"];
