(* Exact two-block level geometry and coarea-score moments.
   The numerical level root is rounded to an exact 32-decimal rational,
   then its level residual is re-evaluated. This defines the point honestly
   instead of inflating the precision of an accumulated floating iterate. *)
$endpoint48LibraryMode=True;Get[FileNameJoin[{DirectoryName[$InputFileName],"endpoint48.wl"}]];$endpoint48LibraryMode=False;
logD49[b_,c_,t_,wp_,step_,cut_]:=Module[{sol,d,rho,eta,off,g},sol=solveD46[b,N[c,wp],N[t,wp],wp];d=sol["d"];rho=d/c;eta=1-rho;off=rho t-b m46[d];g=gCenter46[b,d,off,wp,step,cut];b(Log[c/d]+Log[1+Exp[-d]]-Log[1+Exp[-c]])-eta t+Log[rho]+g["log_g"]];
GL49[k_,wp_]:=Module[{a,vals,vec,ord},a=Table[If[Abs[i-j]==1,Min[i,j]/Sqrt[4Min[i,j]^2-1],0],{i,k},{j,k}];{vals,vec}=Eigensystem[N[a,wp]];ord=Ordering[vals];Transpose[{vals[[ord]],2(vec[[ord,1]])^2}]];
level49[n_,c_,q_,mu_,v_,wp_,step_,cut_,lf0_,norm0_]:=Module[{bb=n/2,dd=Sqrt[n mu]v,fun,x,sol,t1,t2,p1,p2,kS,ww,rr,lo,hi,proposal,it},
 fun[xx_?NumericQ]:=xx+logD49[bb,c,(q+xx+dd)/2,wp,step,cut]+logD49[bb,c,(q+xx-dd)/2,wp,step,cut]-2lf0;
 If[TrueQ[v==0],sol=0;it=0,
 lo=N[0,wp];hi=N[Max[1,v^2],wp];Do[If[fun[hi]>0,Break[]];hi*=2,{20}];sol=N[v^2/2,wp];
 Do[rr=fun[sol];If[Abs[rr]<10^-28,Break[]];If[rr<0,lo=sol,hi=sol];proposal=sol-rr;sol=If[lo<proposal<hi,proposal,(lo+hi)/2],{it,160}]];sol=Round[sol*10^32]/10^32;rr=fun[sol];t1=(q+sol+dd)/2;t2=(q+sol-dd)/2;p1=point48[bb,c,t1,wp,step,cut];p2=point48[bb,c,t2,wp,step,cut];kS=(p1["log_R_derivative"]+p2["log_R_derivative"])/2;ww=norm0 Exp[-sol]/kS;
 <|"v"->v,"S_minus_q"->sol,"normalized_weight"->ww,"common_score"->p1["score"]+p2["score"],"contrast_score"->p1["score"]-p2["score"],"level_residual"->rr,"valid"->TrueQ[Abs[rr]<10^-25&&p1["root_valid"]&&p2["root_valid"]]|>];
case49[n_,order_:16,V_:6,factor_:1,step_:1/16,cut_:32]:=Module[{wp=factor Max[120,2IntegerLength[n,10]+100],mu,p,ll,z,c,q,lf0,lfn,norm0,rule,rows,weights,mass,cm,cm2,ct2,predMass,predC2,predA2,grid,start=AbsoluteTime[]},
 mu=N[1+ProductLog[1/E],wp+60];p=(mu-1)/mu;ll=N[Log[n],wp+20];z=zz/.FindRoot[Erfc[zz/Sqrt[2]]/2==Sqrt[mu/n]zz,{zz,Sqrt[ll]},WorkingPrecision->wp+20,AccuracyGoal->wp-30,PrecisionGoal->wp-30];c=mu-Sqrt[mu/n]z/2;q=n mu-Sqrt[mu n]z;lf0=logD49[n/2,c,q/2,wp,step,cut];lfn=logD49[n,c,q,wp,step,cut];norm0=Sqrt[n mu]/2 Exp[2lf0-lfn];rule=GL49[order,wp];rows=Table[level49[n,c,q,mu,(1+rule[[j,1]])V/2,wp,step,cut,lf0,norm0],{j,order}];weights=V rule[[All,2]];
 mass=Dot[weights,rows[[All,"normalized_weight"]]];cm=Dot[weights,rows[[All,"normalized_weight"]]rows[[All,"common_score"]]];cm2=Dot[weights,rows[[All,"normalized_weight"]]rows[[All,"common_score"]]^2];ct2=Dot[weights,rows[[All,"normalized_weight"]]rows[[All,"contrast_score"]]^2]/z^2;
 predMass=Erf[V/Sqrt[2]];predC2=p^2/4 NIntegrate[(v^2-2)^2 Exp[-v^2/2]/Sqrt[2Pi],{v,-V,V},WorkingPrecision->60];predA2=p^2/4 NIntegrate[v^2 Exp[-v^2/2]/Sqrt[2Pi],{v,-V,V},WorkingPrecision->60];
 grid=Table[Module[{r=level49[n,c,q,mu,N[v,wp],wp,step,cut,lf0,norm0]},<|"v"->v,"S_minus_q"->If[v==0,0,N[r["S_minus_q"],25]],"predicted_shift"->v^2/2,"normalized_weight"->N[r["normalized_weight"],25],"Gaussian_density"->N[Exp[-v^2/2]/Sqrt[2Pi],25],"common_score"->N[r["common_score"],25],"predicted_common"->N[p(v^2-2)/2,25],"contrast_score_over_zN"->If[v==0,0,N[r["contrast_score"]/z,25]],"predicted_contrast_over_zN"->N[-p v/2,25],"valid"->r["valid"]|>],{v,{0,1,2,3}}];
 <|"N_exact"->ToString[n,InputForm],"working_precision"->wp,"c_internal"->ToString[c,InputForm],"q_internal"->ToString[q,InputForm],"logf_half_internal"->ToString[lf0,InputForm],"norm0_internal"->ToString[norm0,InputForm],"quadrature_order_half_line"->order,"angular_cutoff_V"->V,"fourier_step"->step,"fourier_cutoff"->cut,"all_roots_valid"->TrueQ[And@@rows[[All,"valid"]]&&And@@grid[[All,"valid"]]],"max_level_residual"->ToString[Max[Abs[rows[[All,"level_residual"]]]],InputForm],"surface_mass_over_fNq"->N[mass,25],"common_first_moment_over_fNq"->N[cm,25],"common_second_moment_over_fNq"->N[cm2,25],"contrast_second_moment_over_zN2_fNq"->N[ct2,25],"predicted_compact_mass"->N[predMass,25],"predicted_compact_common_second"->N[predC2,25],"predicted_compact_contrast_second"->N[predA2,25],"fNq_times_N_over_L"->N[Exp[lfn]n/ll,25],"point_grid"->grid,"seconds"->N[AbsoluteTime[]-start]|>];
If[!TrueQ[$coarea49LibraryMode],out49=If[Length[$ScriptCommandLine]>=2,$ScriptCommandLine[[2]],"/tmp/coarea49.json"];rows49={};Do[r=case49[n];AppendTo[rows49,r];Print[KeyTake[r,{"N_exact","surface_mass_over_fNq","common_second_moment_over_fNq","contrast_second_moment_over_zN2_fNq","all_roots_valid","seconds"}]];Export[out49,<|"wolfram"->$Version,"scope"->"exact two-block level and finite angular coarea moments; floating Fourier/GL not interval certification; omitted angular tail not silently set to zero","rows"->rows49|>,"RawJSON"],{n,{256,4096,65536,2^24,2^48,2^96,2^256,2^512}}]];
