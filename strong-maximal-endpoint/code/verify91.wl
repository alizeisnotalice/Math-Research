a91=Rest[$ScriptCommandLine];out91=a91[[1]];workers91=If[Length[a91]>=2,ToExpression[a91[[2]]],12];mem91=If[Length[a91]>=3,ToExpression[a91[[3]]],256];If[!DirectoryQ[out91],CreateDirectory[out91,CreateIntermediateDirectories->True]];
ClearAll[clip91,polyarea91,low91,intersection91,area91,case91,runStripe91,runUnit91,runScalar91,phi91,q91,str91,price91];
str91[x_]:=ToString[N[x,65],InputForm];q91[x_]:=Erfc[x/Sqrt[2]]/2;phi91[x_]:=Exp[-x^2/2]/Sqrt[2Pi];price91[x_,nn_]:=Log[1+x]+(nn-1)Log[1+Log[1+x]];
(* Exact polygon clipping is independent of the Python positive-part double primitive. *)
clip91[poly_List,bound_,lower_]:=Module[{res={},pairs,v,w,iv,iw,den,t},If[Length[poly]==0,Return[{}]];pairs=Partition[Append[poly,First[poly]],2,1];Do[{v,w}=pair;iv=If[lower,Total[v]>=bound,Total[v]<=bound];iw=If[lower,Total[w]>=bound,Total[w]<=bound];If[TrueQ[iv],AppendTo[res,v]];If[TrueQ[iv]!=TrueQ[iw],den=Total[w]-Total[v];t=(bound-Total[v])/den;AppendTo[res,v+t(w-v)]],{pair,pairs}];res];
polyarea91[poly_List]:=If[Length[poly]<3,0,Abs[Total[Det/@Partition[Append[poly,First[poly]],2,1]]]/2];
area91[r_List]:=Max[0,r[[2]]-r[[1]]]Max[0,r[[4]]-r[[3]]];
intersection91[r_List,b_List]:={Max[r[[1]],b[[1]]],Min[r[[2]],b[[2]]],Max[r[[3]],b[[3]]],Min[r[[4]],b[[4]]]};
low91[r_List,p_,eps_]:=Module[{poly,first,last},If[area91[r]==0,Return[0]];poly={{r[[1]],r[[3]]},{r[[2]],r[[3]]},{r[[2]],r[[4]]},{r[[1]],r[[4]]}};first=Floor[(r[[1]]+r[[3]])/eps]-1;last=Ceiling[(r[[2]]+r[[4]])/eps]+1;Sum[polyarea91[clip91[clip91[poly,j eps,True],(j+p)eps,False]],{j,first,last}]];
case91[r_List,p_,eps_,boxes_List,bx_]:=Module[{v=area91[r],ivs,base,low,err,mean,bound},ivs=intersection91[r,#]&/@boxes;base=Total[area91/@ivs]/v;low=Total[low91[#,p,eps]&/@ivs]/v;err=Abs[low-p base];mean=(5base-low)/4;bound=2Length[boxes]eps/bx;<|"rectangle"->(ToString[#,InputForm]&/@r),"base_density"->ToString[base,InputForm],"low_density"->ToString[low,InputForm],"density_error"->ToString[err,InputForm],"proof_bound"->ToString[bound,InputForm],"actual_mean"->ToString[mean,InputForm],"strict_margin"->ToString[mean-1,InputForm],"actual_witness"->TrueQ[mean>1],"pass"->TrueQ[err<=bound]|>];
