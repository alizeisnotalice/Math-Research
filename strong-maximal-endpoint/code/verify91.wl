"unit_polygon_area"->TrueQ[polyarea91[{{0,0},{1,0},{1,1},{0,1}}]==1]
|>;Print["symbolic ",symbolic91];
runScalar91[k_Integer]:=Module[{nn=2^k,rows={},wp,prec,ll,mu,ss,zz,t0,t1,shift,hh,er,ltau,tau,dd,lp1,lp2,g1,g2,fee,r0,r1,res},Do[prec=wp+Ceiling[k Log[2]/Log[10]]+80;ll=N[k Log[2],prec];mu=u/.FindRoot[u-1-Exp[-u]==0,{u,N[128/100,prec]},WorkingPrecision->prec,AccuracyGoal->prec-20,PrecisionGoal->prec-20];ss=Sqrt[mu];zz=u/.FindRoot[Log[q91[u]]-Log[ss u]+ll/2==0,{u,N[4Sqrt[ll]/5,prec],N[11Sqrt[ll]/10,prec]},WorkingPrecision->prec,AccuracyGoal->prec-20,PrecisionGoal->prec-20,MaxIterations->100];t0=Sqrt[ll/2-4Log[ll]];t1=Sqrt[ll-8Log[ll]];shift=1/Sqrt[ll];hh=ll Exp[-ll/4];er=ll^(5/2)Exp[-ll/2];ltau=Log[ss zz]-ll/2;tau=Exp[ltau];dd=ss Sqrt[N[nn,prec]]zz;lp1=price91[tau,nn];lp2=price91[2tau,nn];g1=lp1-dd;g2=lp2-2dd;fee=ltau+g2-g1;r0=Log[q91[t0]]-Log[hh];r1=Log[q91[t1+shift]]-Log[er];res=Abs[Log[q91[zz]]-Log[ss zz]+ll/2];AppendTo[rows,<|"working_precision"->wp,"guarded_working_precision"->prec,"mu"->str91[mu],"sigma"->str91[ss],"L"->str91[ll],"z"->str91[zz],"t0"->str91[t0],"t1"->str91[t1],"log_p0_over_h"->str91[r0],"log_p1_over_error"->str91[r1],"t0_over_z"->str91[t0/zz],"t1_over_z"->str91[t1/zz],"logPhi1_minus_d"->str91[g1],"logPhi2_minus_2d"->str91[g2],"fee_minus_d"->str91[fee],"fee_minus_d_over_L"->str91[fee/ll],"log_tail_residual"->str91[res],"pass"->TrueQ[res<10^-wp&&tau>0&&2tau<1/4&&t1>t0>0]|>],{wp,{80,160}}];<|"k"->k,"kernel_id"->$KernelID,"precision_rows"->rows|>];
ks91={64,96,128,192,256,384,512,768,1024,1536,2048,4096};LaunchKernels[workers91];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[str91,q91,phi91,price91,clip91,polyarea91,area91,intersection91,low91,case91,runStripe91,runUnit91,runScalar91,boxes91,rects91,mem91];tm91=AbsoluteTime[];stripe91=ParallelMap[MemoryConstrained[TimeConstrained[runStripe91[#],120,"TIMEOUT"],mem91 2^20,"MEMORY_LIMIT"]&,Tuples[{{1/4,1/3,1/2,3/4},{8,16,32,64}}],Method->"FinestGrained"];unit91=ParallelMap[MemoryConstrained[TimeConstrained[runUnit91[#],120,"TIMEOUT"],mem91 2^20,"MEMORY_LIMIT"]&,{6,12,24,48},Method->"FinestGrained"];scalar91=ParallelMap[MemoryConstrained[TimeConstrained[runScalar91[#],120,"TIMEOUT"],mem91 2^20,"MEMORY_LIMIT"]&,ks91,Method->"FinestGrained"];CloseKernels[];pass91=And@@Values[symbolic91]&&AllTrue[Join[stripe91,unit91],AssociationQ[#]&&TrueQ[#["pass"]]&]&&AllTrue[scalar91,AssociationQ[#]&&AllTrue[#["precision_rows"],TrueQ[#["pass"]]&]&];Export[FileNameJoin[{out91,"verification91.json"}],<|"version"->$Version,"pass"->TrueQ[pass91],"symbolic"->symbolic91,"configured_workers"->workers91,"per_case_memory_limit_MiB"->mem91,"kernels_closed"->True,"seconds"->N[AbsoluteTime[]-tm91],"stripe_rows"->stripe91,"unit_audit_rows"->unit91,"scalar_rows"->scalar91,"scope"->"Exact finite rational phase geometry and scalar probability/actual price diagnostics; no finite-N physical theorem onset."|>,"RawJSON"];Print[If[TrueQ[pass91],"PASS ","FAIL "],Length[stripe91]," stripe, ",Length[unit91]," unit, ",Length[scalar91]," scalar cases"];If[!TrueQ[pass91],Exit[3]];
