runStripe91[arg_List]:=Module[{p=arg[[1]],mm=arg[[2]],eps,rr,shares,price},eps=1/mm;rr=MapIndexed[Append[case91[#,p,eps,boxes91,1/200],"id"->"R"<>ToString[First[#2]]]&,rects91];shares=(low91[#,p,eps]/area91[#])&/@boxes91;price=(3/2)(p+(1-p)(5/4)(1+Log[5/4]));<|"p"->ToString[p,InputForm],"m"->mm,"kernel_id"->$KernelID,"global_low_shares"->(ToString[#,InputForm]&/@shares),"rectangles"->rr,"price"->str91[price],"pass"->TrueQ[And@@Thread[shares==p]&&And@@Lookup[rr,"pass"]&&And@@Lookup[Take[rr,2],"actual_witness"]]|>];
