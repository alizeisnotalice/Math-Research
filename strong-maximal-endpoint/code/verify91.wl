symbolic91=<|
"quadratic_price_second"->TrueQ[FullSimplify[(D[price91[x,nn],{x,2}]/.x->0)==1-2nn]],
"hole_fraction_correction"->TrueQ[FullSimplify[1-1/(1+t)-t==-t^2/(1+t),Assumptions->t>0]],
