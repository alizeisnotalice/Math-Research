args79=Rest[$ScriptCommandLine];in79=args79[[1]];out79=args79[[2]];If[!DirectoryQ[out79],CreateDirectory[out79,CreateIntermediateDirectories->True]];
ClearAll[rat79,ov79,mean79,gmax79,grid79,bi79,li79,pl79,ff79,cb79,sliver79,psi79,phi79,density79,round79];
rat79[s_String]:=If[StringMatchQ[s,RegularExpression["-?[0-9]+(/[0-9]+)?"]],ToExpression[s,InputForm],Throw["bad rational"]];
ov79[lo_,hi_]:=Table[Max[0,Min[hi,4(k+1)]-Max[lo,4k]],{k,0,1}];
mean79[f_,lo_,hi_]:=Module[{t=f,n=Length[lo],w},Do[w=ov79[lo[[i]],hi[[i]]];t=Map[(w.#)&,t,{i-1}],{i,n,1,-1}];t/(8 Times@@(hi-lo))];
gmax79[f_,x_]:=Module[{t=f,n=Length[x],M,den},Do[M=Table[ov79[Min[a,x[[i]]],Max[a,x[[i]]]],{a,{0,4,8}}];t=Map[ArrayReshape[M.ArrayReshape[#,{2,3^(n-i)}],ConstantArray[3,n-i+1]]&,t,{i-1}],{i,n,1,-1}];den=(Times@@#&)/@Tuples[Table[Abs[x[[i]]-{0,4,8}],{i,n}]];Max[Flatten[t]/(8den)]];
grid79[c_]:=Catch[Module[{n=c["N"],x=c["receiver_units_quarters"],f,mx,chainvs,a,lo,hi},f=ArrayReshape[c["source_heights_eighths"],ConstantArray[2,n]];mx=gmax79[f,x];If[mx!=rat79[c["grid_maximum"]],Throw["grid maximum"]];a=c["maximizing_grid_anchor_units"];If[mean79[f,MapThread[Min,{a,x}],MapThread[Max,{a,x}]]!=mx,Throw["maximizer"]];
Do[lo=r["lower"];hi=r["upper"];If[!And@@Thread[lo<=x]||!And@@Thread[x<=hi]||mean79[f,lo,hi]!=rat79[r["average"]]||rat79[r["average"]]>mx,Throw["arbitrary rectangle"]],{r,c["rectangles"]}];
Do[chainvs=Map[Function[a,mean79[f,MapThread[Min,{a,x}],MapThread[Max,{a,x}]]],r["anchors"]];If[chainvs!=(rat79/@r["averages"])||!And@@Thread[Differences[chainvs]>=0]||Last[chainvs]>mx,Throw["endpoint chain"]],{r,c["rounding_chains"]}];
<|"N"->n,"seed"->c["seed"],"exact_pass"->True,"rectangles"->Length[c["rectangles"]],"moves"->Total[Length[#["anchors"]]-1&/@c["rounding_chains"]]|>]];
bi79[t_]:=bi79[t]=Module[{u=(t-1)/(t+1),lo,hi},lo=Sum[2u^(2k+1)/(2k+1),{k,0,39}];hi=lo+2u^81/(81(1-u^2));{Floor[10^30 lo]/10^30,Ceiling[10^30 hi]/10^30}];
li79[s_]:=Module[{t=s,k=0,lo,hi,a,b},If[t<=0,Throw["nonpositive logarithm"]];While[t<1,t*=2;k--];While[t>2,t/=2;k++];{lo,hi}=bi79[t];{a,b}=bi79[2];{Floor[10^30(lo+k If[k>=0,a,b])]/10^30,Ceiling[10^30(hi+k If[k>=0,b,a])]/10^30}];
pl79[n_,g_]:=Module[{lo,hi},{lo,hi}=li79[g];{lo+(n-1)First[li79[1+lo]],hi+(n-1)Last[li79[1+hi]]}];
ff79[n_,s_,r_]:=Module[{a,b,c,d},{a,b}=li79[1+r];{c,d}=li79[s];{(n-1)r-b-1-d,(n-1)r-a-1-c}];
cb79[n_,s_,d_,lo_,hi_]:={First[li79[2d/hi]]+First[pl79[n,s(1+lo)]],Last[li79[2d/lo]]+Last[pl79[n,s(1+hi)]]};
sliver79[z_]:=Catch[Module[{n=z["N"],s=rat79[z["sigma"]],d=rat79[z["d"]],rl=rat79[z["r_lower"]],rh=rat79[z["r_upper"]],r=rat79[z["r_candidate"]],g=rat79[z["height"]],u=rat79[z["width"]],rmin,rmax,bd,gr,loss,rr,lc,lg,wp,nums={}},rmin=2d;rmax=2/s-1;
If[!(0<rmin<=rl<=rh<=rmax)||g!=s(1+r)||u!=2d/r||g u/(u+2d)!=s||!(u<=1&&g<=2),Throw["slab geometry"]];
Switch[z["branch"],"full",If[rl!=rmin||rh!=rmin||First[ff79[n,s,rmin]]<0,Throw["full branch"]],"cap",If[rl!=rmax||rh!=rmax||Last[ff79[n,s,rmax]]>0,Throw["cap branch"]],"interior",If[Last[ff79[n,s,rl]]>=0||First[ff79[n,s,rh]]<=0,Throw["root bracket"]],_,Throw["unknown branch"]];
bd=cb79[n,s,d,rl,rh];gr=pl79[n,s(1+2d)];loss={gr[[1]]-bd[[2]],gr[[2]]-bd[[1]]};
If[bd!=(rat79/@z["log_continuous_optimum_interval"])||gr!=(rat79/@z["log_grid_wholecell_price_interval"])||loss!=(rat79/@z["log_grid_onecolumn_loss_interval"])||cb79[n,s,d,r,r]!=(rat79/@z["log_candidate_cost_interval"]),Throw["log intervals"]];
If[(g u/(1+d)<1)=!=z["grid_sees_no_slab_halo"]||g u/(1+d)!=rat79[z["grid_slab_mean_upper"]],Throw["source-grid blindness"]];
Do[rr=Switch[z["branch"],"full",N[rmin,wp+20],"cap",N[rmax,wp+20],"interior",x/.FindRoot[(n-1)x-Log[1+x]==1+Log[s],{x,N[(1+Log[s])/(n-2),wp+20]},WorkingPrecision->wp+20]];
lc=N[Log[2d/rr]+Log[s(1+rr)]+(n-1)Log[1+Log[s(1+rr)]],wp];lg=N[Log[s(1+2d)]+(n-1)Log[1+Log[s(1+2d)]],wp];
If[!TrueQ[rl-10^(-Floor[wp/2])<=rr<=rh+10^(-Floor[wp/2])]||!TrueQ[bd[[1]]<=lc<=bd[[2]]],Throw["independent numeric optimum"]];
AppendTo[nums,<|"precision"->wp,"log_continuous_optimum"->ToString[N[lc,40],InputForm],"log_grid_loss"->ToString[N[lg-lc,40],InputForm]|>],{wp,{60,120}}];
<|"N"->n,"kind"->z["kind"],"branch"->z["branch"],"exact_pass"->True,"precision_rows"->nums|>]];
psi79[t_]:=Module[{a,b},{a,b}=li79[t];{t^3/36+t^3 a/6,t^3/36+t^3 b/6}];
phi79[t_]:=If[t<=1,{t,t},t(1+li79[t])];
density79[z_,jf_]:=Catch[Module[{m=z["mesh"],counts,mass,j,lo,hi},counts=SortBy[Tally[Flatten[Table[Floor[3(8m+4i+2k+3)/8],{i,0,m-1},{k,0,m-1}]]],First];If[counts!=z["height_counts"],Throw["rational floor source"]];
mass=Total[(#[[1]]#[[2]]&)/@counts]/(3m^3);lo=Total[(#[[2]] First[phi79[#[[1]]/(3m)]]&)/@counts]/m^2;hi=Total[(#[[2]] Last[phi79[#[[1]]/(3m)]]&)/@counts]/m^2;
If[mass!=rat79[z["mass"]]||{lo,hi}!=(rat79/@z["modular_interval"])||hi>jf[[1]]||(mass>(117/100)^2)=!=z["whole_receiver_square_success"],Throw["density modular"]];
<|"mesh"->m,"exact_pass"->True,"whole_receiver_square_success"->z["whole_receiver_square_success"]|>]];
round79[z_,ab_]:=Catch[Module[{n=z["N"],q=z["anchor_denominator"],f=z["lower_anchor_numerator"],lm},If[q!=16n||Floor[q ab[[1]]]!=f||Floor[q ab[[2]]]!=f||z["upper_anchor_numerator"]!=f+1,Throw["outward anchor"]];
lm={First[li79[3/2]]-n Last[li79[1+5/(2q)]],Last[li79[3/2]]-n First[li79[1+5/(2q)]]};
If[lm!=(rat79/@z["log_rounded_mean_lower_interval"])||lm[[1]]<=0,Throw["rounding mean"]];
<|"N"->n,"exact_pass"->True,"orthant_modular_ratio"->1|>]];
gd79=Import[FileNameJoin[{in79,"grid79.json"}],"RawJSON"];sd79=Import[FileNameJoin[{in79,"sliver79.json"}],"RawJSON"];rd79=Import[FileNameJoin[{in79,"rational79.json"}],"RawJSON"];
a79=psi79[7/4];b79=psi79[3/2];c79=psi79[5/4];d79=psi79[1];jf79=8{a79[[1]]-b79[[2]]-c79[[2]]+d79[[1]],a79[[2]]-b79[[1]]-c79[[1]]+d79[[2]]};If[jf79!=(rat79/@rd79["smooth_modular_interval"]),Print["FAIL smooth denominator"];Exit[3]];
ab79=rat79/@rd79["irrational_anchor_interval"];If[!TrueQ[(10ab79[[1]])^2<=2<=(10ab79[[2]])^2],Print["FAIL irrational bracket"];Exit[3]];
der79=TrueQ[FullSimplify[D[(C+q(d-a))/(x-a),a]==(C+q(d-x))/(x-a)^2]];
slabder79=TrueQ[FullSimplify[D[2s dd g(1+Log[g])^(nn-1)/(g-s),g]==2s dd(1+Log[g])^(nn-2)((nn-1)g-s(nn+Log[g]))/(g-s)^2,Assumptions->g>s>1&&nn>=2&&dd>0]];
psider79=TrueQ[FullSimplify[D[t^3/36+t^3 Log[t]/6,{t,2}]==t(1+Log[t]),Assumptions->t>1]];
orth79=TrueQ[FullSimplify[(1-z)+(1+z)==2]];
LaunchKernels[12];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[rat79,ov79,mean79,gmax79,grid79,bi79,li79,pl79,ff79,cb79,sliver79,psi79,phi79,density79,round79,jf79,ab79];tt79=AbsoluteTime[];
gr79=ParallelMap[TimeConstrained[grid79[#],90,"TIMEOUT"]&,gd79["cases"],Method->"FinestGrained"];
sl79=ParallelMap[TimeConstrained[sliver79[#],90,"TIMEOUT"]&,sd79["rows"],Method->"FinestGrained"];
de79=ParallelMap[density79[#,jf79]&,rd79["density_rows"]];ro79=ParallelMap[round79[#,ab79]&,rd79["rounding_rows"]];CloseKernels[];
pass79=der79&&slabder79&&psider79&&orth79&&AllTrue[Join[gr79,sl79,de79,ro79],AssociationQ[#]&&TrueQ[#["exact_pass"]]&];
Export[FileNameJoin[{out79,"verification79.json"}],<|"version"->$Version,"workers"->12,"seconds"->N[AbsoluteTime[]-tt79],"pass"->pass79,"symbolic_endpoint_derivative"->der79,"symbolic_slab_derivative"->slabder79,"symbolic_smooth_primitive"->psider79,"symbolic_orthant_factor"->orth79,"grid"->gr79,"sliver"->sl79,"density"->de79,"rounding"->ro79|>,"RawJSON"];
Print[If[pass79,"PASS ","FAIL "],Length[gr79]," exact grid tests; ",Length[sl79]," certified optima; density and anchor roundings"];
If[!pass79,Print[Cases[Join[gr79,sl79,de79,ro79],_String]];Exit[3]];
