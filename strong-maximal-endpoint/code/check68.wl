oldok=If[old===None,Null,Length[old["rows"]]==48&&And@@MapThread[Function[{x,y},And@@(dist68[x,y,#]<tol&/@{"envelope_mass","central_rate","tilt_gamma"})],{rows,old["rows"]}]];
status=Length[rows]==48&&Length[mr]==35&&AllTrue[rows,TrueQ[#["numeric"]]&]&&AllTrue[mr,TrueQ[#["numeric"]]&]&&AllTrue[Join[epairs,mpairs],TrueQ[#["pass"]]&]&&(oldok===Null||TrueQ[oldok]);
Export[a[[3]],<|"pass"->status,"envelope_precision_pairs"->epairs,"mixed_precision_pairs"->mpairs,"cached_vs_initial_48_case_agreement"->oldok,"tolerance"->"1e-30"|>,"RawJSON"];If[!TrueQ[status],Print["FAILED check68"];Exit[3]];Print["PASS 24 envelope precision pairs and 10 mixed precision pairs"];
