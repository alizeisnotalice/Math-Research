mpairs=Table[Module[{lo=SelectFirst[mr,#["b"]==b&&#["q_power"]==q&&#["precision"]==60&],hi=SelectFirst[mr,#["b"]==b&&#["q_power"]==q&&#["precision"]==120&]},<|"b"->b,"q_power"->q,"mixed_abs_difference"->ToString[N[Abs[val68[lo["normalized_mixed"]]-val68[hi["normalized_mixed"]]],20],InputForm],"pass"->TrueQ[Abs[val68[lo["normalized_mixed"]]-val68[hi["normalized_mixed"]]]<tol]|>],{b,{4,8,16,32,64}},{q,{16,20}}]//Flatten;
