a=Rest[$ScriptCommandLine];If[Length[a]<3,Exit[2]];e=Import[a[[1]],"RawJSON"];m=Import[a[[2]],"RawJSON"];old=If[Length[a]>=4,Import[a[[4]],"RawJSON"],None];rows=e["rows"];mr=m["rows"];tol=10^-30;
ClearAll[val68];val68[x_]:=ToExpression[x];
