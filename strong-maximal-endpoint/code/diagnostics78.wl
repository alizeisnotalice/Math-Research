args78=Rest[$ScriptCommandLine];in78=args78[[1]];out78=args78[[2]];If[!DirectoryQ[out78],CreateDirectory[out78,CreateIntermediateDirectories->True]];
ClearAll[rat78,log78,phi78,env78,rows78,col78,dp78,master78,case78,tri78];
rat78[s_String]:=If[StringMatchQ[s,RegularExpression["-?[0-9]+(/[0-9]+)?"]],ToExpression[s,InputForm],Throw["bad rational"]];
log78[t_]:=Module[{u=(t-1)/(t+1),lo,hi},lo=Sum[2u^(2k+1)/(2k+1),{k,0,19}];hi=lo+2u^41/(41(1-u^2));{Floor[10^12 lo]/10^12,Ceiling[10^12 hi]/10^12}];
phi78[t_]:=If[t<=1,{t,t},t(1+log78[t])];
env78[mesh_]:=env78[mesh]=Module[{nodes=Table[1+k/mesh,{k,0,mesh}],logs,low,up,a,b,va,vb,s},logs=log78/@nodes;low=Prepend[MapThread[{2+#2[[1]],-#1}&,{nodes,logs}],{1,0}];up={{1,0}};Do[a=nodes[[k]];b=nodes[[k+1]];va=a(1+logs[[k,2]]);vb=b(1+logs[[k+1,2]]);s=(vb-va)/(b-a);AppendTo[up,{s,va-s a}],{k,1,mesh}];{low,up}];
rows78[anchor_,cell_]:=Module[{ans={},area,lx,rx,ly,ry,ox,oy},Do[area=Abs[(x-anchor[[1]])(y-anchor[[2]])];If[area!=0,{lx,rx}=Sort[{x,anchor[[1]]}];{ly,ry}=Sort[{y,anchor[[2]]}];ox=Table[Max[0,Min[rx,k+1]-Max[lx,k]],{k,0,7}];oy=Table[Max[0,Min[ry,k+1]-Max[ly,k]],{k,0,7}];AppendTo[ans,{Flatten[Outer[Times,ox,oy]],area}]],{x,cell[[1;;2]]},{y,cell[[3;;4]]}];ans];
doc78=Import[FileNameJoin[{in78,"columns78.json"}],"RawJSON"];merge78=Import[FileNameJoin[{in78,"merge78.json"}],"RawJSON"];triangles78=Import[FileNameJoin[{in78,"triangle78.json"}],"RawJSON"];analytic78=Import[FileNameJoin[{in78,"analytic78.json"}],"RawJSON"];
phiex78[t_]:=If[t<=1,t,t(1+Log[t])];inv78[h_]:=If[h<=1,h,Exp[ProductLog[E h]-1]];
mergetest78[]:=Catch[Module[{c=First[doc78["cases"]],idx=merge78["column_indices"]+1,w=rat78/@merge78["weights"],f,gcols,gu,bhi,jhi,budget,rows,hExact,bExact,nums={},hv,gv,means,wp},f=rat78/@c["source"];gcols=(rat78/@#["primal"]&)/@c["columns"][[idx]];gu=rat78/@merge78["rational_dominating_aggregate"];
bhi=Table[Sum[w[[k]] Last[phi78[gcols[[k,l]]]],{k,Length[w]}],{l,64}];
If[!And@@Thread[0<=gu]||!And@@Thread[gu<=f]||!And@@Table[gu[[l]]==f[[l]]||First[phi78[gu[[l]]]]>=bhi[[l]],{l,64}],Throw["aggregate domination"]];
rows=DeleteDuplicates[Flatten[rows78[First[c["anchors"]],#]&/@c["receiver_cells"],1]];
If[Min[rows[[All,1]].gu-rat78[c["sigma"]]rows[[All,2]]]<0,Throw["aggregate vertices"]];
jhi=Total[Last[phi78[#]]&/@gu]/4;budget=Total[bhi]/4;
If[jhi!=rat78[merge78["aggregate_modular_upper"]]||budget!=rat78[merge78["weighted_input_modular_upper"]]||jhi>budget+10^-6,Throw["aggregate cost"]];
bExact=Table[Sum[w[[k]] phiex78[gcols[[k,l]]],{k,Length[w]}],{l,64}];hExact=MapThread[Min,{phiex78/@f,bExact}];
Do[hv=N[hExact,wp];gv=inv78/@hv;means=(rows[[All,1]].gv)/rows[[All,2]];
If[Min[means]<rat78[c["sigma"]]||Max[Abs[(phiex78/@gv)-hv]]>10^(-Floor[wp/2]),Throw["inverse residual"]];
AppendTo[nums,<|"precision"->wp,"aggregate_actual_modular"->ToString[N[Total[hv]/4,40],InputForm],"weighted_actual_modular"->ToString[N[Total[bExact]/4,40],InputForm],"minimum_actual_mean"->ToString[N[Min[means],40],InputForm],"maximum_upward_rounding"->ToString[N[Max[gu-gv],40],InputForm]|>],{wp,{60,120}}];
<|"exact_pass"->True,"rational_rounding_excess_upper"->ToString[Max[0,jhi-budget],InputForm],"precision_rows"->nums|>]];
census78[c_]:=({#["anchor_index"],#["mask"]}&/@c["columns"])==Flatten[Table[Select[Table[{a-1,mask},{mask,1,7}],BitAnd[#[[2]],Total[2^c["eligible"][[a]]]]==#[[2]]&],{a,Length[c["eligible"]]}],1];
analyticcheck78[]:=Catch[Module[{c=triangles78["cases"][[1]],a=analytic78["cases"][[1]],pairs,intervals={},pos,neg,l,u,fl,fu,other=triangles78["cases"][[2]],whole,pivot,columns},If[!census78[c]||!census78[other],Throw["incomplete triangle census"]];pairs=Select[c["columns"],DigitCount[#["mask"],2,1]==2&];
Do[pos=Select[pairs,BitGet[#["mask"],i]==1&];neg=First[Select[pairs,BitGet[#["mask"],i]==0&]];l=(Total[rat78[#["lower"]]&/@pos]-rat78[neg["upper"]])/2;u=(Total[rat78[#["upper"]]&/@pos]-rat78[neg["lower"]])/2;If[l<0||!And@@(u<=rat78[#["lower"]]&/@Select[c["columns"],#["mask"]==2^i&]),Throw["half-pair dual"]];AppendTo[intervals,{l,u}],{i,0,2}];
fl=Total[rat78[#["lower"]]&/@pairs]/2;fu=Total[rat78[#["upper"]]&/@pairs]/2;
If[intervals!=Map[rat78,a["supporting_price_intervals"],{2}]||fl!=rat78[a["analytic_fractional_lower"]]||fu!=rat78[a["analytic_fractional_upper"]],Throw["half-pair intervals"]];
columns=other["columns"];whole=First[Select[columns,#["anchor_index"]==3&&#["mask"]==7&]];pivot=First[Select[columns,#["anchor_index"]==3&&#["mask"]==2&]];
If[whole["mass"]!=pivot["mass"]||!And@@(rat78[#["mass"]]>=rat78[whole["mass"]]&/@Select[columns,BitGet[#["mask"],1]==1&]),Throw["corner exact repair"]];
<|"exact_pass"->True,"triangle_integer_fractional_ratio_lower"->ToString[N[rat78[c["cover"]["integer_lower"]]/fu,40],InputForm],"triangle_integer_fractional_ratio_upper"->ToString[N[rat78[c["cover"]["integer_upper"]]/fl,40],InputForm],"natural_corner_exact_no_gap"->True|>]];
crossjob78[j_]:=Module[{n=j[[1]],wp=j[[2]],e,d,h,lm,lq,lv},e=1/(8n);d=e/4;h=e^2/(64n);lm=N[Log[1+e]+Log[1-d]-(n-1)Log[1+h]-Log[1+h/d],wp];lq=N[-Log[2]+Log[1+e]+(n-1)Log[1+Log[1+e]],wp];lv=N[n Log[h],wp];<|"N"->n,"precision"->wp,"log_minimum_actual_mean"->ToString[N[lm,40],InputForm],"log_aggregate_height"->ToString[N[lq,40],InputForm],"log_receiver_volume"->ToString[N[lv,40],InputForm],"numeric_pass"->TrueQ[h<d&&lm>Log[1+e/3]&&lq<0]|>];
sym78=TrueQ[FullSimplify[D[t(1+Log[t])^(nn-1),{t,2}]==(nn-1)(nn-1+Log[t])(1+Log[t])^(nn-3)/t,Assumptions->t>1&&nn>=2]];
mergeout78=mergetest78[];analyticout78=analyticcheck78[];
LaunchKernels[12];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[crossjob78];crossout78=ParallelMap[crossjob78,Flatten[Table[{n,wp},{n,{2,4,8,16,32,64,128,256,1024,4096,16384,65536,262144,1048576}},{wp,{60,120}}],1]];CloseKernels[];
pass78=sym78&&AssociationQ[mergeout78]&&TrueQ[mergeout78["exact_pass"]]&&AssociationQ[analyticout78]&&TrueQ[analyticout78["exact_pass"]]&&AllTrue[crossout78,TrueQ[#["numeric_pass"]]&];
Export[FileNameJoin[{out78,"diagnostics78.json"}],<|"version"->$Version,"workers"->12,"pass"->pass78,"symbolic_phi_convexity"->sym78,"aggregate"->mergeout78,"analytic_triangle"->analyticout78,"cross_anchor"->crossout78|>,"RawJSON"];
Print[If[pass78,"PASS","FAIL"]," aggregate, analytic triangle dual/repair, ",Length[crossout78]," dimension checks"];If[!pass78,Print[{mergeout78,analyticout78}];Exit[3]];
