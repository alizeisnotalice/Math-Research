(* Independent native-Wolfram replay of scalar54.json.  Numerical cross-check only. *)
root=DirectoryName[$InputFileName];args=$ScriptCommandLine;in=If[Length[args]>=2,args[[2]],FileNameJoin[{root,"scalar54_final","scalar54.json"}]];out=If[Length[args]>=3,args[[3]],FileNameJoin[{root,"scalar54_wolfram.json"}]];
decRat[s_String]:=Module[{z=StringTrim[s],sg=1,e=0,ep,p,a,b},If[StringStartsQ[z,"-"],sg=-1;z=StringDrop[z,1]];ep=StringSplit[z,RegularExpression["[eE]"]];If[Length[ep]==2,z=ep[[1]];e=If[StringStartsQ[ep[[2]],"-"],-FromDigits[StringDrop[ep[[2]],1]],FromDigits[StringReplace[ep[[2]],"+"->""]]]];p=StringSplit[z,"."];a=If[p[[1]]=="",0,FromDigits[p[[1]]]];b=If[Length[p]==1,0,FromDigits[p[[2]]]/10^StringLength[p[[2]]]];sg(a+b)10^e];
raw=Import[in,"RawJSON"];n=64;m=512;c=decRat[raw["c_exact_decimal"]];bs=decRat/@raw["boundaries_exact_decimal"];alpha=1-63/10^8;loMean=decRat[raw["mean_interval","lo"]];hiMean=decRat[raw["mean_interval","hi"]];loJ=decRat[raw["budget_J_interval","lo"]];hiJ=decRat[raw["budget_J_interval","hi"]];loA=decRat[raw["finite_L_budget_Jalpha_interval","lo"]];hiA=decRat[raw["finite_L_budget_Jalpha_interval","hi"]];
If[!(Length[bs]==m+1&&And@@Thread[Most[bs]<Rest[bs]]&&c>0&&First[bs]>=0),Print["parameter guard failed"];Exit[2]];
calc[wp_Integer]:=Module[{cc=N[c,wp],bb=N[bs,wp],aa=N[alpha,wp],ks,ww,tail,hs,ph,mean,j,ja},ks=Range[0,n];ww=N[(Binomial[n,#]Exp[-cc #]/(1+Exp[-cc])^n)&/@ks,wp];tail[x_]:=Total[ww Table[GammaRegularized[n,Max[0,x-cc k],Infinity],{k,ks}]];mean=tail[bb[[1]]]+Total[tail/@Rest[bb]]/m;hs=Join[{1},Table[1+j/m,{j,1,m}]];ph[h_]:=If[h<=1,h,h(1+Log[h])^(n-1)];j=Total[Table[ph[hs[[q]]](Exp[-bb[[q]]]-If[q<m+1,Exp[-bb[[q+1]]],0]),{q,1,m+1}]];ja=Total[Table[ph[hs[[q]]](Exp[-aa bb[[q]]]-If[q<m+1,Exp[-aa bb[[q+1]]],0]),{q,1,m+1}]]/aa;<|"mean"->mean,"J"->j,"Jalpha"->ja|>];
{t120,r120}=AbsoluteTiming[calc[120]];{t240,r240}=AbsoluteTiming[calc[240]];
fmt[x_]:=ToString[N[x,70],InputForm];inside[x_,lo_,hi_]:=TrueQ[lo<=x<=hi];keys=Keys[r240];res=<|"status"->"independent Wolfram high-precision replay; numerical cross-check, not directed certification","wolfram"->$Version,"input"->in,"decimal_parse"->"exact rational parser, including scientific notation; no machine decimal conversion","timing_seconds"-><|"wp120"->t120,"wp240"->t240|>,"wp120"->Association@Table[k->fmt[r120[k]],{k,keys}],"wp240"->Association@Table[k->fmt[r240[k]],{k,keys}],"absolute_differences"->Association@Table[k->fmt[Abs[r240[k]-r120[k]]],{k,keys}],"inside_directed_intervals"-><|"mean"->inside[r240["mean"],loMean,hiMean],"J"->inside[r240["J"],loJ,hiJ],"Jalpha"->inside[r240["Jalpha"],loA,hiA]|>,"stability"->"120- and 240-digit values agree to displayed precision; interval containment is checked against canonical directed endpoints."|>;Export[out,res,"RawJSON"];Print[res];
