(* Lower KKT-band density and exact block score diagnostics. *)
$plateau47LibraryMode=True;Get[FileNameJoin[{DirectoryName[$InputFileName],"plateau47.wl"}]];$plateau47LibraryMode=False;
jet48[b_,d_,off_,wp_,step_,cut_]:=Module[{v,cf,g,gp},v=N[Range[-cut/step,cut/step]step,wp];cf=Exp[b(-Log[1-I v/Sqrt[b]]+Log[(1+Exp[-d+I d v/Sqrt[b]])/(1+Exp[-d])])-I m46[d]v Sqrt[b]-I v off/Sqrt[b]];g=step Re[Total[cf]]/(2Pi Sqrt[b]);gp=step Re[Total[-I v/Sqrt[b]cf]]/(2Pi Sqrt[b]);<|"g"->g,"logg"->Log[g],"gprime_over_g"->gp/g|>];
point48[n_,c_,q_,wp_,step_,cut_]:=Module[{sol,d,rho,eta,off,den,num,logM,lf,sc,k},sol=solveD46[n,N[c,wp],N[q,wp],wp];d=sol["d"];rho=d/c;eta=1-rho;off=rho q-n m46[d];den=jet48[n,d,off,wp,step,cut];num=jet48[n-1,d,off+m46[d]-d,wp,step,cut];logM=Log[c/d]+Log[1+Exp[-d]]-Log[1+Exp[-c]];lf=n logM-eta q+Log[rho]+den["logg"];sc=n p46[c](1-u46[d]/u46[c]Exp[num["logg"]-den["logg"]]);k=rho(1+den["gprime_over_g"]);<|"f"->Exp[lf],"score"->sc,"log_R_derivative"->k,"root_valid"->sol["valid"]|>];
case48[n_,label_,factor_:1,step_:1/16,cut_:32]:=Module[{wp=factor Max[120,2IntegerLength[n,10]+100],mu,p,ll,z,d,qbase,w,c,xsol,q,rr,pt,coef,st,fun,start=AbsoluteTime[]},mu=N[1+ProductLog[1/E],wp+60];p=(mu-1)/mu;ll=N[Log[n],wp+20];z=zz/.FindRoot[Erfc[zz/Sqrt[2]]/2==Sqrt[mu/n]zz,{zz,Sqrt[ll]},WorkingPrecision->wp+20,AccuracyGoal->wp-30,PrecisionGoal->wp-30];d=Sqrt[mu n]z;qbase=n mu-d;w=ll/2+Log[ll];c=Switch[label,"mu",mu,"sqrtL",mu-Sqrt[mu ll/n]/2,"z",mu-Sqrt[mu/n]z/2];
 fun[x_?NumericQ]:=n/ll^2 mean47[n,c,qbase+x ll,w,wp,step,cut]["mean_minus_one"];xsol=x/.FindRoot[fun[x]==0,{x,N[(9-mu)/24,wp],N[(9-mu)/24-1/10,wp]},Method->"Secant",WorkingPrecision->wp,AccuracyGoal->40,PrecisionGoal->40,MaxIterations->30];q=qbase+xsol ll;rr=fun[xsol];If[!TrueQ[Abs[rr]<10^-30],Return[<|"N_exact"->ToString[n,InputForm],"label"->label,"root_valid"->False,"status"->"mean root residual failed"|>]];
 pt=point48[n,c,q,wp,step,cut];coef=2pt["f"]pt["score"]^2/pt["log_R_derivative"];st=point48[n,c,q+1/8,wp,step,cut];
 <|"N_exact"->ToString[n,InputForm],"label"->label,"working_precision"->wp,"cutoff"->cut,"step"->step,"root_valid"->TrueQ[pt["root_valid"]&&st["root_valid"]],"normalized_mean_root_residual"->ToString[rr,InputForm],"c_internal"->ToString[c,InputForm],"q_internal"->ToString[q,InputForm],"f_q_times_N_over_L"->N[pt["f"]n/ll,25],"score_q"->N[pt["score"],25],"score_q_over_L"->N[pt["score"] /ll,25],"log_R_derivative"->N[pt["log_R_derivative"],25],"sharp_coefficient_times_N_over_L3"->N[coef n/ll^3,25],"sharp_coefficient_times_N_over_L"->N[coef n/ll,25],"predicted_refined_score"->N[-p/2,25],"predicted_mu_L3_coefficient"->N[p^2/2,25],"score_at_q_plus_1_8"->N[st["score"],25],"seconds"->N[AbsoluteTime[]-start]|>];
If[!TrueQ[$endpoint48LibraryMode],out48=If[Length[$ScriptCommandLine]>=2,$ScriptCommandLine[[2]],"/tmp/endpoint48.json"];rows48={};Do[r=case48[n,label];AppendTo[rows48,r];Print[KeyTake[r,{"N_exact","label","score_q","seconds","root_valid"}]];Export[out48,<|"wolfram"->$Version,"scope"->"critical lower KKT endpoint density/score; floating Fourier diagnostics not total interval certificates","rows"->rows48|>,"RawJSON"],{n,{256,4096,65536,2^24,2^48,2^96,2^256,2^512,2^1024}},{label,{"mu","sqrtL","z"}}]];
