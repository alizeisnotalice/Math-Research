a86=Rest[$ScriptCommandLine];in86=a86[[1]];out86=a86[[2]];If[!DirectoryQ[out86],CreateDirectory[out86,CreateIntermediateDirectories->True]];
ClearAll[rat86,run86];rat86[s_String]:=If[StringMatchQ[s,RegularExpression["-?[0-9]+(/[0-9]+)?"]],ToExpression[s,InputForm],Throw["bad rational"]];
sym86=<|"short_inward_tail"->TrueQ[Resolve[ForAll[{d,a},0<=d<1&&d<=a<=1,(a-d)/(1-d)<=a],Reals]],"crossing_tail"->TrueQ[Resolve[ForAll[{r,a},r>0&&0<a<=1,(a+Min[a,r])/(1+r)<=2a],Reals]],"short_inward_mean"->TrueQ[FullSimplify[Integrate[z Exp[-z]/(1-d),{z,0,-Log[d]},Assumptions->0<d<1]==1+d Log[d]/(1-d),Assumptions->0<d<1]],"long_crossing_mean"->TrueQ[Integrate[2z Exp[-z]/(1+r),{z,0,Infinity},Assumptions->r>1]==2/(1+r)],"tail_second_exponential_moment"->TrueQ[FullSimplify[Integrate[2(2z+b z^2)Exp[-(1-b)z],{z,0,Infinity},Assumptions->0<b<1]==4/(1-b)^3,Assumptions->0<b<1]],"qualification_algebra"->TrueQ[FullSimplify[(Log[3/8]+b q-2nn b^2/(1-b)^3)/b==q-2nn b/(1-b)^3-Log[8/3]/b,Assumptions->0<b<1&&nn>0]],"Hardy_L2_integration_identity"->TrueQ[FullSimplify[D[ff[t]^2/t,t]==2ff[t]ff'[t]/t-ff[t]^2/t^2,Assumptions->t>0]],"cap2_square_modular_charge"->TrueQ[Resolve[ForAll[g,0<=g<=2,g^2<=2g],Reals]]|>;
s86=Import[FileNameJoin[{in86,"moments86.json"}],"RawJSON"];
run86[z_]:=Module[{rr={},wp,mu,dd,bb,r,c,mv,mg,closedm,closedg,slack,err},Do[mu=u/.FindRoot[u-1-Exp[-u]==0,{u,N[128/100,wp+40]},WorkingPrecision->wp+40,AccuracyGoal->wp+30,PrecisionGoal->wp+30];dd=If[z["endpoint"]=="critical",-(mu-1),N[rat86[z["endpoint"]],wp+40]];bb=N[rat86[z["b"]],wp+40];If[dd<0,r=-dd;If[r<=1,c=-Log[r];mv=(NIntegrate[t Exp[-t],{t,0,Infinity},WorkingPrecision->wp,AccuracyGoal->wp-30,PrecisionGoal->wp-30,Method->{"GlobalAdaptive","SymbolicProcessing"->0}]+NIntegrate[t Exp[-t],{t,c,Infinity},WorkingPrecision->wp,AccuracyGoal->wp-30,PrecisionGoal->wp-30,Method->{"GlobalAdaptive","SymbolicProcessing"->0}])/(1+r);mg=(NIntegrate[Exp[-(1-bb)t],{t,0,Infinity},WorkingPrecision->wp,AccuracyGoal->wp-30,PrecisionGoal->wp-30,Method->{"GlobalAdaptive","SymbolicProcessing"->0}]+NIntegrate[Exp[-(1-bb)t],{t,c,Infinity},WorkingPrecision->wp,AccuracyGoal->wp-30,PrecisionGoal->wp-30,Method->{"GlobalAdaptive","SymbolicProcessing"->0}])/(1+r);closedm=1-r Log[r]/(1+r);closedg=(1+r^(1-bb))/((1-bb)(1+r)),mv=2NIntegrate[t Exp[-t],{t,0,Infinity},WorkingPrecision->wp,AccuracyGoal->wp-30,PrecisionGoal->wp-30,Method->{"GlobalAdaptive","SymbolicProcessing"->0}]/(1+r);mg=(r-1+2NIntegrate[Exp[-(1-bb)t],{t,0,Infinity},WorkingPrecision->wp,AccuracyGoal->wp-30,PrecisionGoal->wp-30,Method->{"GlobalAdaptive","SymbolicProcessing"->0}])/(1+r);closedm=2/(1+r);closedg=(r-1+2/(1-bb))/(1+r)],If[dd<1,c=If[dd==0,Infinity,-Log[dd]];mv=NIntegrate[t Exp[-t]/(1-dd),{t,0,c},WorkingPrecision->wp,AccuracyGoal->wp-30,PrecisionGoal->wp-30,Method->{"GlobalAdaptive","SymbolicProcessing"->0}];mg=NIntegrate[Exp[-(1-bb)t]/(1-dd),{t,0,c},WorkingPrecision->wp,AccuracyGoal->wp-30,PrecisionGoal->wp-30,Method->{"GlobalAdaptive","SymbolicProcessing"->0}];closedm=If[dd==0,1,1+dd Log[dd]/(1-dd)];closedg=If[dd==0,1/(1-bb),(1-dd^(1-bb))/((1-bb)(1-dd))],mv=0;mg=1;closedm=0;closedg=1]];slack=bb mv+2bb^2/(1-bb)^3-Log[mg];err=Max[Abs[mv-closedm],Abs[Log[mg]-Log[closedg]]];AppendTo[rr,<|"working_precision"->wp,"mean"->ToString[N[mv,45],InputForm],"log_mgf"->ToString[N[Log[mg],45],InputForm],"moment_slack"->ToString[N[slack,45],InputForm],"quadrature_formula_error"->ToString[N[err,45],InputForm],"pass"->TrueQ[slack>0&&mv<=mu+10^-50&&err<10^-45]|>],{wp,{80,160}}];<|"endpoint"->z["endpoint"],"b"->z["b"],"kernel_id"->$KernelID,"rows"->rr|>];
LaunchKernels[12];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[run86,rat86];tt86=AbsoluteTime[];r86=ParallelMap[TimeConstrained[run86[#],120,"TIMEOUT"]&,s86["rows"],Method->"FinestGrained"];CloseKernels[];pass86=And@@Values[sym86]&&AllTrue[r86,AssociationQ[#]&&AllTrue[#["rows"],TrueQ[#["pass"]]&]&];Export[FileNameJoin[{out86,"verification86.json"}],<|"version"->$Version,"configured_workers"->12,"input_guard_digits"->40,"kernels_closed"->True,"seconds"->N[AbsoluteTime[]-tt86],"pass"->TrueQ[pass86],"symbolic"->sym86,"rows"->r86|>,"RawJSON"];Print[If[TrueQ[pass86],"PASS ","FAIL "],Length[r86]," clipped-log moment cases"];If[!TrueQ[pass86],Print[sym86];Print[Cases[r86,_String]];Exit[3]];
