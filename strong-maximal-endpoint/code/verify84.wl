a84=Rest[$ScriptCommandLine];in84=a84[[1]];out84=a84[[2]];If[!DirectoryQ[out84],CreateDirectory[out84,CreateIntermediateDirectories->True]];
ClearAll[rat84,expiv84,floor84,ceil84,run84,slab84,g84,x84,k84];
rat84[s_String]:=If[StringMatchQ[s,RegularExpression["-?[0-9]+(/[0-9]+)?"]],ToExpression[s,InputForm],Throw["bad rational"]];floor84[x_]:=Floor[10^80 x]/10^80;ceil84[x_]:=-floor84[-x];
expiv84[x_]:=Module[{b=0,t=x,lo=1,hi,term=1,nxt},While[t>1/2,t=t/2;b++];Do[term=term*t/k;lo+=term,{k,1,80}];nxt=term*t/81;hi=lo+nxt/(1-t/82);{lo,hi}={floor84[lo],ceil84[hi]};Do[{lo,hi}={floor84[lo^2],ceil84[hi^2]},{b}];{lo,hi}];
g84[t_]:=1-1/nn+t/nn;x84[v_]:=1+(1-v)^2/(2nn g84[v]);k84[b_,x_]:=((1-b)(1-1/nn)+(1-b^2)/(2nn))/(x-b);
sym84=<|"quadratic_KKT_loss"->TrueQ[FullSimplify[g84[v]-k84[b,x84[v]]==(b-v)^2/(2nn(x84[v]-b)),Assumptions->nn>=1024&&0<=b<1&&0<v<1]],"exterior_derivative"->TrueQ[FullSimplify[D[x84[v],v]==-(1-v)/(nn g84[v])-(1-v)^2/(2nn^2 g84[v]^2),Assumptions->nn>=1024&&0<v<1]],"positive_parameter_derivative"->TrueQ[FullSimplify[-g84[v]D[x84[v],v]==(1-v)/nn+(1-v)^2/(2nn^2 g84[v]),Assumptions->nn>=1024&&0<v<1]],"exact_optimal_average_parameter"->TrueQ[FullSimplify[g84[1+nn(Exp[-z/nn]-1)]]==Exp[-z/nn]],"exterior_range"->TrueQ[Resolve[ForAll[{nn,v},nn>=1024&&1/4<=v<=19/25,1<x84[v]<=1+1/nn],Reals]],"source_mass_identity"->TrueQ[FullSimplify[Integrate[g84[t],{t,0,1}]==1-1/(2nn)]],"source_Nmoment_antiderivative"->TrueQ[FullSimplify[D[nn/(nn+1)g84[t]^(nn+1),t]==g84[t]^nn,Assumptions->nn>=1024&&0<=t<=1]],"log_lower_derivative"->TrueQ[FullSimplify[D[Log[1-u]+u/(1-u),u]==u/(1-u)^2,Assumptions->0<u<1]],"pi_upper_positive_integral_identity"->TrueQ[FullSimplify[Integrate[t^4(1-t)^4/(1+t^2),{t,0,1}]]==22/7-Pi]|>;
run84[z_]:=Module[{n=z["N"],rr={},p,wp,aa,ii,lm1,lmn,mx,lj,lg,cf,ec,sh,orig,lw},Do[p=pr["p"];Do[aa=N[1/2+2/n^p,wp];ii=n/(n+1)(1-Exp[(n+1)Log[N[1-1/n,wp]]]);lm1=aa+n Log[N[1-1/(2n),wp]];lmn=n(aa+Log[ii]);mx=Max[lm1,lmn];lj=mx+Log[1+Exp[Min[lm1,lmn]-mx]];lg=LogGamma[N[n/2+1,wp]];lw=If[p==2,0,-Log[2]-2n/3];cf=lg+n(p-1)Log[n]/2-p Log[n]-n Log[132/7]/2-n Log[16]-Log[3]-n Log[21/20]-3/4+lw;ec=n(Log[5]+p Log[n]/2-Log[If[p==2,924,1848]])-Log[If[p==2,9,18]]-p Log[n];sh=lg+n(p-1)Log[n]/2-p Log[n]-n Log[6Pi]/2-n Log[16]-3/4-lj+lw;orig=lg+n(p-1)Log[n]/2-p Log[n]-n Log[6Pi]/2-n Log[16]-3/4-Log[2]-(n-1)Log[1+Log[2]]+lw;AppendTo[rr,<|"p"->p,"working_precision"->wp,"log_elementary_budget_lower"->ToString[N[ec,65],InputForm],"log_factorial_budget_lower"->ToString[N[cf,65],InputForm],"log_sharpened_budget_lower_numerical"->ToString[N[sh,65],InputForm],"log_actual_modular_upper"->ToString[N[lj,65],InputForm],"log_original_unit_support_lower"->ToString[N[orig,65],InputForm],"log_physical_residual_ratio_upper"->ToString[N[Log[2]-n Log[n],65],InputForm]|>],{wp,{80,160}}],{pr,z["rows"]}];<|"N"->n,"kernel_id"->$KernelID,"rows"->rr|>];
slab84[z_]:=Module[{n=z["N"],p=z["p"],d,cc,tot,pp,iv},d=n^(p-1);cc=n d/2+1;tot=Sum[(-1)^k Binomial[n,k](cc-k d)^n,{k,0,n/2}];pp=2tot/(n!d^n)-1;iv=rat84/@z["probability_interval"];<|"N"->n,"p"->p,"kernel_id"->$KernelID,"exact_pass"->TrueQ[iv[[1]]<=pp<=iv[[2]]&&pp>2/n^p&&rat84[z["proved_probability_lower"]]==2/n^p]|>];
src84=Import[FileNameJoin[{in84,"certificates84.json"}],"RawJSON"];s84=Import[FileNameJoin[{in84,"slabs84.json"}],"RawJSON"];
ce84=Table[expiv84[rat84[z["exponent"]]]==(rat84/@z["interval"]),{z,src84["constants"]["exponential_certificates"]}];gates84=src84["constants"]["gates"];If[!And@@ce84,Print["FAIL exact exponential interval replay"];Exit[3]];
LaunchKernels[12];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[run84,slab84,rat84];tt84=AbsoluteTime[];
r84=ParallelMap[TimeConstrained[run84[#],120,"TIMEOUT"]&,src84["rows"],Method->"FinestGrained"];ss84=ParallelMap[TimeConstrained[slab84[#],120,"TIMEOUT"]&,s84["rows"],Method->"FinestGrained"];CloseKernels[];
pass84=And@@Values[sym84]&&And@@ce84&&And@@Values[gates84]&&AllTrue[r84,AssociationQ]&&AllTrue[ss84,AssociationQ[#]&&TrueQ[#["exact_pass"]]&];
Export[FileNameJoin[{out84,"verification84.json"}],<|"version"->$Version,"workers"->12,"kernels_closed"->True,"seconds"->N[AbsoluteTime[]-tt84],"pass"->TrueQ[pass84],"symbolic"->sym84,"exact_exponential_intervals"->And@@ce84,"rows"->r84,"slab_checks"->ss84|>,"RawJSON"];
Print[If[TrueQ[pass84],"PASS ","FAIL "],Length[r84]," dimensions; ",Length[ss84]," exact thin slabs"];
If[!TrueQ[pass84],Print[sym84];Print[Cases[Join[r84,ss84],_String]];Exit[3]];
