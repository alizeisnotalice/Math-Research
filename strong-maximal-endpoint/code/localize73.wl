args73=Rest[$ScriptCommandLine];out73=args73[[1]];If[!DirectoryQ[out73],CreateDirectory[out73,CreateIntermediateDirectories->True]];
ClearAll[loc73];loc73[j_]:=Module[{n=j["N"],m=j["M"],wp=j["precision"],mu,L,rho,b,p,a,bp,mid,vlo,vhi,vlarge,h,repair,caplog},mu=x/.FindRoot[x==1+Exp[-x],{x,N[5/4,wp+30]},WorkingPrecision->wp+30];L=N[Log[n],wp+30];rho=Sqrt[L/n];b=Sqrt[mu/(2m)];p=b/rho;a=Sqrt[mu]+Sqrt[2mu m]+1;bp=x/.FindRoot[p(1-Exp[-x/p])==1+Exp[-x],{x,N[mu+mu/(2p),wp+20]},WorkingPrecision->wp+10];mid[u_]:=n bp+m p L+(p-1)u-(n-1)Log[1+u];vlo=mid[a rho];vhi=mid[Sqrt[n]];vlarge=m L+n Log[4]-LogGamma[n]+(n-1)(Log[Sqrt[n]+n Log[2]+m L]-Log[1+Sqrt[n]]);h=Max[vlo,vhi,vlarge]+Log[Exp[Max[vlo,vhi]-Max[vlo,vhi,vlarge]]+Exp[vlarge-Max[vlo,vhi,vlarge]]];repair=-n Log[1-2n^-m];caplog=a rho-Log[1-2n^-m];<|"N"->n,"M"->m,"precision"->wp,"bp"->ToString[N[bp,40],InputForm],"bp_root_residual"->ToString[N[Abs[p(1-Exp[-bp/p])-1-Exp[-bp]],20],InputForm],"H_log"->ToString[N[h,40],InputForm],"normalized_H"->ToString[N[(h-n mu)/Sqrt[n L],35],InputForm],"repair_log_cost"->ToString[N[repair,40],InputForm],"repaired_cap_log"->ToString[N[caplog,35],InputForm],"numeric"->TrueQ[p>1&&a rho<Sqrt[n]&&repair<=4n^(1-m)&&Abs[p(1-Exp[-bp/p])-1-Exp[-bp]]<10^(-Floor[wp/2])]|>];
jobs73=Flatten[Table[<|"N"->2^k,"M"->m,"precision"->wp|>,{k,5,20},{m,{2,3,4}},{wp,{60,120}}],2];LaunchKernels[12];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[loc73];start73=AbsoluteTime[];rows73=ParallelMap[loc73,jobs73,Method->"FinestGrained"];CloseKernels[];Export[FileNameJoin[{out73,"localize73.json"}],<|"version"->$Version,"workers"->12,"seconds"->N[AbsoluteTime[]-start73],"rows"->rows73|>,"RawJSON"];If[!AllTrue[rows73,TrueQ[#["numeric"]]&],Print["FAIL"];Exit[3]];Print["PASS ",Length[rows73]," high precision localization bounds"];
