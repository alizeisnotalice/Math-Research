args=Rest[$ScriptCommandLine];If[Length[args]<2,Print["Need inputs.json output-directory"];Exit[2]];specs68=Import[args[[1]],"RawJSON"]["mixed"];out68=args[[2]];If[!DirectoryQ[out68],CreateDirectory[out68,CreateIntermediateDirectories->True]];
ClearAll[post68,beta68,one68,mix68];
post68[n_,s_,c_,wp_]:=Module[{k,g,logs,w},k=Range[0,Min[n,Ceiling[s/c]-1]];g=s-c k;logs=N[Log[Binomial[n,k]],wp]+(n-1)Log[g];w=Exp[logs-Max[logs]];w=w/Total[w];<|"n"->n,"s"->s,"c"->c,"K"->k,"G"->g,"W"->w|>];
beta68[x_,n_,om_,K_,wp_]:=Module[{term=I(n-1)/x,S,D,j=1,ep},S=term;D=term;While[j<n-1,term=term(n-1-j)/(I x);S+=term;D+=(j+1)term;j++];ep=-Exp[I x]term;S+=ep;D+=(n-1-I x)ep;{S,-om D/x}];
one68[P_,T_,U_,wp_]:=Module[{n=P["n"],s=P["s"],c=P["c"],k=P["K"],g=P["G"],w=P["W"],om,a,pairs,bb,bs,ds,ms,phase},om=T-U;a=1-k/n+k/n Exp[I om c];pairs=MapThread[beta68[#1,n,om,#2,wp]&,{om g,k}];bb=pairs[[All,1]];bs=pairs[[All,2]];ds=(n-1)/g;ms=w.ds;phase=Exp[I U s];{phase w.(a bb),I U phase w.(a bb)+phase w.((ds-ms)a bb+a bs)}];
mix68[job_,override_:Automatic]:=Module[{b=job["b"],q=2^job["q_power"],wp=job["precision"],c,s,p,r,main,face,T,U,phase,A,As,fc,fcs,dc,mixed,target,rat,plus,minus,fd,err},c=N[5/4,wp];s=If[override===Automatic,3c/2,N[override,wp]];p=post68[b,s,c,wp];r=post68[b-1,s-c,c,wp];T=(b-1)q;U=-q;main=one68[p,T,U,wp];face=one68[r,T,U,wp];phase=Exp[I q(b c-s)];A=(b-1)p["W"].(p["K"]/p["G"]);As=(b-1)((b-2)p["W"].(p["K"]/p["G"]^2)-(b-1)(p["W"].(1/p["G"]))(p["W"].(p["K"]/p["G"])));fc=(phase+(b-1)Exp[-I q c]face[[1]])/b;fcs=(-I q phase+(b-1)Exp[-I q c]face[[2]])/b;dc=A(main[[1]]-fc);mixed=As(main[[1]]-fc)+A(main[[2]]-fcs);target=I q A/b phase;rat=mixed/target;err=Null;If[override===Automatic&&wp==120,plus=ToExpression[mix68[job,15/8+2^-80]["raw_action"]];minus=ToExpression[mix68[job,15/8-2^-80]["raw_action"]];fd=(plus-minus)/(2*2^-80);err=Abs[(fd-mixed)/target]];<|"finite_difference_relative_error"->If[err===Null,Null,ToString[N[err,25],InputForm]],"raw_action"->ToString[N[dc,wp-10],InputForm],"raw_mixed"->ToString[N[mixed,wp-10],InputForm],"b"->b,"q_power"->job["q_power"],"precision"->wp,"c"->"5/4","s"->"15/8","A_over_b"->ToString[N[A/b,35],InputForm],"mixed_abs"->ToString[N[Abs[mixed],35],InputForm],"relative_leading_error"->ToString[N[Abs[rat-1],35],InputForm],"normalized_mixed"->ToString[N[rat,35],InputForm],"normalized_action"->ToString[N[dc/(-A/b phase),35],InputForm],"numeric"->TrueQ[NumberQ[rat]&&NumberQ[dc]&&A>0&&If[err===Null,True,err<10^-30]]|>];
LaunchKernels[12];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[post68,beta68,one68,mix68];start68=AbsoluteTime[];rows68=ParallelMap[mix68,specs68,Method->"FinestGrained"];CloseKernels[];Export[FileNameJoin[{out68,"mixed68.json"}],<|"version"->$Version,"workers"->12,"seconds"->N[AbsoluteTime[]-start68],"rows"->rows68,"scope"->"Exact finite Beta integration-by-parts polynomial including endpoint; no posterior truncation; numerical floating evaluation, no directed certificate"|>,"RawJSON"];If[!AllTrue[rows68,TrueQ[#["numeric"]]&],Exit[3]];Print["PASS ",Length[rows68]," mixed cases"];
