$endpoint44LibraryMode=True;Get[FileNameJoin[{DirectoryName[$InputFileName],"endpoint44.wl"}]];$endpoint44LibraryMode=False;
setWP44[n_,factor_:1]:=(wp44=factor Max[120,2IntegerLength[n,10]+120];mu44=N[1+ProductLog[1/E],wp44+80];g44=(mu44-1)/8;cQ44=(9-mu44)/24;cR44=(3+mu44)/12;Quiet[Unset[z44[n]],Unset::norep]);
argsV44=$ScriptCommandLine;outV44=If[Length[argsV44]>=2,argsV44[[2]],"/tmp/verify44.json"];
crossV44={};Do[setWP44[n];co=N[cQ44+g44+1/10,wp44+20];ex=exact44[n,co];ft=fourier44[n,co,1/16,32];row=<|"N"->n,"C"->N[co,18],"density_relative_difference"->ToString[(ft["f"]-ex["f"])/ex["f"],InputForm],"scaled_payoff_difference"->ToString[(ft["v_minus_one"]-ex["v_minus_one"])/(ex["f"]Log[n]),InputForm],"J_over_f_logN_difference"->ToString[(ft["J_over_f"]-ex["J_over_f"])/Log[n],InputForm]|>;AppendTo[crossV44,row];Print[row],{n,{256,1024}}];
refineV44={};Do[setWP44[n];co=N[cQ44+g44+1/10,wp44+20];base=fourier44[n,co,1/8,If[n>=2^512,32,24]];wpBase=wp44;setWP44[n,2];fine=fourier44[n,co,1/16,If[n>=2^512,40,32]];l=Log[n];row=<|"N_exact"->ToString[n,InputForm],"base_Fourier_cutoff"->If[n>=2^512,32,24],"fine_Fourier_cutoff"->If[n>=2^512,40,32],"base_working_precision"->wpBase,"doubled_working_precision"->wp44,"density_relative_difference"->ToString[(fine["f"]-base["f"])/fine["f"],InputForm],"scaled_payoff_difference"->ToString[(fine["v_minus_one"]-base["v_minus_one"])/(fine["f"]l),InputForm],"J_over_f_logN_difference"->ToString[(fine["J_over_f"]-base["J_over_f"])/l,InputForm],"fine_scaled_payoff"->N[fine["v_minus_one"]/(fine["f"]l),18],"fine_J_over_f_logN"->N[fine["J_over_f"] /l,18]|>;AppendTo[refineV44,row];Print[KeyTake[row,{"N_exact","base_working_precision","doubled_working_precision","fine_scaled_payoff"}]],{n,{2^128,2^1024}}];
Clear[c,m,eta,cc,eps,dd,nn,xx,ss];cg=-Log[1-eta]+Log[1+Exp[(eta-1)c]]-Log[1+Exp[-c]];
redV44[ex_]:=FullSimplify[Together[ex/.c->m]/.Table[Exp[k m]->(m-1)^(-k),{k,1,6}],Assumptions->m>1];
meanV=redV44[D[cg,eta]/.eta->0];varV=redV44[D[cg,{eta,2}]/.eta->0];thirdV=redV44[D[cg,{eta,3}]/.eta->0];
phiV=Piecewise[{{Exp[xx-ss],xx<ss}},1+(xx-ss)/nn];rhsV=1+(xx-ss)/nn-Piecewise[{{1,xx<ss}},0]+Piecewise[{{Exp[xx-ss],xx<ss}},0]+Max[ss-xx,0]/nn;
checksV44=<|"mean_mu"->meanV,"mean_first_derivative_mu"->redV44[D[D[cg,eta]/.eta->0,c]],"mean_second_derivative_mu"->redV44[D[D[cg,eta]/.eta->0,{c,2}]],"variance_mu"->varV,"variance_first_derivative_mu"->redV44[D[D[cg,{eta,2}]/.eta->0,c]],"third_cumulant_residual"->FullSimplify[thirdV-m(3-m),Assumptions->m>1],"cQ_identity_residual"->FullSimplify[(3-m)/6+(m-1)/8-(9-m)/24],"cR_identity_residual"->FullSimplify[(9-m)/24+(m-1)/8-(3+m)/12],"variance_compensation_residual"->Expand[-(m-1)/4+2(m-1)/8],"final_margin_identity_residual"->Expand[((9-m)/24+(m-1)/8+eps)-(9-m)/24-(1+dd)(m-1)/8-(eps-dd(m-1)/8)],"pointwise_finite_payoff_identity"->FullSimplify[phiV-rhsV,Assumptions->nn>0&&Element[{xx,ss},Reals]],"shortfall_sign_single_point"->FullSimplify[(phiV-rhsV)/.{xx->0,ss->3,nn->10}]|>;
Export[outV44,<|"wolfram"->$Version,"status"->"independent finite-mixture/Fourier and doubled-precision checks, exact endpoint constants; no interval certificate","mixture_cross_checks"->crossV44,"precision_and_cutoff_refinements"->refineV44,"exact_checks"->Map[If[NumberQ[#]||MemberQ[{True,False},#],#,ToString[#,InputForm]]&,checksV44]|>,"RawJSON"];Print[checksV44];
