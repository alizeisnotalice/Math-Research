argsO75=Rest[$ScriptCommandLine];outO75=argsO75[[1]];If[!DirectoryQ[outO75],CreateDirectory[outO75,CreateIntermediateDirectories->True]];ClearAll[op75];
op75[j_]:=Module[{n=j["N"],wp=j["precision"],off=j["offset"],mu,rho,cr,rr,ell0,l0,H,delta,eta=1/20,B=1/20,d,x,center,root,expected,X,err},mu=t/.FindRoot[t==1+Exp[-t],{t,N[5/4,wp+30]},WorkingPrecision->wp+30];rho=Sqrt[Log[n]/n];cr=mu-Sqrt[mu]rho/2;rr=Exp[-cr];ell0=1+rr;l0=-rr;H=2rho;delta=rr rho/(8(1+rr));d=B ell0 H/(ell0-2H);x=1+off delta;
 center[c_?NumericQ]:=Module[{ell=x(1+Exp[-c]),a},a=x-ell;(eta(l0+H-a)+B(H^2-(a-l0)^2)/2+(eta-d)(ell0-2H)+(eta+B ell0)(x-1+H)+B((x-1)^2-H^2)/2)/ell];root=t/.FindRoot[center[t]-(eta+B(-x Exp[-t]-l0))==0,{t,N[cr,wp+20]},WorkingPrecision->wp+10];expected=-Log[ell0/x-1];X=x(1+Exp[-root])/(1+rr);err=Abs[root-expected];<|"N"->n,"offset"->N[off],"precision"->wp,"c_optimizer"->ToString[N[root,35],InputForm],"reanchored_receiver"->ToString[N[X,35],InputForm],"root_formula_error"->ToString[N[err,20],InputForm],"tensor_log_cap_upper"->ToString[N[n Log[1+(eta+B(ell0+H))/n],35],InputForm],"receiver_log_min_average"->ToString[N[n Log[1+(eta-B delta)/n],35],InputForm],"numeric"->TrueQ[err<10^(-Floor[wp/2])&&Abs[X-1]<10^(-Floor[wp/2])&&cr-rho<root<cr+rho]|>];
ll75=1-ee0;dd75=bb ee0 hh/(ee0-2hh);aa75=xx-ee;ii75=aa(l75+hh-aa75)+bb(hh^2-(aa75-l75)^2)/2+(aa-dd75)(ee0-2hh)+(aa+bb ee0)(xx-1+hh)+bb((xx-1)^2-hh^2)/2/.l75->1-ee0;symbolO75=Together[ii75/ee-(aa+bb(xx-1)-bb(ee-ee0)^2/(2ee))]===0;
jobsO75=Flatten[Table[<|"N"->n,"offset"->o,"precision"->wp|>,{n,{1024,4096,16384,65536,262144,1048576}},{o,{-1,-1/2,0,1/2,1}},{wp,{60,120}}],2];LaunchKernels[12];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[op75];startO75=AbsoluteTime[];rowsO75=ParallelMap[op75,jobsO75,Method->"FinestGrained"];CloseKernels[];Export[FileNameJoin[{outO75,"optimizer75.json"}],<|"version"->$Version,"workers"->12,"seconds"->N[AbsoluteTime[]-startO75],"rows"->rowsO75,"symbolic_piecewise_integral_identity"->symbolO75|>,"RawJSON"];If[!symbolO75||!AllTrue[rowsO75,TrueQ[#["numeric"]]&],Print["FAIL"];Exit[3]];Print["PASS ",Length[rowsO75]," optimizing selector checks and symbolic source integral"];
