(* Explicit inputs.json, output directory, optional worker count. *)
args=Rest[$ScriptCommandLine];If[Length[args]<2,Print["Need inputs.json and output directory"];Exit[2]];
in67=Import[args[[1]],"RawJSON"];out67=args[[2]];If[!DirectoryQ[out67],CreateDirectory[out67,CreateIntermediateDirectories->True]];
workers67=If[Length[args]>=3,ToExpression[args[[3]]],12];
ClearAll[momentR67];
momentR67[sp_]:=Module[{b=sp[[1]],factor=sp[[2]],wp,bb,J,ER,scaled,start},start=AbsoluteTime[];wp=factor(2Ceiling[Log[10,b]]+100);bb=N[b,wp];J[p_]:=Exp[Log[Sqrt[Pi]/2]+LogGamma[(p-1)/2]-LogGamma[p/2]];ER=bb J[bb-1]-(bb-1)J[bb];scaled=Sqrt[bb]ER;<|"b"->ToString[b],"precision"->wp,"factor"->factor,"positive"->TrueQ[ER>0],"output_precision"->N[Precision[scaled]],"sqrt_b_ER2"->ToString[N[scaled,35],InputForm],"ER2"->ToString[N[ER,35],InputForm],"seconds"->N[AbsoluteTime[]-start]|>];
checks=<|"small_h"->FullSimplify[(1+Sqrt[2])(1-1/Sqrt[1+x^2])-x^2/Sqrt[1+x^2]>=0,Assumptions->0<=x<=1],"large_h"->FullSimplify[(1+Sqrt[2])(1-1/Sqrt[1+x^2])-x/Sqrt[1+x^2]>=0,Assumptions->x>=1],"limit_integral"->FullSimplify[Integrate[(1+t^2/2)Exp[-t^2/2],{t,0,Infinity}]==3Sqrt[2Pi]/4],"b3_exact"->FullSimplify[3 Integrate[(1+t^2)^-1,{t,0,Infinity}]-2 Integrate[(1+t^2)^(-3/2),{t,0,Infinity}]==3Pi/2-2],"Phi_second_derivative"->FullSimplify[D[h(1+Log[h])^(nn-1),{h,2}]==(nn-1)(nn-1+Log[h])(1+Log[h])^(nn-3)/h,Assumptions->h>1&&nn>=2&&Element[nn,Integers]],"finiteV_map"->FullSimplify[(V+s)(V x+z)/(V+s)-(V+s)/bb-(V x-V/bb)-(z-s/bb)==0,Assumptions->V>0&&s>0&&bb>0],"Jacobian"->FullSimplify[V^(bb-1)((V+s)/V)^(bb-1)==(V+s)^(bb-1),Assumptions->V>0&&s>0&&bb>=2&&Element[bb,Integers]],"box_log_modular_ratio_limit"->TrueQ[Limit[(nn-1)Log[1+Log[1+nn^-2]],nn->Infinity]==0],"singleton_left"->TrueQ[FullSimplify[(1-Boole[s>c])/(1+Boole[s>c]),Assumptions->s>c>0]==0],"singleton_right"->TrueQ[FullSimplify[(1-Boole[s>c])/(1+Boole[s>c]),Assumptions->c>s>0]==1]|>;
specs=({ToExpression[#["b"]],#["factor"]}&/@in67["interval"]);
LaunchKernels[workers67];DistributeDefinitions[momentR67];start=AbsoluteTime[];rows=ParallelMap[momentR67,specs,Method->"FinestGrained"];
Export[FileNameJoin[{out67,"interval67.json"}],<|"version"->$Version,"workers"->$KernelCount,"seconds"->N[AbsoluteTime[]-start],"checks"->checks,"rows"->rows,"limit"->ToString[N[3Sqrt[2Pi]/4,35],InputForm],"scope"->"Exact order-statistic formula evaluated numerically; uniform lemma proved analytically. Large-b correction below working-precision resolution is not reported."|>,"RawJSON"];CloseKernels[];
If[!AllTrue[Values[checks],TrueQ]||!AllTrue[rows,TrueQ[#["positive"]]&&#["output_precision"]>40&],Print["Symbolic/precision check failed"];Exit[3]];Print["Completed interval67.wl"];
