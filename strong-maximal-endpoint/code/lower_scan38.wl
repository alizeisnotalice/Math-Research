(* r038 mixed-source quadratic-template score scan, n=64. *)
root=DirectoryName[$InputFileName];args=$ScriptCommandLine;repo=DirectoryName[root];seedFile=If[Length[args]>=3,args[[3]],FileNameJoin[{repo,"rounds","r030","receiver_seed.json"}]];out=If[Length[args]>=2,args[[2]],FileNameJoin[{$TemporaryDirectory,"lower_scan38.json"}]];
$r032LibraryMode=True;Block[{$ScriptCommandLine={"lower_scan38.wl",seedFile}},Get[FileNameJoin[{repo,"code","receiver_continuous32.wl"}]]];$r032LibraryMode=False;
c0=c;u=Join[{{0.,0.}},Transpose[{Rest[dd]+Rest[vv],Rest[dd]-Rest[vv]}],Transpose[{Rest[dd]-Rest[vv],Rest[dd]+Rest[vv]}]];lo=Min[u];hi=Max[u]+b mz+16.Sqrt[b vz];
pts[j_]:=If[j==1,{u[[1]]},{u[[j]],u[[j+ng-1]]}];
mixAmp[t1_,cs_,sc_]:=Module[{aa=ConstantArray[0.,2ng-1],z},Do[Do[aa[[If[j==1,1,If[z===pts[j][[1]],j,j+ng-1]]]]=sc w0[[j]]polyC[t1-z[[1]],cs[[j]] ]Exp[z[[1]]+z[[2]]-tau],{z,pts[j]}],{j,ng}];aa];
likeM[t2_,aa_,cs_]:=Module[{s=aa[[1]]polyC[t2-u[[1,2]],cs[[1]]],j},Do[s+=aa[[j]]polyC[t2-u[[j,2]],cs[[j]]]+aa[[j+ng-1]]polyC[t2-u[[j+ng-1,2]],cs[[j]]],{j,2,ng}];s];
bd[lev_,aa_,cs_]:=Module[{l=lo,r=hi,m},If[likeM[l,aa,cs]>=lev,Return[l]];If[likeM[r,aa,cs]<=lev,Return[r]];Do[m=(l+r)/2.;If[likeM[m,aa,cs]<lev,l=m,r=m],{43}];(l+r)/2.];
pv[t1_,t2_,cs_]:=Module[{av=ConstantArray[0.,ng],z,q1,q2},Do[Do[q1=polyC[t1-z[[1]],cs[[j]]];q2=polyC[t2-z[[2]],cs[[j]]];av[[j]]+=q1 q2 Exp[z[[1]]+z[[2]]-t1-t2],{z,pts[j]}],{j,ng}];av];
cp[t1_,l_,r_,h_,cs_]:=Module[{cost=0.,av=ConstantArray[0.,ng],z,fac},If[r<=l,Return[{cost,av}]];cost=Exp[tau-t1](Exp[-l]-Exp[-r])phi[h];Do[Do[fac=polyC[t1-z[[1]],cs[[j]]]Exp[z[[1]]-t1];av[[j]]+=fac(gbcdfC[r-z[[2]],cs[[j]]]-gbcdfC[l-z[[2]],cs[[j]]]),{z,pts[j]}],{j,ng}];{cost,av}];
sp[t1_,l_,r_,aa_,cs_,ord_]:=Module[{x,wt,h,cost=0.,av=ConstantArray[0.,ng]},If[r<=l,Return[{cost,av}]];{x,wt}=quad[ord,l,r];Do[h=profile[likeM[x[[i]],aa,cs]];cost+=wt[[i]]Exp[tau-t1-x[[i]]]phi[h];av+=wt[[i]]h pv[t1,x[[i]],cs],{i,Length[x]}];{cost,av}];
cv[uu_]:=Module[{s=SortBy[uu,First],xx,best,tot=0.,i},xx=DeleteDuplicates[s[[All,1]]];Do[best=Min[Select[s,#[[1]]<=xx[[i]]&][[All,2]]];tot+=(Exp[-xx[[i]]]-If[i<Length[xx],Exp[-xx[[i+1]]],0.])Exp[-best],{i,Length[xx]}];tot];
run[h_,sc_,no_:64,ord_:32]:=Module[{cs=c0+h(vv/16.)^2,tx,tw,aa,roots,z,a,cost=0.,av=ConstantArray[0.,ng],ids,an,vol},{tx,tw}=outerQuad[no];Do[aa=mixAmp[tx[[i]],cs,sc];roots=bd[#,aa,cs]&/@{1.,N[n],phiPrime};{z,a}=cp[tx[[i]],roots[[1]],roots[[2]],1.,cs];cost+=tw[[i]]z;av+=tw[[i]]a;{z,a}=cp[tx[[i]],roots[[3]],hi,cap,cs];cost+=tw[[i]]z;av+=tw[[i]]cap a;{z,a}=sp[tx[[i]],roots[[2]],roots[[3]],aa,cs,ord];cost+=tw[[i]]z;av+=tw[[i]]a,{i,Length[tx]}];ids=Flatten@Position[av/coeff,_?(#>1.00001&)];an=Flatten[Table[pts[j],{j,ids}],1];vol=If[Length[an]>0,cv[an],0.];<|"h"->h,"source_scale"->sc,"outer_nodes"->no,"soft_order"->ord,"scaled_cost"->cost,"actual_logJ"->Log[cost]-tau,"min_average"->Min[av/coeff],"accepted_group_count"->Length[ids],"accepted_cone_volume"->vol,"accepted_cone_log_score"->If[vol>0,Log[vol]-(Log[cost]-tau),-Infinity]|>];
hs={-.10,-.025,.025,.075,.15};scales={1.025,1.030,1.035};rows=Flatten[Table[run[h,sc],{h,hs},{sc,scales}],1];best=First@Ordering[rows[[All,"accepted_cone_log_score"]],-1];validations={<|"case"->"best_score","N128_soft32"->run[.15,1.025,128,32]|>,<|"case"->"threshold_bracket","N128_soft32"->run[.025,1.030,128,32]|>};res=<|"status"->"r038 mixed-source quadratic c-template scan, floating direct quadrature","n"->n,"outer_nodes"->64,"soft_order"->32,"rows"->rows,"best_by_score"->rows[[best]],"targeted_N128_soft32_validations"->validations,"scalar_reference_log_score"->71.71499208794934,"selection"->"accepted-cone score, not min average"|>;Export[out,res,"RawJSON"];Print[res["best_by_score"]];
