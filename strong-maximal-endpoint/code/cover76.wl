argsG76=Rest[$ScriptCommandLine];outG76=argsG76[[1]];If[!DirectoryQ[outG76],CreateDirectory[outG76,CreateIntermediateDirectories->True]];ClearAll[grid76];grid76[j_]:=Module[{n=j["N"],k=j["K"],wp=j["precision"],mu,beta,rho,cr,rp,rm,amax,be,q},mu=x/.FindRoot[x==1+Exp[-x],{x,N[5/4,wp+30]},WorkingPrecision->wp+30];beta=mu-1-Log[mu];rho=Sqrt[Log[n]/n];cr=mu-Sqrt[mu]rho/2;rp=Exp[-(cr-k rho)];rm=Exp[-(cr+k rho)];amax=(Exp[beta](1+rm)-1)/rp;be=Log[(1+(21/20)rp)/(1+rm)];q=x/.FindRoot[x-Log[1+x]==be,{x,N[Sqrt[2be]+2be,wp+20]},WorkingPrecision->wp+20];<|"N"->n,"K"->N[k],"precision"->wp,"maximum_grid_ratio_at_leading_frontier"->ToString[N[amax,35],InputForm],"leading_Hardy_charge_per_dimension"->ToString[N[1+q,35],InputForm],"frontier_identity_residual"->ToString[N[Abs[Log[(1+amax rp)/(1+rm)]-beta],20],InputForm],"numeric"->TrueQ[amax>0&&Abs[q-Log[1+q]-be]<10^(-Floor[wp/2])]|>];
