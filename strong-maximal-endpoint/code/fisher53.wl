(* Finite-window numerical diagnostics for the exact r053 response bounds. *)
f53Dir=DirectoryName[$InputFileName];f53Args=$ScriptCommandLine;
f53Repo=SelectFirst[{DirectoryName[f53Dir],FileNameJoin[{DirectoryName[DirectoryName[DirectoryName[f53Dir]]],"Math-Research-strong-maximal","strong-maximal-endpoint"}]},FileExistsQ[FileNameJoin[{#,"code","primal52.wl"}]]&];
Block[{$primal52LibraryMode=True},Get[FileNameJoin[{f53Repo,"code","primal52.wl"}]]];
mu53=N[1+ProductLog[1/E]];
probeF53[bb_,cc_,nn_]:=Module[{p=1/(1+Exp[cc]),m,v,hi,edges,gl,tx={},tw={},j=jetBuild52[bb,N[cc]],vals,ff,sc,kk,mass,es,info,mx},m=1+cc p;v=1+cc^2p(1-p);hi=bb m+16Sqrt[bb v];edges=Sort@DeleteDuplicates@Join[Subdivide[0.,hi,Ceiling[nn/16.]],Select[N[cc Range[bb]],0.<#<hi&]];gl=GL52[16];Do[tx=Join[tx,(edges[[i]]+edges[[i+1]])/2+(edges[[i+1]]-edges[[i]])gl[[1]]/2];tw=Join[tw,(edges[[i+1]]-edges[[i]])gl[[2]]/2],{i,Length[edges]-1}];vals=j/@tx;ff=expSafe52/@(vals[[All,5]]-tx);sc=vals[[All,2]];kk=vals[[All,4]];mass=tw.ff;es=tw.(ff sc);info=tw.(ff sc^2);mx=Max[ff/kk];<|"outer_nodes"->Length[tx],"window"->{0.,hi},"mass"->mass,"score_mean"->es,"Fisher_finite_window"->info,"push_density_grid_max"->mx,"push_density_grid_max_times_sqrt_b"->mx Sqrt[bb],"normalization_denominator"->(1+bb(cc-mu53)^2)^2,"Fisher_over_bound_scale"->info/(1+bb(cc-mu53)^2)^2|>];
If[!TrueQ[$fisher53LibraryMode],out53=If[Length[f53Args]>=2,f53Args[[2]],"/tmp/fisher53.json"];rows53={};Do[cc53=Switch[label53,"mu",mu53,"refined",crit52[2bb53],"moderate",mu53-Sqrt[Log[2bb53]/bb53]/2];r1=probeF53[bb53,cc53,512];r2=probeF53[bb53,cc53,1024];AppendTo[rows53,<|"b"->bb53,"N"->2bb53,"parameter_label"->label53,"c"->cc53,"coarse"->r1,"fine"->r2,"Fisher_refinement_change"->r2["Fisher_finite_window"]-r1["Fisher_finite_window"]|>];Export[out53,<|"wolfram"->$Version,"rows"->rows53,"scope"->"finite-window machine quadrature and grid maxima; numerical diagnostics, not rigorous Fisher or push-density certificates; theorem proved separately"|>,"RawJSON"],{bb53,{4,8,16,32,64,128,256,512}},{label53,{"mu","refined","moderate"}}];Print[<|"rows"->Length[rows53],"max_Fisher_change"->Max[Abs[Lookup[rows53,"Fisher_refinement_change"]]]|>]];
