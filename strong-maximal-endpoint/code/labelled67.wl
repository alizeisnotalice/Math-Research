(* Explicit inputs.json, output directory, optional worker count. *)
args=Rest[$ScriptCommandLine];If[Length[args]<2,Print["Need inputs.json and output directory"];Exit[2]];
in67=Import[args[[1]],"RawJSON"];out67=args[[2]];If[!DirectoryQ[out67],CreateDirectory[out67,CreateIntermediateDirectories->True]];
workers67=If[Length[args]>=3,ToExpression[args[[3]]],12];
ClearAll[label67];
label67[spec_,setup_:Automatic]:=Module[{b=spec[[1]],mode=spec[[2]],shift=spec[[3]],ref=spec[[4]],wp,mu,c,z,s,th,a,p,m,v,r,groups,zero,sc,lg,h,cut,js,tau,base,Dbase,Ln,Sn,num,I0,I1,D0,D1,cf,der,threshold,delta,pruned,err0,err1,start,DS0,DS1,radial,errS},
start=AbsoluteTime[];wp=2Ceiling[Log[10,b]]+90+If[ref==1,50,0];If[setup===Automatic,mu=cc/.FindRoot[cc==1+Exp[-cc],{cc,N[5/4,wp]},WorkingPrecision->wp];z=zz/.FindRoot[Erfc[zz/Sqrt[2]]/2==Sqrt[mu/b]zz,{zz,N[Sqrt[Log[b]],wp]},WorkingPrecision->wp];s=b mu-Sqrt[mu b]z;c=mu+shift Sqrt[Log[N[b,wp]]/b];th=tt/.FindRoot[1/(1-tt)+c/(1+Exp[c(1-tt)])==s/b,{tt,-N[z/Sqrt[mu b],wp]},WorkingPrecision->wp];a=1-th;r=Exp[-a c];p=r/(1+r);m=1/a+c p;v=1/a^2+c^2 p(1-p);
,c=N[setup[[1]],wp];a=N[setup[[2]],wp];th=1-a;r=Exp[-a c];p=r/(1+r);m=1/a+c p;v=1/a^2+c^2 p(1-p);s=b m;];
groups=Switch[mode,1,{{1,0,-1},{b-1,0,1}},2,{{2,0,-1},{b-2,0,1}},3,{{8,0,-1},{b-8,0,1}},4,{{b/2,0,-1},{b/2,0,1}},5,{{b,0,-1}},6,{{4,Pi/c,-1},{4,-Pi/c,-1},{b-8,0,1}},7,{{b/4,Pi/c,-1},{b/4,-Pi/c,-1},{b/2,0,1}},8,{{1,Sqrt[N[b,wp]],-1},{b-1,-Sqrt[N[b,wp]]/(b-1),1}},9,{{1,0,-1},{1,1,1},{1,-1,1},{b-3,0,1}}];
lg[x_,eps_]:=-Log[1-I x/a]+Log[1+eps r Exp[I c x]]-Log[1+r]-I m x;
sc[x_,eps_]:=a p+eps r Exp[I c x](-a+I x)/(1+eps r Exp[I c x]);
h=If[ref==1,1/16,1/8];cut=If[ref==1,40,32];js=N[Range[-cut/h,cut/h]h,wp];tau=js/Sqrt[b v];base=Exp[b lg[tau,1]];Dbase=base b sc[tau,1];
Ln=Total[(#[[1]]lg[tau+#[[2]],#[[3]]])&/@groups];Sn=Total[(#[[1]]sc[tau+#[[2]],#[[3]]])&/@groups];delta=N[10^(-wp-50)/b^3,wp];threshold=Log[delta];num=If[Re[#]<threshold,0,Exp[#]]&/@Ln;pruned=Count[num,0];I0=Total[base]h;I1=Total[num]h;D0=Total[Dbase]h;D1=Total[num Sn]h;cf=I1/I0;der=(D1 I0-I1 D0)/I0^2;DS0=Total[-I tau base]h;DS1=Total[-I tau num]h;radial=(DS1 I0-I1 DS0)/I0^2;err0=delta h pruned/Abs[I0];err1=delta h pruned(Max[Abs[Sn]]/Abs[I0]+Abs[D0]/Abs[I0]^2);errS=delta h pruned(Max[Abs[tau]]/Abs[I0]+Abs[DS0]/Abs[I0]^2);
<|"b"->ToString[b],"mode"->mode,"shift_over_rho"->shift,"refined"->ref,"precision"->wp,"CF"->ToString[N[cf,30],InputForm],"derivative"->ToString[N[der,30],InputForm],"derivative_abs"->ToString[N[Abs[der],30],InputForm],"radial_derivative"->ToString[N[radial,30],InputForm],"b_scaled_radial_abs"->ToString[N[b Abs[radial],30],InputForm],"radial_discrete_pruning_bound"->ToString[N[errS,20],InputForm],"normal_root_residual"->If[setup===Automatic,ToString[N[Abs[Erfc[z/Sqrt[2]]/2-Sqrt[mu/b]z],20],InputForm],Null],"setup_kind"->If[setup===Automatic,"critical_root","explicit_mean_tilt"],"critical_shift_applicable"->(setup===Automatic),"c_value"->ToString[N[c,25],InputForm],"gamma_value"->ToString[N[a,25],InputForm],"tilt_mean_residual"->ToString[N[Abs[m-s/b],20],InputForm],"normalizer_imaginary_residual"->ToString[N[Abs[Im[I0]],20],InputForm],"root_tolerance"->ToString[10^(-Floor[wp/2]+10),InputForm],"root_checks_pass"->TrueQ[Abs[m-s/b]<10^(-Floor[wp/2]+10)&&If[setup===Automatic,Abs[Erfc[z/Sqrt[2]]/2-Sqrt[mu/b]z]<10^(-Floor[wp/2]+10),True]],"numeric"->And@@(NumberQ/@{cf,der,radial}),"pruned_nodes"->pruned,"CF_discrete_pruning_bound"->ToString[N[err0,20],InputForm],"derivative_discrete_pruning_bound"->ToString[N[err1,20],InputForm],"frequency_sum_residual"->ToString[N[Abs[Total[#[[1]]#[[2]]&/@groups]],20],InputForm],"seconds"->N[AbsoluteTime[]-start]|>];
jobs=Join[Join[#,<|"regime"->"critical"|>]&/@in67["fourier"],Join[#,<|"regime"->"macro"|>]&/@Lookup[in67,"macro",{}]];
LaunchKernels[workers67];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[label67];start=AbsoluteTime[];
rows=ParallelMap[Function[j,Module[{row,id,b=ToExpression[j["b"]]},If[j["regime"]==="critical",row=label67[{b,j["mode"],j["shift"],j["refined"]}];id="C|"<>j["b"]<>"|"<>ToString[j["mode"]]<>"|"<>ToString[j["shift"]],row=label67[{b,j["mode"],0,j["refined"]},{ToExpression[j["c"]],ToExpression[j["gamma"]]}];id="M|"<>j["b"]<>"|"<>ToString[j["mode"]]<>"|"<>j["c"]<>"|"<>j["gamma"]];Join[row,<|"case_id"->id|>]]],jobs,Method->"FinestGrained"];
If[AnyTrue[rows,!TrueQ[Lookup[#,"numeric",False]]||!TrueQ[Lookup[#,"root_checks_pass",False]]&],Print["Numeric/setup check failed"];CloseKernels[];Exit[3]];
Export[FileNameJoin[{out67,"labelled67.json"}],<|"version"->$Version,"workers"->$KernelCount,"seconds"->N[AbsoluteTime[]-start],"rows"->rows,"scope"->"Finite-pattern high-precision numerical evidence; critical roots or explicit mean-matched tilt. No directed total-error certificate."|>,"RawJSON"];CloseKernels[];Print["Completed labelled67.wl"];
