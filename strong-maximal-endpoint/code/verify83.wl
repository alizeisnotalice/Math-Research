a83=Rest[$ScriptCommandLine];input83=a83[[1]];old83=a83[[2]];out83=a83[[3]];If[!DirectoryQ[out83],CreateDirectory[out83,CreateIntermediateDirectories->True]];
ClearAll[mean83,scaled83,fen83,run83];
mean83[n_Integer,aa_Integer,b_?NumberQ,sg_,wp_Integer]:=Module[{rt=N[Sqrt[n],wp],top,ss,ii},top=Min[(aa-1)rt,(n-b)/rt+80];ss[w_?NumericQ]:=With[{l=Log[1+w/rt]},b Exp[((n-2)Log[1+l]+Log[n+l])/(n-1)]];ii=NIntegrate[GammaRegularized[n,ss[w]]/rt,Evaluate[Join[{w,0},Select[{1,2,4,8,16,32,64},#<top&],{top}]],WorkingPrecision->wp,AccuracyGoal->wp-22,PrecisionGoal->wp-22,MaxRecursion->20,Method->{"GlobalAdaptive","SymbolicProcessing"->0}];ii-GammaRegularized[n,0,b]+1-sg];
scaled83[n_Integer,aa_Integer,b_?NumberQ,wp_Integer]:=Module[{rt=N[Sqrt[n],wp],top,ee},top=Min[(aa-1)rt,(n-b)/rt+80];ee[w_?NumericQ]:=With[{l=Log[1+w/rt]},With[{v=(n-2)Log[1+l]+Log[n+l]},Exp[v-b(Exp[v/(n-1)]-1)]/rt]];1+NIntegrate[ee[w],Evaluate[Join[{w,0},Select[{1,2,4,8,16,32,64},#<top&],{top}]],WorkingPrecision->wp,AccuracyGoal->wp-22,PrecisionGoal->wp-22,MaxRecursion->20,Method->{"GlobalAdaptive","SymbolicProcessing"->0}]];
fen83[n_Integer,aa_Integer,q_?NumberQ,wp_Integer]:=Module[{rt=N[Sqrt[n],wp],top,ss},top=Min[(aa-1)rt,(n-q)/rt+80];ss[w_?NumericQ]:=With[{l=Log[1+w/rt]},q+l+(n-1)Log[1+l]];Exp[n Log[q]-q-LogGamma[n+1]]-GammaRegularized[n,0,q]+NIntegrate[GammaRegularized[n,ss[w]]/rt,Evaluate[Join[{w,0},Select[{1,2,4,8,16,32,64},#<top&],{top}]],WorkingPrecision->wp,AccuracyGoal->wp-22,PrecisionGoal->wp-22,MaxRecursion->20,Method->{"GlobalAdaptive","SymbolicProcessing"->0}]];
run83[z_]:=Catch[Module[{n=z["N"],aa=z["A"],big,prec,guess,rows={},zg,rr,u,b,cs,lk,qf,oldrow,wp,go,rt,top,st,meanTail,costTail,fb,rl,lcRelax,ds,lcder},big=n>2^20;prec=If[big,{90,180},{60,120}];Do[rt=N[Sqrt[n],wp];go=wp-Ceiling[Log[10,n]]-32;zg=x/.FindRoot[Erfc[x/Sqrt[2]]/2==x/rt,{x,N[Sqrt[Max[1,Log[n]-2Log[Log[n]]]],wp]},WorkingPrecision->wp,AccuracyGoal->wp-25,PrecisionGoal->wp-25];rr=rt Exp[-zg^2/2]/Sqrt[2Pi];u=(rr(zg^2-1)/3+3zg^2/2-Log[n])/(rr+1);guess=If[big,n-rt zg+u,N[Rationalize[z["activation"],0],wp]];
b=x/.FindRoot[mean83[n,aa,x,1,wp]==0,{x,guess-1/10,guess+1/10},WorkingPrecision->wp,AccuracyGoal->go,PrecisionGoal->go,MaxIterations->35];cs=scaled83[n,aa,b,wp];lk=b-Log[cs];
qf=If[big,x/.FindRoot[fen83[n,aa,x,wp]==0,{x,n-rt zg+zg^2/3+4/3-1/10,n-rt zg+zg^2/3+4/3+1/10},WorkingPrecision->wp,AccuracyGoal->go,PrecisionGoal->go,MaxIterations->35],oldrow=SelectFirst[prior83["rows"],#["N"]==n&&#["A"]==aa&];ToExpression[SelectFirst[oldrow["rows"],#["precision"]==wp&]["q"],InputForm]];
top=Min[(aa-1)rt,(n-b)/rt+80];st=b Exp[((n-2)Log[1+Log[1+top/rt]]+Log[n+Log[1+top/rt]])/(n-1)];fb=Exp[-b+(n-1)Log[b]-LogGamma[n]];meanTail=If[top<(aa-1)rt,(aa-1)GammaRegularized[n,st],0];costTail=If[top<(aa-1)rt,2aa(1+Log[aa])GammaRegularized[n,st]/(st fb),0];lcder=1/(fb cs);
If[aa==2&&!big,rl=x/.FindRoot[mean83[n,aa,x,1-1/n^2,wp]==0,{x,b,b+N[1/n,wp]},WorkingPrecision->wp,AccuracyGoal->go,PrecisionGoal->go,MaxIterations->35];lcRelax=rl-Log[scaled83[n,aa,rl,wp]],rl=Null;lcRelax=Null];
AppendTo[rows,<|"working_precision"->wp,"activation"->ToString[N[b,wp-10],InputForm],"log_true_corner_norm"->ToString[N[lk,wp-10],InputForm],"scaled_source_modular"->ToString[N[cs,wp-10],InputForm],"mean_residual"->ToString[N[mean83[n,aa,b,1,wp],40],InputForm],"mean_tail_upper"->ToString[N[meanTail,40],InputForm],"scaled_cost_tail_upper"->ToString[N[costTail,40],InputForm],"radial_Fenchel_q"->ToString[N[qf,wp-10],InputForm],"radial_Fenchel_gap"->ToString[N[qf-lk,60],InputForm],"constant_diagnostic"->ToString[N[lk-(n-rt zg)-zg^2/3,60],InputForm],"activation_refined_asymptotic_error"->ToString[N[b-(n-rt zg+u),50],InputForm],"threshold_log_norm_derivative_magnitude"->ToString[N[lcder,60],InputForm],"normalized_threshold_slope"->ToString[N[lcder rr/n,50],InputForm],"relaxed_log_norm"->If[lcRelax===Null,Null,ToString[N[lcRelax,wp-10],InputForm]],"relaxed_increment"->If[lcRelax===Null,Null,ToString[N[lcRelax-lk,60],InputForm]]|>],{wp,prec}];<|"N"->n,"A"->aa,"rows"->rows|>]];
phi83[t_]:=t(1+Log[t])^(nn-1);sb83=bb D[phi83[t],t]^(1/(nn-1));sp83=sb83(nn-1+Log[t])/(t(1+Log[t])(nn+Log[t]));
sym83=<|"s_height_derivative"->TrueQ[FullSimplify[D[sb83,t]==sp83,Assumptions->t>1&&nn>=2&&bb>0]],"s_derivative_decreasing"->TrueQ[FullSimplify[t D[Log[sp83],t]==-1-(nn-2)/((1+Log[t])(nn-1+Log[t])(nn+Log[t])),Assumptions->t>1&&nn>=2&&bb>0]],"cost_unimodal_log_derivative"->TrueQ[FullSimplify[D[Log[D[phi83[t],t]]-sb83,t]==D[Log[D[phi83[t],t]],t](1-sb83/(nn-1)),Assumptions->t>1&&nn>=2&&bb>0]],"KKT_middle_height_second_order"->TrueQ[FullSimplify[Coefficient[Normal[Series[Log[D[phi83[t],t]]/.t->1+y,{y,0,2}]],y,2]==-(nn-2)-1/(2nn)-1/(2nn^2),Assumptions->nn>=2]],"J_mean_derivative_identity"->TrueQ[FullSimplify[(Gamma[nn]/bb^(nn-1))(ss/bb)(Exp[-ss]ss^(nn-1)/Gamma[nn])==(ss/bb)(ss/bb)^(nn-1)Exp[-ss],Assumptions->ss>0&&bb>0&&nn>=2]]|>;
src83=Import[input83,"RawJSON"];prior83=Import[old83,"RawJSON"];jobs83=src83["rows"];certsrc83=Import[FileNameJoin[{DirectoryName[input83],"certificates83.json"}],"RawJSON"];
cache83=If[Length[a83]>=4&&FileExistsQ[a83[[4]]],Import[a83[[4]],"RawJSON"],<||>];cachedrows83=Select[Lookup[cache83,"rows",{}],AssociationQ];
dec83[s_String]:=Module[{p=StringSplit[StringReplace[s,"E"->"e"],"e"],ss,v,ee},ss=StringSplit[p[[1]],"."];v=If[Length[ss]==1,ToExpression[ss[[1]],InputForm],ToExpression[StringJoin[ss],InputForm]/10^StringLength[ss[[2]]]];ee=If[Length[p]>1,ToExpression[p[[2]],InputForm],0];v 10^ee];
certcheck83[z_]:=Module[{n=z["N"],aa=z["A"],b=dec83[z["candidate"]],m,cs,lk,mi,ci,li},m=1+mean83[n,aa,N[b,90],1,90];cs=scaled83[n,aa,N[b,90],90];lk=b-Log[cs];mi=dec83/@z["mean_interval"];ci=dec83/@z["scaled_modular_interval"];li=dec83/@z["log_norm_at_candidate_interval"];<|"N"->n,"A"->aa,"side"->z["side"],"candidate"->z["candidate"],"mean"->ToString[N[m,60],InputForm],"scaled_modular"->ToString[N[cs,60],InputForm],"log_norm_at_candidate"->ToString[N[lk,60],InputForm],"all_inside"->TrueQ[mi[[1]]<m<mi[[2]]&&ci[[1]]<cs<ci[[2]]&&li[[1]]<lk<li[[2]]],"correct_mean_sign"->TrueQ[If[z["side"]=="lower",m>1,m<1]]|>];
case83[z_]:=Module[{c=SelectFirst[cachedrows83,#["N"]==z["N"]&&#["A"]==z["A"]&,Missing["NotAvailable"]]},If[AssociationQ[c]&&Length[c["rows"]]==2,c,TimeConstrained[run83[z],300,"TIMEOUT"]]];
LaunchKernels[12];ParallelEvaluate[$HistoryLength=0];DistributeDefinitions[mean83,scaled83,fen83,run83,prior83,dec83,certcheck83,case83,cachedrows83];tt83=AbsoluteTime[];
r83=ParallelMap[case83,jobs83,Method->"FinestGrained"];cc83=ParallelMap[certcheck83,certsrc83["rows"],Method->"FinestGrained"];CloseKernels[];pass83=And@@Values[sym83]&&AllTrue[r83,AssociationQ]&&AllTrue[cc83,TrueQ[#["all_inside"]]&&TrueQ[#["correct_mean_sign"]]&];
Export[FileNameJoin[{out83,"verification83.json"}],<|"version"->$Version,"workers"->12,"kernels_closed"->True,"seconds"->N[AbsoluteTime[]-tt83],"cached_completed_cases"->Length[cachedrows83],"pass"->TrueQ[pass83],"symbolic"->sym83,"numeric_scope"->"Working precision strings are not certified decimal digits; small-N directed certificates are separate. Verified dimension range is the supplied 30 cases through2^20. r082 q is reused. Three exploratory extensions timed out and are not in the verified set.","rows"->r83,"certificate_checks"->cc83|>,"RawJSON"];
Print[If[TrueQ[pass83],"PASS ","FAIL "],Length[r83]," true corner norms, each at two precisions"];
