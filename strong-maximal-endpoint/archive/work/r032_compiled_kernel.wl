buildPolyCV[bb_Integer,cx_Real]:=With[{cc=cx,degree=bb-1,bin=Developer`ToPackedArray[N[Binomial[bb,#]&/@Range[0,bb]]],norm=N[1/(Gamma[bb](1+Exp[-cx])^bb)],nk=bb+1},Compile[{{tt,_Real,1}},Module[{res=Table[0.,{Length[tt]}],i=0,k=0,x=0.,s=0.},For[i=1,i<=Length[tt],i++,s=0.;For[k=1,k<=nk,k++,x=tt[[i]]-cc(k-1);If[x>0.,s=s+bin[[k]]x^degree]];res[[i]]=norm s];res],RuntimeOptions->"Speed"]];
If[$InputFileName!="" && StringContainsQ[$InputFileName,"r032_compiled_kernel"],Module[{cx=1.13434837109461,pc,vals,ref,xx},pc=buildPolyCV[32,cx];xx=N[{-1,0,1,20,40,100}];vals=pc[xx];ref=(1/(Gamma[32](1+Exp[-cx])^32) Total[N[Binomial[32,#]&/@Range[0,32]]Clip[#-cx Range[0,32],{0.,Infinity}]^31]&/@xx);Print[<|"max_relative_error"->Max[Abs[(vals-ref)/Map[Max[#,1.]&,ref]]],"compiled_evaluation_seconds_10000_vectors"->First[AbsoluteTiming[Do[pc[xx],{10000}]]]|>]]];
