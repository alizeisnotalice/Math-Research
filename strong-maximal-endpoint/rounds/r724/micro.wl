folder=DirectoryName[$InputFileName];
cdf[n_,x_?NumericQ,c_?NumericQ]:=Module[{p=1/(1+Exp[c])},Sum[If[x-j c>0,Binomial[n,j]p^j(1-p)^(n-j)GammaRegularized[n,0,x-j c],0],{j,0,n}]];
pdf[n_,x_?NumericQ,c_?NumericQ]:=Module[{p=1/(1+Exp[c])},Sum[If[x-j c>0,Binomial[n,j]p^j(1-p)^(n-j)Exp[-(x-j c)](x-j c)^(n-1)/Gamma[n],0],{j,0,n}]];
base[n_,prec_]:=Module[{mu=1+ProductLog[Exp[-1]],sol,r,c},sol=FindRoot[{cdf[n,r,c]==1/2,cdf[n-1,r-c,c]==1/2},{{r,N[n mu-(3-mu)/6,prec]},{c,N[mu,prec]}},WorkingPrecision->prec,AccuracyGoal->prec-15,PrecisionGoal->prec-15,MaxIterations->40];<|"n"->n,"precision"->prec,"r"->(r/.sol),"c"->(c/.sol),"residual"->Max[Abs[cdf[n,r,c]-1/2],Abs[cdf[n-1,r-c,c]-1/2]]/.sol|>];
vt[N_,x_,c_]:=Module[{p=1/(1+Exp[c]),tt,second},second=Sum[tt=x-c j;If[tt>0,Binomial[N,j]p^j(1-p)^(N-j)Exp[-tt]tt^(N-1)/Gamma[N]*(2tt^2/(N(N+1))+2c tt j/N^2+c^2j/N),0],{j,0,N}]/pdf[N,x,c];N/(N-1)*(second-(x/N)^2)];
micro[n_,prec_]:=Module[{bas,r,c,p,fn,h,bb,w0,aa,eta,kap,slope,mu},bas=base[n,prec];r=bas["r"];c=bas["c"];p=1/(1+Exp[c]);fn=pdf[n,r,c];h=p pdf[n-1,r-c,c]/fn;bb=p^2(cdf[n-2,r-2c,c]-1/2)/fn;w0=(1-p)pdf[n-1,r,c]/fn;aa=w0 vt[n-1,r,c]+h vt[n-1,r-c,c];eta=(n c-r)/(n-1);kap=h^2eta^2/(h-bb);slope=(kap-aa)/4;mu=N[1+ProductLog[Exp[-1]],prec];
<|"status"->"ok","n"->n,"precision"->prec,"c"->ToString[c,InputForm],"r"->ToString[r,InputForm],"stationarity_residual"->ToString[bas["residual"],InputForm],"face_energy_coefficient"->ToString[aa,InputForm],"Schur_energy_coefficient"->ToString[kap,InputForm],"curvature_slope"->ToString[slope,InputForm],"a_minus_mu"->ToString[aa-mu,InputForm],"n2_kappa"->ToString[n^2kap,InputForm],"H_transverse"->ToString[h-bb,InputForm],"positive_a"->TrueQ[aa>0],"negative_slope"->TrueQ[slope<0]|>];
safe[z_]:=If[AssociationQ[z],z,<|"status"->ToString[z,InputForm]|>];LaunchKernels[12];DistributeDefinitions[cdf,pdf,base,vt,micro,safe];cases=Tuples[{{4,8,16,32,64,128,256,512,1024},{50,80}}];res=ParallelMap[Function[x,safe[TimeConstrained[MemoryConstrained[micro@@x,268435456,$Failed],240,$Aborted]]],cases,Method->"CoarsestGrained"];CloseKernels[];Export[FileNameJoin[{folder,"wolfram.json"}],<|"version"->$Version,"results"->res,"scope"->"Finite high-precision micro-energy slope diagnostics; not a uniform starting-dimension certificate"|>,"RawJSON"];Print[<|"cases"->Length[res],"negative"->Count[res,r_Association/;TrueQ[r["positive_a"]&&r["negative_slope"]]]|>];Quit[];
