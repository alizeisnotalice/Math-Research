folder=DirectoryName[$InputFileName];
atomize[boxes_]:=Module[{k=Length[boxes],sub,iv,av,keep,inc,mass},sub=Table[Select[Range[k],BitAnd[mask,2^(#-1)]>0&],{mask,1,2^k-1}];iv=Table[Times@@Table[Max[0,Min[boxes[[ss,j,2]]]-Max[boxes[[ss,j,1]]]],{j,Length[First[boxes]]}],{ss,sub}];av=iv;Do[av[[i]]=iv[[i]]-Sum[If[BitAnd[i,j]==i,av[[j]],0],{j,i+1,2^k-1}],{i,2^k-1,1,-1}];keep=Select[Range[Length[av]],av[[#]]>0&];mass=av[[keep]];inc=Table[Boole[BitAnd[mask,2^(i-1)]>0],{i,k},{mask,keep}];{mass,inc,inc.mass,keep}];
exactLogExpand[expr_]:=Expand[expr/.{Log[r_Rational]:>Total[(Last[#]Log[First[#]]&)/@FactorInteger[r]],Log[r_Integer]:>Total[(Last[#]Log[First[#]]&)/@FactorInteger[r]]}];
check[rec_]:=Module[{boxes=rec["boxes"],target,mass,inc,vol,masks,k,jj,om,x,ell,av,cons,sp,f,lam,z,t,hall,rp,piv,dens,flow,edges,qvars,rows,cols,ff,trans,loss,s,lower,upper,plus,minus,KL,V,hb,res,postTV,postKL},
 target=ToExpression[rec["p"]];{mass,inc,vol,masks}=atomize[boxes];k=Length[boxes];jj=Length[mass];om=Total[mass];x=Array[xx,jj];ell=Array[ee,jj];av=Table[Sum[inc[[i,j]]mass[[j]]x[[j]],{j,jj}]/vol[[i]],{i,k}];
 cons=Flatten[Table[If[inc[[i,j]]==1,{ell[[j]]<=av[[i]]},{}],{i,k},{j,jj}]];sp=Minimize[{mass.x,And@@Join[Thread[x>=0],Thread[x<=1],Thread[ell>=0],Thread[ell<=1],cons,{mass.ell>=target om}]},Join[x,ell]];s=First[sp];f=x/.Last[sp];av=av/.Last[sp];
 lam=Array[ll,k];z=Array[zz,jj];t=vol.lam;hall=Table[Total[Table[If[BitAnd[mask,2^(i-1)]>0,vol[[i]]lam[[i]],0],{i,k}]]<=Total[Table[If[BitAnd[mask,masks[[j]]]>0,mass[[j]],0],{j,jj}]]/om*t,{mask,1,2^k-1}];rp=Maximize[{target t-mass.z,And@@Join[Thread[lam>=0],Thread[z>=0],Thread[z>=Transpose[inc].lam-1],hall]},Join[lam,z]];
 piv=(vol lam/t)/.Last[rp];dens=Table[Sum[piv[[i]]inc[[i,j]]/vol[[i]],{i,k}],{j,jj}];edges=Select[Tuples[{Range[k],Range[jj]}],inc[[#[[1]],#[[2]]]]==1&];qvars=Array[qq,Length[edges]];rows=Table[Total[Pick[qvars,Boole[#==i]&/@edges[[All,1]],1]],{i,k}];cols=Table[Total[Pick[qvars,Boole[#==j]&/@edges[[All,2]],1]],{j,jj}];trans=Minimize[{0,And@@Join[Thread[qvars>=0],Thread[rows==piv],Thread[cols==mass/om]]},qvars];ff=qvars/.Last[trans];
 loss=Sum[ff[[e]](av[[edges[[e,1]]]]-Min[Pick[av,inc[[All,edges[[e,2]]]],1]]),{e,Length[edges]}];lower=Max[Pick[dens,Boole[#<1]&/@f,1]];upper=Min[Pick[dens,Boole[#>0]&/@f,1]];
 KL=Sum[If[dens[[j]]==0,0,mass[[j]]dens[[j]]Log[om dens[[j]]]],{j,jj}];plus=Sum[If[f[[j]]dens[[j]]==0,0,mass[[j]]f[[j]]dens[[j]]/target Log[s dens[[j]]/target]],{j,jj}];minus=Sum[If[(1-f[[j]])dens[[j]]==0,0,mass[[j]](1-f[[j]])dens[[j]]/(1-target) Log[(om-s)dens[[j]]/(1-target)]],{j,jj}];V=Log[om/s];hb=-target Log[target]-(1-target)Log[1-target];res=exactLogExpand[V-KL-((1-target)V+hb+(1-target)Log[1-s/om]-target plus-(1-target)minus)];
 postTV=Sum[piv[[i]]Abs[av[[i]]-target],{i,k}]/(2target);postKL=Sum[If[piv[[i]]av[[i]]==0,0,piv[[i]]av[[i]]/target Log[av[[i]]/target]],{i,k}];
 <|"dimension"->Length[First[boxes]],"rows"->k,"atoms"->jj,"target"->rec["p"],"source"->ToString[s,InputForm],"price_identity"->(First[rp]==s),"half_mass"->(Total[mass f dens]==target),"transport"->(First[trans]==0),"minimum_row_complementarity"->(loss==0),"NP_threshold_interval"->{ToString[lower,InputForm],ToString[upper,InputForm]},"NP_valid"->(0<upper&&lower<=upper),"KL_chain_exact"->(res==0),"KL_chain_residual"->ToString[res,InputForm],"label_TV_exact"->ToString[postTV,InputForm],"label_KL80"->ToString[N[postKL,80],InputForm]|>];
recs=Import[FileNameJoin[{folder,"..","r716","wolfram.json"}],"RawJSON"]["results"];LaunchKernels[12];DistributeDefinitions[atomize,exactLogExpand,check];res=ParallelMap[Function[r,TimeConstrained[MemoryConstrained[check[r],268435456,$Failed],180,$Aborted]],recs,Method->"CoarsestGrained"];CloseKernels[];
Export[FileNameJoin[{folder,"wolfram.json"}],<|"version"->$Version,"results"->res|>,"RawJSON"];Print[<|"cases"->Length[res],"passed"->Count[res,r_Association/;TrueQ[r["price_identity"]&&r["half_mass"]&&r["transport"]&&r["minimum_row_complementarity"]&&r["NP_valid"]]]|>];Quit[];
