folder=DirectoryName[$InputFileName];Get[FileNameJoin[{folder,"single_factor.wl"}]];Clear[mu,r,t,phi,pp,a,b];
evaluate[d_,amp_,kind_,prec_]:=Module[{mm,rr,pp,tt,ph,aa,bb,cost,margin},mm=N[1+ProductLog[Exp[-1]],prec];rr=mm-1;pp=rr/mm;tt=If[kind=="energy",N[amp/Sqrt[d],prec],N[amp,prec]];ph=(1+rr Exp[I tt mm])/(mm(1-I tt));aa=Re[ph Conjugate[ph]];bb=pp Abs[ph-Exp[I tt mm]]^2;cost=(aa^d-1+d bb aa^(d-1))/4;margin=1-aa-bb;
<|"support"->d,"amplitude"->ToString[amp,InputForm],"frequency_pattern"->kind,"precision"->prec,"limiting_curvature"->ToString[cost,InputForm],"single_factor_margin"->ToString[margin,InputForm],"negative"->TrueQ[cost<0],"single_factor_positive"->TrueQ[margin>0]|>];
cases=Flatten[Table[{d,amp,kind,prec},{d,{2,4,8,16,32,64}},{amp,{1/100,1/10,1/2,1,2,4,8}},{kind,{"fixed","energy"}},{prec,{50,100}}],3];LaunchKernels[12];DistributeDefinitions[evaluate];res=ParallelMap[Apply[evaluate],cases,Method->"CoarsestGrained"];CloseKernels[];Export[FileNameJoin[{folder,"wolfram.json"}],<|"version"->$Version,"results"->res,"scope"->"Limiting fixed finite support curvature only: first fixed n deep-layer limit, then n->infinity at fixed support. No simultaneous support-growth or all-axis assertion."|>,"RawJSON"];Print[<|"cases"->Length[res],"negative"->Count[res,z_/;TrueQ[z["negative"]&&z["single_factor_positive"]]]|>];Quit[];
