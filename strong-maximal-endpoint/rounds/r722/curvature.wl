folder=DirectoryName[$InputFileName];
cdf[n_,x_?NumericQ,c_?NumericQ]:=Module[{p=1/(1+Exp[c])},Sum[If[x-j c>0,Binomial[n,j]p^j(1-p)^(n-j)GammaRegularized[n,0,x-j c],0],{j,0,n}]];
pdf[n_,x_?NumericQ,c_?NumericQ]:=Module[{p=1/(1+Exp[c])},Sum[If[x-j c>0,Binomial[n,j]p^j(1-p)^(n-j)Exp[-(x-j c)](x-j c)^(n-1)/Gamma[n],0],{j,0,n}]];
base[n_,prec_]:=Module[{mu=1+ProductLog[Exp[-1]],sol,r,c},sol=FindRoot[{cdf[n,r,c]==1/2,cdf[n-1,r-c,c]==1/2},{{r,N[n mu-(3-mu)/6,prec]},{c,N[mu,prec]}},WorkingPrecision->prec,AccuracyGoal->prec-15,PrecisionGoal->prec-15,MaxIterations->40];<|"n"->n,"precision"->prec,"r"->(r/.sol),"c"->(c/.sol),"residual"->Max[Abs[cdf[n,r,c]-1/2],Abs[cdf[n-1,r-c,c]-1/2]]/.sol|>];
char[a_,b_,z_,x_,t_]:=Module[{nn=a+b+z},Which[z==0&&a==b,Hypergeometric0F1[a+1/2,-t^2x^2/4],z==0,Exp[-I t x]Hypergeometric1F1[a,nn,2I t x],a==1&&b==1,HypergeometricPFQ[{1},{nn/2,(nn+1)/2},-t^2x^2/4],a==0&&b==1,Hypergeometric1F1[1,nn,-I t x],a==1&&b==0,Hypergeometric1F1[1,nn,I t x],a==0&&b==0,1,True,$Failed]];
weighted[a_,b_,z_,s_,c_,t_]:=Module[{nn=a+b+z,p=1/(1+Exp[c]),u,co,x},co=CoefficientList[Expand[If[a==b,(1+2Cos[t c]u+u^2)^a,(1+2Cos[t c]u+u^2)^a(1+Exp[-I t c]u)^(b-a)](1+u)^z],u];Sum[x=s-j c;If[x>0,p^j(1-p)^(nn-j)co[[j+1]]Exp[-x]x^(nn-1)/Gamma[nn]char[a,b,z,x,t],0],{j,0,nn}]];
curv[bas_,kind_]:=Module[{n=bas["n"],prec=bas["precision"],r=bas["r"],c=bas["c"],a,b,z,t,p,f,fm,h,off,e1,e2,m,mc,m0,g,g0,sumsq,sumg,df,schur,full,single},
 a=If[kind=="sparse",1,n/2];b=a;z=n-2a;t=N[If[kind=="dense_energy",1/Sqrt[n],1],prec];p=1/(1+Exp[c]);f=pdf[n,r,c];fm=pdf[n-1,r-c,c];h=p fm/f;off=p^2(cdf[n-2,r-2c,c]-1/2)/f;e1=h-off;e2=h+(n-1)off;
 m=weighted[a,b,z,r,c,t]/f;mc=Exp[I t c]weighted[a-1,b,z,r-c,c,t]/fm;m0=weighted[a-1,b,z,r,c,t]/pdf[n-1,r,c];g=h(m-mc);g0=If[z>0,h(m-weighted[a,b,z-1,r-c,c,t]/fm),0];
 sumsq=2a Abs[g]^2+z Abs[g0]^2;sumg=2a Re[g]+z g0;df=(1-p)pdf[n-1,r,c]/f*(1+Abs[m]^2-2Re[Conjugate[m]m0])+h*(1+Abs[m]^2-2Re[Conjugate[m]mc]);schur=sumsq/e1-off Abs[sumg]^2/(e1 e2);full=Re[(schur-df)/4];single=Re[(Abs[g]^2/h-df)/4];
 <|"status"->"ok","n"->n,"pattern"->kind,"amplitude"->1,"precision"->prec,"baseline_c"->ToString[c,InputForm],"baseline_r"->ToString[r,InputForm],"baseline_residual"->ToString[bas["residual"],InputForm],"H_transverse"->ToString[e1,InputForm],"H_parallel"->ToString[e2,InputForm],"positive_H"->TrueQ[e1>0&&e2>0],"conditional_m"->ToString[m,InputForm],"m_imaginary"->ToString[Abs[Im[m]],InputForm],"fixed_curvature"->ToString[Re[-df/4],InputForm],"single_axis_curvature"->ToString[single,InputForm],"all_axis_curvature"->ToString[full,InputForm],"all_axis_negative"->TrueQ[full<0]|>];
safe[v_]:=If[AssociationQ[v],v,<|"status"->ToString[v,InputForm]|>];LaunchKernels[12];DistributeDefinitions[cdf,pdf,base,char,weighted,curv,safe];
bases=ParallelMap[Function[x,safe[TimeConstrained[MemoryConstrained[base@@x,268435456,$Failed],180,$Aborted]]],Tuples[{{4,8,16,32},{50,80}}]];
valid=Select[bases,KeyExistsQ[#,"c"]&];cases=Flatten[Table[{bas,kind},{bas,valid},{kind,{"sparse","dense","dense_energy"}}],1];res=ParallelMap[Function[x,safe[TimeConstrained[MemoryConstrained[curv@@x,268435456,$Failed],180,$Aborted]]],cases,Method->"CoarsestGrained"];CloseKernels[];
Export[FileNameJoin[{folder,"wolfram.json"}],<|"version"->$Version,"results"->res,"scope"->"Finite numerical all-axis Schur diagnostics, not rigorous intervals or uniform-n proof"|>,"RawJSON"];Print[<|"bases"->Length[valid],"cases"->Length[res],"negative"->Count[res,v_Association/;TrueQ[v["positive_H"]&&v["all_axis_negative"]]]|>];Quit[];
