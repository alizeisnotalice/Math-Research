Clear[a,b,d,l,w,L,t,A,kappa,al,ga,ss];
checks={};
fg=(a+b)/(1-d+2b)^ga;AppendTo[checks,FullSimplify[D[fg,b]-(1-d-2ga a+2(1-ga)b)/(1-d+2b)^(ga+1),Assumptions->Element[{a,b,d,ga},Reals]&&1-d+2b>0]===0];
f=(a+b)/Sqrt[1-d+2b];AppendTo[checks,FullSimplify[D[f,b]-(1-d+b-a)/(1-d+2b)^(3/2)]===0];
ff=l^2/(1-d+2l^2-2w l);fi=(2w l+d-1)/l^2;fa=(w+d/l)^2/(1+d);
AppendTo[checks,FullSimplify[D[ff,l]-2l(1-d-w l)/(1-d+2l^2-2w l)^2]===0];
AppendTo[checks,FullSimplify[D[fi,l]-2(1-d-w l)/l^3]===0];
AppendTo[checks,FullSimplify[D[fa,l]+2d(w l+d)/((1+d)l^3)]===0];
endpointSquares={a^2/(1-d),2a+d-1,(a+d)^2/(1+d),l^4/(1-d+2l^2-2a)};
expected={2a/(1-d),2,2(a+d)/(1+d),2l^4/(1-d+2l^2-2a)^2};
AppendTo[checks,And@@MapThread[(FullSimplify[#1-#2]===0)&,{D[endpointSquares,a],expected}]];
firstOrder=Resolve[ForAll[{w,L},0<w<1&&w<=L<=1,With[{dd=L(L-w)},0<=dd<=1-w&&1<=(1-dd)/w<=1/w&&L<=(1-dd)/w]],Reals];
secondOrder=Resolve[ForAll[{w,d},0<w<1&&1-w<=d<=1-w^2,w<=(1-d)/w<=1&&(1-w-d)<=0&&(1/w^2-1-d)>=0],Reals];
AppendTo[checks,TrueQ[firstOrder]&&TrueQ[secondOrder]];
AppendTo[checks,FullSimplify[((ff/.l->L)/.d->L(L-w))-L^2/(1+L(L-w))]===0];
mid=(1-d)/(2(1-d)-w^2);
AppendTo[checks,FullSimplify[(ff/.l->(1-d)/w)-mid]===0&&FullSimplify[(fi/.l->(1-d)/w)-w^2/(1-d)]===0];
AppendTo[checks,FullSimplify[mid-w^2/(1-d)-(1-d-w^2)^2/((1-d)(2(1-d)-w^2))]===0];
AppendTo[checks,FullSimplify[(mid/.d->1-w)-1/(2-w)]===0&&FullSimplify[(mid/.d->1-w^2)-1]===0];
AppendTo[checks,Expand[(1-(4kappa+1)t)^2+3(1+kappa t)^2-(4-2(kappa+1)t+((4kappa+1)^2+3kappa^2)t^2)]===0];
ws=al Sqrt[1+d]-d/(al Sqrt[1+d]);q=al Sqrt[1+d];
AppendTo[checks,FullSimplify[q^2-ws q-d]===0];
alpha=1-t;delta=A t^2;star=ws/.{al->alpha,d->delta};phase=-Log[star]/t;cut=(-Log[alpha]-Log[1-delta]/2)/t;
seriesOrder=5; (* Increase this integer for higher-order coefficients. *)
phaseSeries=FullSimplify[Normal[Series[phase,{t,0,seriesOrder}]]];gapSeries=FullSimplify[Normal[Series[phase-cut,{t,0,5}]]];
AppendTo[checks,Expand[Normal[Series[phaseSeries,{t,0,5}]]-(1+(1+A)t/2+(1/3+2A)t^2+(1/4+3A-A^2/4)t^3+(1/5+4A)t^4+(1+A(30+A(12+A)))t^5/6)]===0];
AppendTo[checks,SeriesCoefficient[phase-cut,{t,0,2}]==2A];
window=Resolve[ForAll[{t,d,ss},0<t<=1/8&&0<=d<=t/8&&ss>0&&ss^2==1+d,0<(1-t)ss-d/((1-t)ss)<1-d&&1-t<1-d],Reals];
AppendTo[checks,TrueQ[window]&&9/8+64/49<3&&88/53<2];
If[!And@@checks,Print[checks];Exit[1]];
out=<|"kernel"->$Version,"exact_checks"->checks,"count"->Length[checks],"explicit_real_phase_window_check"->window,"cauchy_remainder_radius"->"1/(8*(A0+1)); tail <= 2*(t/R)^(N+1)/(1-t/R)","first_scale_order_quantifier"->firstOrder,"second_scale_order_quantifier"->secondOrder,"critical_phase_series"->ToString[phaseSeries,InputForm],"cross_minus_cut_phase_series"->ToString[gapSeries,InputForm],"scope"->"exact derivative, ordering, attainment, area dichotomy and critical-series identities; the all-input extremum is established by the paper endpoint argument"|>;
Export[FileNameJoin[{DirectoryName[$InputFileName],"..","results","critical_rectangle_wolfram.json"}],out,"RawJSON"];Print[out];
