ClearAll[v,n,ln,s,k,task];
Print["Wolfram: ",$Version];
Print["Conditional algebra only; fixed n=2..16; v=2 t^(1/n)."];
ln[n_]:=1/(1-v^n/(1+v)^n);
s[n_]:=Sum[(-1)^(7-(j-1)n) Binomial[n+6,7-(j-1)n],{j,1,1+Floor[7/n]}];
k[n_]:=Binomial[n,2]n^2/27;
task[n_]:=Module[{f=s[n],z,c},z=SeriesCoefficient[ln[n],{v,0,n+7}];c=2^(n+7)(f-(n+26/9)k[n]);<|"n"->n,"kernel_id"->$KernelID,"pid"->$ProcessID,"ln_formula"->ToString[f,InputForm],"ln_series"->ToString[z,InputForm],"series_matches"->TrueQ[f==z],"conditional_coefficient"->ToString[c,InputForm],"zero"->TrueQ[c==0]|>];
LaunchKernels[15];Print["actual launched: ",Length[Kernels[]]];
DistributeDefinitions[ln,s,k,task,v];
rows=ParallelTable[task[n],{n,2,16},Method->"CoarsestGrained"];
Print["actual kernel IDs: ",Sort[DeleteDuplicates[Lookup[rows,"kernel_id"]]]];
Print["actual PIDs: ",Sort[DeleteDuplicates[Lookup[rows,"pid"]]]];
Print["series match all: ",And@@Lookup[rows,"series_matches"]];
Print["zero dimensions: ",Lookup[Select[rows,#zero&],"n"]];
Print["n2 coefficient: ",Lookup[First[rows],"conditional_coefficient"]];
Print["n>=8 sign check: ",FullSimplify[-Binomial[n+6,7]-(n+26/9)Binomial[n,2] n^2/27<0,Assumptions->Element[n,Integers]&&n>=8]];
Print["n>=8 sign proof components (binomial product factors positive): ",Reduce[n>=8&&(Product[n+j,{j,0,6}]<=0||(n+26/9) n^3(n-1)<=0),n,Reals]];
Export[FileNameJoin[{DirectoryName[$InputFileName],"coefficients.json"}],rows,"RawJSON"];
CloseKernels[];Print["complete"];
