Do[Module[{b=2^n,a=n/(2(n+1)),t,lam,cc,aa,bb,zz,poly,sol,kappa,lip}, t=x^n; lam=1/(1+gam x/2); cc=2(1+gam x); aa=1+b^2 t/(1-b t); bb=a cc^(-n-1)(1-(2cc)^n t)^(1+1/n); zz=x^n (b+c x); poly=FullSimplify[Coefficient[Normal[Series[lam^n zz/aa+bb zz^(1+1/n)-b t,{x,0,n+1},Assumptions->x>0]],x,n+1],Assumptions->x>0]; sol=FullSimplify[c/.First[Solve[poly==0,c]]]; lip=FullSimplify[sol/.gam->0]; kappa=FullSimplify[a b^(1+1/n)]; Print[InputForm[{"n"->n,"coefficientEquation"->poly,"c"->sol,"gammaZero"->lip,"expected"->-a,"check"->(lip===-a),"sameScaleKappa"->kappa,"expectedKappa"-> n 2^n/(n+1),"kappaCheck"->(kappa===n 2^n/(n+1))}]]],{n,2,8}];
