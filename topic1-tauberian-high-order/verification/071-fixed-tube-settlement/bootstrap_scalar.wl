ClearAll[x,y,nn,v,s,dd,qq,rr,q4,q5,phi,shift,cp,qnNorm,errs,target,dom1,dom2];
Print["Wolfram ",$Version,"; PID ",$ProcessID];
Print["R071 scalar checks only: moving normal maximum and finite bootstrap exponents. No geometry encoded."];
q4[x_,y_]:=x y (x^2+3 x y+y^2)/3;
q5[x_,y_]:=x y (x+y)(5 x^2+29 x y+5 y^2)/24;
phi[x_,y_,v_]:=x y (1-x-y)+2 v/(1+v) q4[x,y]-2 v^2/(1+v)^2 q5[x,y]-nn (nn-2) v^2/(1+v) x^2 y^2;
Print["base Hessian: ",Table[D[phi[x,y,0],u,w],{u,{x,y}},{w,{x,y}}]/.{x->1/3,y->1/3}];
Print["base Hessian eigenvalues: ",Eigenvalues[{{-2/3,-1/3},{-1/3,-2/3}}]];
shift=1/3+20 v/81;
Print["moving critical gradient through order v residual: ",Normal[Series[D[phi[x,y,v],x]/.{x->shift,y->shift},{v,0,1}]]//Simplify];
cp=-13/18-nn(nn-2)/3+400/243;
qnNorm=1/27+10 v/(243(1+v))+cp v^2 (1+v)^2/27;
Print["peak value vs truncated qN through v2 residual: ",Normal[Series[phi[shift,shift,v]-qnNorm,{v,0,2}]]//Simplify];
errs={8+s+dd,8+s+dd,9+s-7dd,9-2dd,10-5dd,19/2-3dd,9-dd,11+s-2dd,11-3dd,9,8+s+3/5};
target=8+s+dd;
dom1=0<=s<=5/8;
dom2=5/8<=s<1;
Print["fixed-step branch violations: ",Reduce[dom1&&Or@@Thread[(errs-target/.dd->1/8)<0],s,Reals]];
Print["contracting-step branch violations: ",Reduce[dom2&&Or@@Thread[(errs-target/.dd->(1-s)/3)<0],s,Reals]];
Print["old RN raw-target term gap branch2: ",Simplify[(9-dd-target)/.dd->(1-s)/3]];
Print["high q >=4 exponent gap vs q3: ",Factor[qq(2qq-1)/(qq-1)+2+s-(3/5)qq/(qq-1)-(8+s+3/5)]];
Print["high-q violation q>=4: ",Reduce[qq>=4&&qq(2qq-1)/(qq-1)+2+s-(3/5)qq/(qq-1)<8+s+3/5,qq,Reals]];
rr=NestList[Function[z,z+Min[1/8,(1-z)/3]],0,12];
Print["bootstrap s values j0..12: ",rr];
Print["eventual deficit recurrence residual: ",Simplify[1-(s+(1-s)/3)-(2/3)(1-s)]];
Print["complete"];
