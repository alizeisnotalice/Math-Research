ClearAll[u,c,n,g,k,a,d,lam0,lam1,lam2,old,new,ratio];
Print["Wolfram: ",$Version];Print["master PID: ",$ProcessID];
Print["Domain u->0+, n=2, local algebra conditional on geometric budget; no geometry certified."];
g=1/(1+2u);a=4u^2;k=16g^2/3+640g^3 u/81;d=1-k^2 u^6;
lam0=k^3/(32g);lam1=-5k^4/(768g^2);lam2=13k^5/(8192g^3);
Print["lambda factor checks: ",FullSimplify[{lam0-(1*k^3/(8*2^2*g)),lam1-(-5*k^4/(96*2^3*g^2)),lam2-(13*k^5/(512*2^4*g^3))}]];
old=lam0+lam1 u+lam2 u^2;new=old-a lam0+c u^3;
ratio[lam_]:=d/(d-a (1-2(u g+lam u^6))^2);
Print["series calculation begins"];
diffseries=FullSimplify[Normal[Series[ratio[new]-ratio[old],{u,0,10}]]];
Print["actual ratio difference through u^10: ",diffseries];
Print["normalized gain: ",FullSimplify[Coefficient[diffseries,u,10]/1024]];
Print["expected gain 8/27: ",FullSimplify[Coefficient[diffseries,u,10]/1024==8/27]];
Print["safe c independent through u10: ",FreeQ[diffseries,c]];
Ln=1/(1-a g^2);
base=FullSimplify[Normal[Series[ratio[old]-Ln,{u,0,10}]]];
Print["old av8 coefficient: ",FullSimplify[Coefficient[base,u,10]/1024]];
Print["new av8 coefficient: ",FullSimplify[(Coefficient[base,u,10]+Coefficient[diffseries,u,10])/1024]];
Print["new expected: ",FullSimplify[(Coefficient[base,u,10]+Coefficient[diffseries,u,10])/1024==17638/6561]];
Print["complete"];
