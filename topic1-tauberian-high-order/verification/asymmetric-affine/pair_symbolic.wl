ClearAll[n,g,a,b,u,d,e,p,q,f,x,y,r];
Print["Wolfram: ",$Version];
Print["Domain n>=2, g>0, p>0,q>0, f>p+q; epsilon=lambda->0; assumptions on geometric remainder remain external."];
k=8n g^2/3;
f0=a b-a b(a+b)/(8n g^2);
f1=a b(a^2+3a b+b^2)/(48n^2 g^3);
hess=FullSimplify[{D[f0,{a,2}],D[f0,a,b],D[f0,b,a],D[f0,{b,2}]}/.{a->k,b->k},n>0&&g>0];
Print["Hessian flattened: ",hess];
grad=FullSimplify[{D[f1,a],D[f1,b]}/.{a->k,b->k},n>0&&g>0];Print["feedback gradient: ",grad];
rr=320n g^3/81;
quad=FullSimplify[Coefficient[Normal[Series[(f0+u f1)/.{a->k+u d,b->k+u e},{u,0,2}]],u,2],n>0&&g>0];
Print["completed square residual: ",FullSimplify[quad-(rr^2-((d-rr)^2+(d-rr)(e-rr)+(e-rr)^2)/3)]];
h=p q/f;sol=FullSimplify[Solve[{x==p(q-y)/(f-p),y==q(p-x)/(f-q)},{x,y}],Assumptions->f>p+q&&p>0&&q>0];
Print["arm boundary intersection: ",sol];
moment=Integrate[Integrate[p+q-x-y,{y,0,q-(f-p)x/p}],{x,0,h},Assumptions->f>p+q&&p>0&&q>0]+Integrate[Integrate[p+q-x-y,{y,0,q(p-x)/(f-q)}],{x,h,p},Assumptions->f>p+q&&p>0&&q>0];
moment=FullSimplify[moment,Assumptions->f>p+q&&p>0&&q>0];
Print["exact U0 moment: ",Factor[moment]];
Print["U0 expanded 1/f: ",FullSimplify[Normal[Series[moment/.f->1/u,{u,0,2}]],p>0&&q>0]];
Q4=p q(p^2+3p q+q^2)/3;
Print["U0 coefficients checks: ",FullSimplify[{Coefficient[Normal[Series[moment/.f->1/u,{u,0,2}]],u,1]-Q4,Coefficient[Normal[Series[moment/.f->1/u,{u,0,2}]],u,2]+p^2 q^2(p+q)/3},p>0&&q>0]];
term=Integrate[(p+r)(p(q r-r^2/2)+q p^2/2),{r,0,q}];
term2=term/.{p->q,q->p};
(* Swap must be simultaneous. *)
term2=term/.{p->qq,q->p}/.qq->q;
Print["second feedback moment exact: ",Factor[term+term2]];
Q5=17(p^3 q^2+p^2 q^3)/12+5(p^4 q+p q^4)/24;
Print["Q5 residual: ",FullSimplify[(p^2 q^2(p+q)/3)+(term+term2)-Q5]];
Print["equal amplitudes Q5: ",Factor[Q5/.q->p]];
Print["complete"];
Print["pair penalty: ",Factor[-((d-rr)^2+(d-rr)(e-rr)+(e-rr)^2)/(3*64*4)]];
Print["quadratic nonnegative violation: ",Reduce[(d^2+d e+e^2)<0,{d,e},Reals]];
Print["quadratic zero classification: ",Reduce[d^2+d e+e^2==0,{d,e},Reals]];
