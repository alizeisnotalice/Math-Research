ClearAll[del,aa,z,t,b,eta,q,x];
Print["Wolfram ",$Version,"; PID ",$ProcessID];
Print["Domain 0<del<1/8, 0<aa<1/4, z in [0,1], t in [0,b], b=Psi(1)."];
psi[z_]:=2del z/(1+Sqrt[1+4aa del^2 z]);phi[t_]:=t/del+aa t^2;
Print["Phi(Psi(z))-z: ",FullSimplify[phi[psi[z]]-z,0<del<1/8&&0<aa<1/4&&0<=z<=1]];
P[t_]:=t^2/(2del)+2aa t^3/3;
bb=psi[1];A0=FullSimplify[P[bb],0<del<1/8&&0<aa<1/4];
Print["A0 transformed integration residual: ",FullSimplify[Integrate[t D[phi[t],t],{t,0,bb}]-A0,0<del<1/8&&0<aa<1/4]];
beta=2/(1+Sqrt[1+4eta]); Aeta=del(beta^2/2+2eta beta^3/3);
Print["A0 / del eta series: ",Series[Aeta/del,{eta,0,3}]];
mlo=FullSimplify[t^2/2+t(1-phi[t])+P[t]];
Print["Mlow exact: ",Factor[mlo]];
Print["Mlow expected residual: ",Expand[mlo-(t+(1/2-1/(2del))t^2-aa t^3/3)]];
qhi=1-phi[t]+t;mhi=2P[b]-P[t]+t^2/2;
Print["join qhi-b residual modulo Phi(b)=1: ",Factor[(qhi-b)/.t->b]];
Print["join M residual: ",Factor[(mlo-mhi)/.t->b]];
Print["low q-M factor: ",Factor[t-mlo]];
rad=1+2aa del(1-del)q^2+(4/3)aa^2 del^2 q^3;
Print["low radicand formula residual: ",Expand[1+4aa del^2(q-(mlo/.t->q))-rad]];
Print["cubic discriminant: ",Factor[Discriminant[rad,q]]];
Print["discriminant nonzero under domain violation: ",Reduce[0<del<1/8&&0<aa<1/4&&Discriminant[rad,q]==0,{del,aa},Reals]];
Print["complete"];
