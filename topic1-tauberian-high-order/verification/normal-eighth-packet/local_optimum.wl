ClearAll[x,y,z,b,v,h0,h1,h2,h3,n];
Print["Wolfram: ",$Version];
Print["Formal scalar model only, bounded fields, fixed n>=2."];
q4=x y(x^2+3x y+y^2)/3;
q5=x y(x+y)(5x^2+29x y+5y^2)/24;
G=b/27-b x y+x y(x+y)+3(x+y)z^2;
F=b/27-G+2v/(1+v)q4-2v^2/(1+v)^2 q5-n(n-2)v^2/(1+v)x^2 y^2;
sub={x->1/3+v h1,y->1/3+v h2,z->v h3,b->1-v^2 h0};
ser=FullSimplify[Normal[Series[F/.sub,{v,0,2}]]];
Print["F coefficients: ",Factor /@ CoefficientList[ser,v]];
quad=-(h1^2+h1 h2+h2^2)/3+(20/81)(h1+h2);
completed=400/6561-((h1-20/81)^2+(h1-20/81)(h2-20/81)+(h2-20/81)^2)/3;
Print["square completion residual: ",Expand[quad-completed]];
Print["quad maximum 400/6561, equality: ",Reduce[quad==400/6561,{h1,h2},Reals]];
Print["optimized F second / (1/27), excluding expansion of 1/(1+v): ",Factor[-13/18-n(n-2)/3+400/243]];
K=n^2 n(n-1)/(2*27);
c8=-13/18-n(n-2)/3+400/243;
J=K((n+4)(n+5)/2-(10/9)(n+5)+c8);
closed=(n-1)n^3(2609+1971n+81n^2)/26244;
Print["formal J closed residual n>=3: ",Factor[J-closed]];
Print["n2 denominator correction 2K and final J2: ",FullSimplify[{2K,J+2K}/.n->2]];
