ClearAll[f, p, q, c, rr, mm, cap, ss, xx, yy, zz, n, v];
Print["Wolfram: ", $Version];
Print["R053 adversarial narrow exact checks; geometry and uniform bounds remain analytic."];
oldHeight = p rr/f;
newHeight = (p rr - mm)/f;
integralLoss = Integrate[cap - q + rr - 2 ss, {ss, newHeight, oldHeight}];
claimedLoss = (cap - q + rr) mm/f - (2 p rr mm - mm^2)/f^2;
Print["(8a) sorted-fibre exact residual: ", Factor[integralLoss - claimedLoss]];
area0[pp_, qq_] := pp qq (pp + qq)/(2 f);
moment0[pp_, qq_] := pp qq (pp^2 + 3 pp qq + qq^2)/(3 f) - pp^2 qq^2 (pp + qq)/(3 f^2);
fullCrossMoment = moment0[p-c,q-c] + 4 c area0[p-c,q-c] + moment0[p+c,q+c] - 4 c area0[p+c,q+c];
crossDifference = Factor[fullCrossMoment - 2 moment0[p,q]];
Print["Full double cross-hat difference: ", crossDifference];
Print["Evenness residual: ", Expand[crossDifference - (crossDifference /. c -> -c)]];
Print["Divisibility by c^2 residual: ", PolynomialRemainder[Expand[crossDifference f^2], c^2, c]];
actualF = ((p+zz)(q+zz)(p+q+2zz) + (p-zz)(q-zz)(p+q-2zz))/2;
Print["Nominal opposite-root F residual: ", Expand[actualF - p q (p+q) - 3(p+q)zz^2]];
q4[pp_,qq_] := pp qq (pp^2+3 pp qq+qq^2)/3;
q5[pp_,qq_] := pp qq (pp+qq)(5 pp^2+29 pp qq+5 qq^2)/24;
subRule = {p -> n xx/(1+v), q -> n yy/(1+v), zz -> n zz/(1+v)};
av = n^2 (1+v)^(n-4);
sourceNominal = (1+v)^(n-1) v^6 actualF/n;
firstRefund = 2 (1+v)^(n-1) v^7 q4[p,q]/n^2;
secondCost = 2 (1+v)^(n-1) v^8 q5[p,q]/n^3;
threeFaceCost = (n-2) (1+v)^(n-1) v^8 p^2 q^2/n;
expected = {xx yy (xx+yy)+3(xx+yy)zz^2, 2 v q4[xx,yy]/(1+v), 2 v^2 q5[xx,yy]/(1+v)^2, n(n-2) v^2 xx^2 yy^2/(1+v)};
Print["Four source/refund scalar conversion residuals: ", FullSimplify[({sourceNominal,firstRefund,secondCost,threeFaceCost}/(av v^6) /. subRule)-expected, n>=2 && v>0]];
