ClearAll[n,kappa,g,u,k1,k2];
Print["Wolfram: ",$Version];
Print["Formal budget: fixed n>=2; assumes stated asymptotic remainder and triple bound; not a geometric proof."];
B=n(n-1)/2;
l0=B kappa^3/(8n^2 g);
l1= -l0*5kappa/(12 n g);
l2=l0*13kappa^2/(64n^2 g^2)+B(n-2)kappa^4/(32n^2 g^2);
Print["lambda coefficients {0,1,2}: ",Factor /@ {l0,l1,l2}];
Gb=(B kappa^2 g^n-2n (l0+u l1+u^2 l2)g^(n-1))/64;
G=Normal[Series[Gb/.g->1/(1+2u),{u,0,2}]];
k0=8n/3;
firstDerivative=FullSimplify[Coefficient[Normal[Series[D[G,kappa]/.kappa->(k0+k1 u),{u,0,1}]],u,1]];
sol=FullSimplify[Solve[firstDerivative==0,k1]];
Print["k1 stationary: ",sol];
Gopt=FullSimplify[Normal[Series[G/.kappa->(k0+(k1/.First[sol])u),{u,0,2}]]];
Print["optimized gain in u: ",Collect[Factor[Gopt],u,Factor]];
Print["optimized av8 coefficient n>=3: ",Factor[Coefficient[Gopt,u,2]/4]];
Print["n=2 denominator av8 addition: ",FullSimplify[(8 Coefficient[Gopt,u,0]/4)/.n->2]];
Print["optimized av8 coefficient n=2: ",FullSimplify[(Coefficient[Gopt,u,2]/4+2Coefficient[Gopt,u,0])/.n->2]];
Print["complete"];
