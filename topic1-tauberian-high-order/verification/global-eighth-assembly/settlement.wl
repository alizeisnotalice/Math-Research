E8=Q T+(delta+e8)v^8 S;E7=Q T+e7 v^8 S;E6=Q T+e6 v^6 S;
early=Sum[tau^(8-h),{h,1,5}];
residual=E8+tau E7+tau^2 E6+C0 v^6 S early-omega Q T;
expected=(delta+e8)v^8 S+tau e7 v^8 S+tau^2 e6 v^6 S+early(C0 v^6 S-Q T);
