ClearAll[v,aa,cl,cm,cr,lam,mzero,rho,dzero,done,dtwo,layererr,sourceerr,refunderr];
Print["Wolfram ",$Version,"; PID ",$ProcessID];
Print["R075 conditional finite recurrence only; geometry and actual rho improvement are proved separately."];
lam=cl v;mzero=cm aa v^5;rho=cr aa v^8;
dzero=rho+lam mzero;
done=rho+lam dzero;
dtwo=rho+lam done;
layererr=Expand[lam dtwo];
sourceerr=Expand[(v/aa)layererr];
refunderr=Expand[(v^2/aa)dtwo];
Print["D-Y2 / (a v8): ",Factor[dtwo/(aa v^8)]];
Print["B(D)-Y3 / (a v9): ",Factor[layererr/(aa v^9)]];
Print["source error exact: ",sourceerr];
Print["refund error exact: ",refunderr];
Print["source/refund equal residual: ",Simplify[sourceerr-refunderr]];
Print["Y2-Y3 nominal upper source scale: ",Expand[(v/aa)lam^3 mzero]];
Print["Y3-Y4 nominal upper source scale: ",Expand[(v/aa)lam^4 mzero]];
Print["raw-target refund from new raw9: ",Expand[(v^2/aa)(aa/v)v^9]];
Print["old raw8 would stop at: ",Expand[(v^2/aa)(aa/v)v^8]];
Print["complete"];
