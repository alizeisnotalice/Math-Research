ClearAll[y,z,n,g,kap,cc];
Print["Wolfram: ",$Version,"; PID: ",$ProcessID];
Print["Domain y in [0,1]; A phi=integral_0^(1-y) phi + integral_0^1 phi; fixed n>=2, g>0."];
poly=1-y;
Do[poly=FullSimplify[Integrate[poly/.y->z,{z,0,1-y}]+Integrate[poly/.y->z,{z,0,1}],0<=y<=1];
 Print["A^",j," phi0 = ",Expand[poly]]; Print["c",j," = ",Integrate[2poly,{y,0,1}]];
 If[j==3,c3=Integrate[2poly,{y,0,1}]],{j,1,3}];
Bn=n(n-1)/2;Kn=Bn n^2/27;
P=Bn kap^3/(8n)g^(n-3);del=kap/(4n g);
Ldelta=FullSimplify[P c3 del^3/(n g^(n-2)),n>0&&g>0];
expected=c3 Bn kap^6/(512 n^5 g^4);
Print["third feedback lambda coefficient residual: ",FullSimplify[Ldelta-expected,n>0&&g>0]];
gain=2n g^(n-1) Ldelta/2^9;
Print["feedback gain at kap=8n/3,g=1: ",FullSimplify[gain/.{kap->8n/3,g->1}]];
Print["feedback vs 2c3 K/27 residual: ",FullSimplify[(gain/.{kap->8n/3,g->1})-2c3 Kn/27]];
Print["n2 feedback av9 coefficient: ",FullSimplify[((gain/.{kap->8n/3,g->1})/.n->2)]];
l0=Bn kap^3/(8n^2 g);
micro=2n g^(n-1)l0/2^6;
Print["micro normalized coeff at kap*=8n/3,g=1: ",FullSimplify[micro/.{kap->8n/3,g->1}]];
Print["micro vs 2K residual: ",FullSimplify[(micro/.{kap->8n/3,g->1})-2Kn]];
Print["n3 micro coefficient: ",FullSimplify[(micro/.{kap->8n/3,g->1})/.n->3]];
Print["complete"];
